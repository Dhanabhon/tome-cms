---
// Starlight's theme picker, as the site's own menu instead of the system's dropdown. The
// choice is kept exactly as Starlight keeps it, so the script Starlight puts in <head>
// still applies it before the first paint.
import { Icon } from '@astrojs/starlight/components';
import HeaderMenu from './HeaderMenu.astro';

const choices = [
  { value: 'auto', icon: 'laptop', label: Astro.locals.t('themeSelect.auto') },
  { value: 'light', icon: 'sun', label: Astro.locals.t('themeSelect.light') },
  { value: 'dark', icon: 'moon', label: Astro.locals.t('themeSelect.dark') },
] as const;
---

<tome-theme-select data-choice="auto">
  <HeaderMenu label={Astro.locals.t('themeSelect.accessibleLabel')}>
    <Fragment slot="current">
      {
        choices.map(({ value, icon, label }) => (
          <span class="choice" data-value={value}>
            <Icon name={icon} />
            <span>{label}</span>
          </span>
        ))
      }
    </Fragment>
    {
      choices.map(({ value, label }) => (
        <button type="button" role="menuitemradio" tabindex="-1" aria-checked="false" data-value={value}>
          {label}
        </button>
      ))
    }
  </HeaderMenu>
</tome-theme-select>

{/* Inline, so the button names the stored choice before the first paint. */}
<script is:inline>
  document.querySelectorAll('tome-theme-select').forEach((picker) => {
    picker.dataset.choice =
      (typeof localStorage !== 'undefined' && localStorage.getItem('starlight-theme')) || 'auto';
  });
</script>

<script>
  type Theme = 'auto' | 'dark' | 'light';

  /** Starlight's key in localStorage; its head script reads the same one. */
  const storageKey = 'starlight-theme';

  const parseTheme = (theme: unknown): Theme =>
    theme === 'auto' || theme === 'dark' || theme === 'light' ? theme : 'auto';

  const loadTheme = (): Theme =>
    parseTheme(typeof localStorage !== 'undefined' && localStorage.getItem(storageKey));

  /** Auto is stored as an empty string, as Starlight stores it. */
  function storeTheme(theme: Theme): void {
    if (typeof localStorage !== 'undefined') {
      localStorage.setItem(storageKey, theme === 'light' || theme === 'dark' ? theme : '');
    }
  }

  const getPreferredColorScheme = (): Theme =>
    matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';

  function onThemeChange(theme: Theme): void {
    document.querySelectorAll<HTMLElement>('tome-theme-select').forEach((picker) => {
      picker.dataset.choice = theme;
      picker.querySelectorAll('[role="menuitemradio"]').forEach((item) => {
        item.setAttribute('aria-checked', String(item.getAttribute('data-value') === theme));
      });
    });
    document.documentElement.dataset.theme = theme === 'auto' ? getPreferredColorScheme() : theme;
    storeTheme(theme);
  }

  // Auto follows the system as it changes.
  matchMedia('(prefers-color-scheme: light)').addEventListener('change', () => {
    if (loadTheme() === 'auto') onThemeChange('auto');
  });

  class TomeThemeSelect extends HTMLElement {
    constructor() {
      super();
      onThemeChange(loadTheme());
      this.addEventListener('click', (event) => {
        const item = (event.target as Element).closest<HTMLElement>('[role="menuitemradio"]');
        if (!item) return;
        onThemeChange(parseTheme(item.dataset.value));
        item.closest<HTMLElement>('[popover]')?.hidePopover();
      });
    }
  }
  customElements.define('tome-theme-select', TomeThemeSelect);
</script>

<style>
  tome-theme-select {
    display: flex;
  }

  .choice {
    display: none;
    align-items: center;
    gap: 0.375rem;
  }

  [data-choice='auto'] .choice[data-value='auto'],
  [data-choice='light'] .choice[data-value='light'],
  [data-choice='dark'] .choice[data-value='dark'] {
    display: inline-flex;
  }
</style>
