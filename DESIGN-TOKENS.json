{
  "color": {
    "Surface Base": {
      "$type": "color",
      "$value": "#f2f8f7",
      "$description": "Primary page background and quiet application surfaces"
    },
    "Surface White": {
      "$type": "color",
      "$value": "#ffffff",
      "$description": "Navigation dropdown panels, card surfaces, modal overlays"
    },
    "Surface Mint": {
      "$type": "color",
      "$value": "#c5e5e4",
      "$description": "Selected states, quiet highlights, and branded soft surfaces"
    },
    "Hero Evergreen": {
      "$type": "color",
      "$value": "#0f3d3a",
      "$description": "Dark hero, editor code, and grounded navigation surfaces"
    },
    "Accent Teal": {
      "$type": "color",
      "$value": "#236a67",
      "$description": "Primary CTA fill and links; passes WCAG AA against white and mint surfaces"
    },
    "Focus Teal": {
      "$type": "color",
      "$value": "#498f8c",
      "$description": "Focus rings and non-text brand accents from the reference artwork"
    },
    "Text Primary": {
      "$type": "color",
      "$value": "#0a0c0c",
      "$description": "Body text, headings, nav labels; dominant text color across all zones"
    },
    "Text Muted": {
      "$type": "color",
      "$value": "#4d6865",
      "$description": "Placeholder text and tertiary labels; passes WCAG AA against white, base, and mint surfaces"
    },
    "Text Medium": {
      "$type": "color",
      "$value": "#526e6b",
      "$description": "Secondary copy and icon states"
    },
    "Border Subtle": {
      "$type": "color",
      "$value": "#0f3d3a",
      "$description": "Hairline dividers mixed at 10% and strong borders mixed at 26%"
    },
    "Accent Red": {
      "$type": "color",
      "$value": "#f64932",
      "$description": "Warning/error states, status tags; maps to --color-red-500"
    }
  },
