TOME_CMS_INSTALL_TOKEN=replace-with-at-least-32-characters

# Server runtime
NODE_ENV=development
DATABASE_URL=postgresql://tomecms:replace-with-password@127.0.0.1:5432/tomecms
DATABASE_POOL_MAX=10
# Server-only integer milliseconds: connection 100-60000, query 100-3600000.
DATABASE_CONNECTION_TIMEOUT_MS=5000
# Bounds both driver queries and PostgreSQL statements; raise for long migrations.
DATABASE_QUERY_TIMEOUT_MS=30000
TOME_CMS_PUBLIC_URL=http://localhost:4321
BETTER_AUTH_SECRET=replace-with-at-least-32-characters
TOME_CMS_CONTEXT_SECRET=replace-with-at-least-32-characters
TOME_CMS_RECOVERY_PEPPER=replace-with-at-least-32-characters
# Server-only update capability. Managed bootstrap is the only writer of managed.
TOME_CMS_UPDATE_MODE=check-only
TOME_CMS_UPDATER_SOCKET=/run/tome-cms/updater.sock

# Object storage
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=tomecms
S3_SECRET_ACCESS_KEY=replace-with-a-secret
S3_BUCKET=tomecms-media
S3_FORCE_PATH_STYLE=true
MEDIA_PUBLIC_URL=http://127.0.0.1:9000/tomecms-media/
TOME_CMS_FRONTEND_MODE=bundled

# Stats: the header a CDN puts the reader's country in, and where the DB-IP Lite file is.
# TOME_CMS_COUNTRY_HEADER=cf-ipcountry
# TOME_CMS_GEOIP_PATH=data/geoip/dbip-country-lite.mmdb

# Compose-only
POSTGRES_PASSWORD=replace-with-password
