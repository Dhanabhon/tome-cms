TOME_CMS_SUPABASE_MODE=cloud
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Legacy key names remain supported for existing installations.
PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
TOME_CMS_INSTALL_TOKEN=replace-with-at-least-32-characters
TOME_CMS_DOMAIN=

# Server runtime
NODE_ENV=development
DATABASE_URL=postgresql://tomecms:replace-with-password@127.0.0.1:5432/tomecms
DATABASE_POOL_MAX=10
TOME_CMS_PUBLIC_URL=http://localhost:4321
BETTER_AUTH_SECRET=replace-with-at-least-32-characters
TOME_CMS_CONTEXT_SECRET=replace-with-at-least-32-characters
TOME_CMS_RECOVERY_PEPPER=replace-with-at-least-32-characters

# Object storage
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=tomecms
S3_SECRET_ACCESS_KEY=replace-with-a-secret
S3_BUCKET=tomecms-media
S3_FORCE_PATH_STYLE=true
MEDIA_PUBLIC_URL=http://127.0.0.1:9000/tomecms-media/
TOME_CMS_FRONTEND_MODE=bundled

# Compose-only: keep real values and license files outside the repository.
POSTGRES_PASSWORD=replace-with-password
MINIO_LICENSE_FILE=/absolute/path/outside-this-repository/aistor-free.license
