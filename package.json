{
  "name": "tome-cms",
  "version": "0.6.0",
  "packageManager": "npm@11.19.1",
  "private": true,
  "type": "module",
  "scripts": {
    "bootstrap:core": "node scripts/bootstrap-core.mjs",
    "backup": "node --env-file-if-exists=.env.local --import tsx scripts/backup.ts",
    "restore:check": "node --env-file-if-exists=.env.local --import tsx scripts/restore-check.ts",
    "release:manifest": "node --import tsx scripts/release-manifest.ts",
    "admin:reset-installation": "node --env-file-if-exists=.env.local --import tsx scripts/reset-installation.mjs",
    "admin:recover": "node scripts/recover-owner.mjs",
    "dev": "node --env-file-if-exists=.env.local ./node_modules/astro/bin/astro.mjs dev",
    "dev:macos": "./scripts/dev-local-macos.sh",
    "dev:windows": "powershell -ExecutionPolicy Bypass -File ./scripts/dev-local-windows.ps1",
    "build": "astro build",
    "css:snapshot": "node scripts/css-selector-diff.mjs --save",
    "css:diff": "node scripts/css-selector-diff.mjs --diff",
    "build:updater": "tsc -p tsconfig.updater.json",
    "preview": "astro preview",
    "version": "npm run check && npm run build",
    "check": "astro check && node --import tsx scripts/reset-installation.mjs --self-test && node --import tsx scripts/backup.ts --self-test && node --import tsx scripts/restore-check.ts --self-test && bash -n scripts/deploy-vps.sh scripts/dev-local-macos.sh && node scripts/check-design-tokens.mjs --self-test && node scripts/check-design-tokens.mjs && node scripts/sync-fonts.mjs --self-test && node scripts/css-selector-diff.mjs --self-test",
    "test:e2e": "node ./node_modules/@playwright/test/cli.js test",
    "db:migrate": "node --env-file-if-exists=.env.local --import tsx scripts/db-migrate.ts",
    "plugin:disable": "node --env-file-if-exists=.env.local --import tsx scripts/plugin-disable.ts",
    "infra:up": "docker compose --env-file .env.local up -d --wait postgres seaweedfs",
    "infra:down": "docker compose --env-file .env.local down",
    "media:cleanup": "node --env-file-if-exists=.env.local --import tsx scripts/media-cleanup.ts",
    "test:unit": "node --import tsx --test \"tests/unit/**/*.test.ts\"",
    "test:integration:foundation": "node scripts/test-foundation.mjs",
    "test:integration": "node scripts/test-foundation.mjs --all",
    "test:operations": "node --import tsx --test tests/operations/fresh-install.test.ts",
    "test:operations:update": "node --import tsx --test tests/operations/managed-update.test.ts",
    "astro": "astro",
    "fonts:sync": "node scripts/sync-fonts.mjs"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.6",
    "@astrojs/react": "^6.0.6",
    "@aws-sdk/client-s3": "3.1131.0",
    "@aws-sdk/s3-request-presigner": "3.1131.0",
    "@better-auth/passkey": "1.7.3",
    "@fontsource/google-sans": "^5.3.1",
    "@fontsource/ibm-plex-sans-thai": "^5.3.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tiptap/core": "2.27.3",
    "@tiptap/extension-image": "2.27.3",
    "@tiptap/extension-link": "2.27.3",
    "@tiptap/html": "2.27.3",
    "@tiptap/starter-kit": "2.27.3",
    "astro": "^7.3.3",
    "better-auth": "1.7.3",
    "kysely": "^0.29.5",
    "novel": "^1.0.2",
    "pg": "^8.23.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sanitize-html": "^2.17.0",
    "sharp": "0.35.4",
    "slugify": "^1.6.9",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.13",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "1.63.0",
    "@types/node": "^26.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@types/sanitize-html": "^2.16.1",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.28",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
