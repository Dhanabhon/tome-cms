{
  "name": "tome-cms",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "bootstrap:core": "node scripts/bootstrap-core.mjs",
    "backup": "node --env-file-if-exists=.env.local --import tsx scripts/backup.ts",
    "restore:check": "node --env-file-if-exists=.env.local --import tsx scripts/restore-check.ts",
    "admin:reset-installation": "node --env-file-if-exists=.env.local --import tsx scripts/reset-installation.mjs",
    "admin:recover": "node scripts/recover-owner.mjs",
    "dev": "astro dev",
    "dev:macos": "./scripts/dev-local-macos.sh",
    "dev:windows": "powershell -ExecutionPolicy Bypass -File ./scripts/dev-local-windows.ps1",
    "build": "astro build",
    "preview": "astro preview",
    "version": "npm run check && npm run build",
    "check": "astro check && node --import tsx scripts/reset-installation.mjs --self-test && node --import tsx scripts/backup.ts --self-test && node --import tsx scripts/restore-check.ts --self-test && bash -n scripts/deploy-vps.sh scripts/dev-local-macos.sh",
    "test:e2e": "node --env-file=.env.local ./node_modules/@playwright/test/cli.js test",
    "db:migrate": "node --env-file-if-exists=.env.local --import tsx scripts/db-migrate.ts",
    "infra:up": "docker compose --env-file .env.local up -d postgres minio minio-init",
    "infra:down": "docker compose --env-file .env.local down",
    "media:cleanup": "node --env-file-if-exists=.env.local --import tsx scripts/media-cleanup.ts",
    "test:unit": "node --import tsx --test \"tests/unit/**/*.test.ts\"",
    "test:integration:foundation": "node scripts/test-foundation.mjs",
    "test:integration": "node scripts/test-foundation.mjs --all",
    "test:operations": "node --import tsx --test tests/operations/fresh-install.test.ts",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/node": "^9.5.5",
    "@astrojs/react": "^4.4.2",
    "@astrojs/tailwind": "^6.0.2",
    "@aws-sdk/client-s3": "3.1131.0",
    "@aws-sdk/s3-request-presigner": "3.1131.0",
    "@better-auth/passkey": "1.7.3",
    "@tailwindcss/typography": "^0.5.20",
    "@tiptap/core": "2.27.3",
    "@tiptap/extension-image": "2.27.3",
    "@tiptap/extension-link": "2.27.3",
    "@tiptap/html": "2.27.3",
    "@tiptap/starter-kit": "2.27.3",
    "astro": "^5.18.2",
    "better-auth": "1.7.3",
    "kysely": "^0.29.5",
    "novel": "^1.0.2",
    "pg": "^8.23.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sanitize-html": "^2.17.0",
    "sharp": "0.35.4",
    "slugify": "^1.6.9",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.13",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "1.63.0",
    "@types/node": "^26.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@types/sanitize-html": "^2.16.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
