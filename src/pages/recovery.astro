---
import RecoveryPasskey from '../components/admin/RecoveryPasskey';
import AdminLayout from '../layouts/AdminLayout.astro';
import { adminCopy } from '../lib/admin-i18n';
import { normalizeAdminPath } from '../lib/admin';
import { getSiteSettings } from '../server/content/site-settings';
import { activeSignInWidget } from '../server/plugins/sign-in';
import type { SignInWidget } from '../plugins/contract';

let adminPath = '/admin';
let ownerSettings: Awaited<ReturnType<typeof getSiteSettings>> = null;
let widget: SignInWidget | null = null;
try {
  ownerSettings = await getSiteSettings();
  adminPath = normalizeAdminPath(ownerSettings?.admin_path ?? '/admin');
  // The challenge, if the owner switched one on, stands on the recovery code: the one secret a person types.
  if (ownerSettings) widget = (await activeSignInWidget(ownerSettings.owner_id))?.widget ?? null;
} catch {
  // Recovery remains available when settings cannot be read; the API reports infrastructure failures safely.
}
const ownerLocale = ownerSettings?.default_locale ?? null;
const copy = adminCopy(ownerLocale);
const suppliedContext = Astro.url.searchParams.get('context') ?? '';
const initialContext = suppliedContext.length <= 2_048 ? suppliedContext : '';
Astro.response.headers.set('Cache-Control', 'no-store');
Astro.response.headers.set('Referrer-Policy', 'no-referrer');
---

<AdminLayout lang={ownerLocale ?? 'en'} title={copy.recovery.title}>
  <main class="security-page">
    <header class="security-page__head">
      <a class="admin-auth-brand" href="/" aria-label={copy.auth.tomecmsHome}>
        <img class="tomecms-logo" src="/brand/tomecms-logo-color.png" alt="TomeCMS" width="2172" height="724" />
      </a>
      <div>
        <p class="security-eyebrow">{copy.recovery.eyebrow}</p>
        <h1>{copy.recovery.heading}</h1>
        <p>{copy.recovery.hint}</p>
      </div>
    </header>
    <RecoveryPasskey client:only="react" adminPath={adminPath} ownerLocale={ownerLocale} initialContext={initialContext} widget={widget} />
  </main>
</AdminLayout>
