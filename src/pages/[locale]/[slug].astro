---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { isPostLocale, localePath, pagePath } from '../../lib/i18n';
import { pageDescription, RESERVED_PAGE_SLUGS } from '../../lib/pages';
import { getPublishedPage, type PublishedPage } from '../../server/content/published';
import { movedPage } from '../../server/content/redirects';
import { getSiteSettings } from '../../server/content/settings';
import { resolveTheme } from '../../themes/registry';
import type { PostAlternate } from '../../types/cms';

const settings = await getSiteSettings();
const localeValue = Astro.params.locale;
const locale = isPostLocale(localeValue) ? localeValue : settings?.default_locale ?? 'en';
const slug = Astro.params.slug;
const fallbackDescription = settings?.site_description || 'Read the latest from TomeCMS.';
let page: PublishedPage | null = null;
let availableLocales: PostAlternate[] = [];
let loadError = false;

try {
  if (!isPostLocale(localeValue) || !slug || RESERVED_PAGE_SLUGS.has(slug)) {
    Astro.response.status = 404;
  } else {
    page = await getPublishedPage(locale, slug);
    if (!page) {
      // A page that moved leaves its old address pointing at it, as a post does.
      const moved = await movedPage(locale, slug);
      if (moved) return Astro.redirect(moved, 301);
      Astro.response.status = 404;
    } else {
      availableLocales = page.translations;
    }
  }
} catch (error) {
  console.error('Public Page query failed:', error);
  Astro.response.status = 500;
  loadError = true;
  page = null;
  availableLocales = [];
}

const activeTheme = await resolveTheme(settings?.theme_id);
const xDefaultHref = availableLocales.find((alternate) => alternate.locale === settings?.default_locale)?.href;
---

<BaseLayout
  alternates={availableLocales}
  canonicalPath={page ? pagePath(page) : undefined}
  description={page ? pageDescription(page, fallbackDescription) : fallbackDescription}
  headline={page?.title}
  locale={locale}
  robots={page ? undefined : 'noindex, follow'}
  title={page?.meta_title ?? page?.title ?? (loadError ? 'Unavailable' : 'Page not found')}
  type={page ? 'page' : 'website'}
  xDefaultHref={xDefaultHref}
>
  {page ? (
    <activeTheme.Page locale={locale} page={page} />
  ) : (
    <section class="mx-auto max-w-3xl px-5 py-20 text-center sm:px-7">
      <p class="text-xs font-medium uppercase tracking-[0.125px] text-muted">{loadError ? 'Unavailable' : '404'}</p>
      <h1 class="notice-title mt-4">{loadError ? 'This page is temporarily unavailable.' : 'Page not found.'}</h1>
      <a class="mt-8 inline-block font-medium text-link hover:underline" href={localePath(locale)}>Return to all posts</a>
    </section>
  )}
</BaseLayout>
