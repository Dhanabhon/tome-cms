---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { categoryRedirect, isPostLocale, localePath, publicCopy } from '../../lib/i18n';
import { siteDescriptionFor } from '../../lib/seo';
import { getPublicAuthorProfile } from '../../lib/profile';
import { listPublishedCategories, listPublishedPosts } from '../../server/content/published';
import { getPublicSlides } from '../../server/content/slides';
import { getSiteSettings } from '../../server/content/settings';
import { searchQuery } from '../../server/content/search';
import { HttpError } from '../../server/http/errors';
import { maySearch } from '../../server/http/search-limit';
import { THEME_MANIFESTS } from '../../themes/manifests';
import { homePageLimit } from '../../themes/page-size';
import { DEFAULT_THEME_ID, isThemeId, resolveTheme } from '../../themes/registry';
import { readThemeSettings } from '../../server/themes/store';
import type { ThemeHomePost } from '../../themes/contract';
import type { PostAlternate, PostCategoryBadge, PublicHomeSlide } from '../../types/cms';

const localeValue = Astro.params.locale;
if (!isPostLocale(localeValue)) {
  return new Response('Not found.\n', { headers: { 'Content-Type': 'text/plain; charset=utf-8' }, status: 404 });
}
const locale = localeValue;
// Two rows at three across, three at two, six at one: a page ends on a full row at any width,
// so the rows the feed script adds after it line up.
const category = Astro.url.searchParams.get('category')?.trim().slice(0, 100) || undefined;
const cursor = Astro.url.searchParams.get('cursor') || undefined;
// What the reader searched for, as the words that will be looked for. An empty box sends `q=`,
// and a query of nothing but spaces or control characters is no search either.
const query = searchQuery(Astro.url.searchParams.get('q'));
if (query && !maySearch(Astro.request, Astro.clientAddress)) {
  return new Response('Too many searches. Try again in a minute.\n', {
    headers: { 'Content-Type': 'text/plain; charset=utf-8', 'Retry-After': '60' },
    status: 429,
  });
}
// An old link to the home filtered by a category goes to that category's page, for good, when the
// page answers in this language; the page of the list it asked for does not carry over. Anything
// else -- an unknown name, the default category, a search -- is the home as it always was.
if (category && !query) {
  try {
    const moved = categoryRedirect(locale, category, (await listPublishedCategories(locale)).items);
    if (moved) return Astro.redirect(moved, 301);
  } catch (error) {
    console.error('Category redirect lookup failed:', error);
  }
}
let posts: ThemeHomePost[] = [];
// Read whatever the theme will do with them: which hero it draws is its own setting, and the
// read is five seconds of cache away. It never throws: a failure is a hero without slides.
let slides: PublicHomeSlide[] = [];
let categories: PostCategoryBadge[] = [];
let nextCursor: string | null = null;
let loadError = false;
const settings = await getSiteSettings();
// How many a page holds is the theme's to say: six ends on a full row at one, two or three
// cards across, which is what both themes' grids want. Paper can be told another multiple of
// six. A theme that leads with the newest post asks its first page for one more, so the grid
// under the lead is six too; the pages after it are the normal size.
const themeId = isThemeId(settings?.theme_id) ? settings.theme_id : DEFAULT_THEME_ID;
const themeSettings = await readThemeSettings(themeId);
const PAGE_SIZE = Number(themeSettings.postsPerLoad ?? 6) || 6;
const take = homePageLimit({
  cursor,
  leadsFirstPage: THEME_MANIFESTS.find((manifest) => manifest.id === themeId)?.leadsFirstPage,
  pageSize: PAGE_SIZE,
  query,
});
const siteDescription = siteDescriptionFor(settings, locale);
const profile = settings ? await getPublicAuthorProfile(settings, locale) : null;

const slidesRead = getPublicSlides(locale);
try {
  const [page, published] = await Promise.all([
    listPublishedPosts({ category, cursor, limit: PAGE_SIZE, locale, q: query, take }),
    listPublishedCategories(locale),
  ]);
  posts = page.items;
  nextCursor = page.nextCursor;
  categories = published.items;
} catch (error) {
  // A cursor that fails to verify is a bad request, not the server failing.
  if (error instanceof HttpError) {
    Astro.response.status = error.status;
  } else {
    console.error('Homepage post query failed:', error);
    Astro.response.status = 500;
  }
  loadError = true;
}
// Asked for beside the posts, and awaited apart from them: a failed post read is not a reason
// to lose the hero as well.
slides = await slidesRead;

const availableLocales: PostAlternate[] = [
  { href: localePath('th'), locale: 'th' },
  { href: localePath('en'), locale: 'en' },
];
const activeTheme = await resolveTheme(settings?.theme_id);
---

<BaseLayout
  alternates={availableLocales}
  canonicalPath={localePath(locale)}
  description={siteDescription}
  locale={locale}
  robots={loadError ? 'noindex, nofollow' : cursor || query ? 'noindex, follow' : undefined}
  title={query ? publicCopy(locale).searchResults.replace('{query}', () => query) : undefined}
  xDefaultHref={settings ? localePath(settings.default_locale) : undefined}
  stats={loadError ? undefined : { kind: 'home' }}
>
  <activeTheme.Home
    themeSettings={themeSettings}
    activeCategory={category}
    categories={categories}
    cursor={cursor}
    loadError={loadError}
    locale={locale}
    nextCursor={nextCursor}
    posts={posts}
    profile={profile}
    query={query}
    slides={slides}
    siteName={settings?.site_name ?? 'TomeCMS'}
    tagline={settings?.tagline?.trim() || publicCopy(locale).defaultTagline}
    timezone={settings?.timezone ?? 'UTC'}
  />
</BaseLayout>
