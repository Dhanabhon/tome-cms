---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { documentHasVideo } from '../../../lib/editor-video';
import { isPostLocale, localePath, postPath, publicCopy } from '../../../lib/i18n';
import { postDescription } from '../../../lib/posts';
import { getPublicAuthorProfile } from '../../../lib/profile';
import {
  getPublishedPost,
  type PublishedPost,
} from '../../../server/content/published';
import { getSiteSettings } from '../../../server/content/settings';
import { movedPost } from '../../../server/content/redirects';
import { DEFAULT_THEME_ID, isThemeId, resolveTheme } from '../../../themes/registry';
import { readThemeSettings } from '../../../server/themes/store';
import type { PostAlternate, PostCategoryBadge, PublicAuthorProfile } from '../../../types/cms';

const localeValue = Astro.params.locale;
if (!isPostLocale(localeValue)) {
  return new Response('Not found.\n', { headers: { 'Content-Type': 'text/plain; charset=utf-8' }, status: 404 });
}
const locale = localeValue;
const slug = Astro.params.slug;
const settings = await getSiteSettings();
const fallbackDescription = settings?.site_description || 'Read the latest from TomeCMS.';
const articleSettings = settings ?? {
  author_avatar_media_id: null,
  author_bio_en: '',
  author_bio_th: '',
  author_links: [],
  author_name: '',
  site_name: 'TomeCMS',
  timezone: 'UTC',
};
let post: PublishedPost | null = null;
let profile: PublicAuthorProfile | null = null;
let availableLocales: PostAlternate[] = [];
let categories: PostCategoryBadge[] = [];
let loadError = false;

try {
  if (!slug) {
    Astro.response.status = 404;
  } else {
    post = await getPublishedPost(locale, slug);
    if (!post) {
      // Nothing lives here. Something may have, and moved: a link someone shared before a
      // rename should still reach the article, permanently, so search engines move with it.
      const moved = await movedPost(locale, slug);
      if (moved) return Astro.redirect(moved, 301);
      Astro.response.status = 404;
    } else {
      availableLocales = post.translations;
      categories = post.categories;
      profile = await getPublicAuthorProfile(articleSettings, post.locale);
    }
  }
} catch (error) {
  console.error('Blog post query failed:', error);
  Astro.response.status = 500;
  loadError = true;
  post = null;
  profile = null;
}

const activeTheme = await resolveTheme(settings?.theme_id);
const themeSettings = await readThemeSettings(isThemeId(settings?.theme_id) ? settings.theme_id : DEFAULT_THEME_ID);
const xDefaultHref = settings
  ? availableLocales.find((alternate) => alternate.locale === settings.default_locale)?.href
  : undefined;
const copy = publicCopy(locale);
---

<BaseLayout
  alternates={availableLocales}
  authorLinks={profile?.links.map(({ url }) => url)}
  authorName={profile?.name}
  canonicalPath={post ? postPath(post) : undefined}
  description={post ? postDescription(post, fallbackDescription) : fallbackDescription}
  headline={post?.title}
  image={post?.cover_image}
  locale={locale}
  modifiedTime={post?.updated_at}
  publishedTime={post?.published_at ?? post?.created_at}
  robots={post ? undefined : 'noindex, follow'}
  stats={post ? { id: post.id, kind: 'post' } : undefined}
  metaTitle={post?.meta_title}
  title={post?.title ?? (loadError ? copy.unavailable : copy.postNotFound)}
  type={post ? 'article' : 'website'}
  video={post ? documentHasVideo(post.content_json) : false}
  xDefaultHref={xDefaultHref}
>
  {post ? (
    <activeTheme.Post categories={categories} locale={locale} post={post} profile={profile}
      settings={articleSettings} themeSettings={themeSettings} />
  ) : (
    <section class="notice-page mx-auto max-w-3xl px-5 py-20 sm:px-7">
      <p class="notice-status">{loadError ? copy.unavailable : '404'}</p>
      <h1 class="article-title">{loadError ? copy.postUnavailable : copy.postNotFound}</h1>
      <p class="notice-back"><a href={localePath(locale)}>{copy.returnToAllPosts}</a></p>
    </section>
  )}
</BaseLayout>
