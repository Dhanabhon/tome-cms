---
import packageMetadata from '../../package.json' with { type: 'json' };
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import InstallerWizard from '../components/admin/InstallerWizard';
import { normalizeAdminPath } from '../lib/admin';
import { db } from '../server/db/client';
import '../styles/installer-tokens.css';
import '../styles/installer.css';

try {
  const installed = await db.selectFrom('site_settings').select('admin_path').executeTakeFirst();
  if (installed) return Astro.redirect(normalizeAdminPath(installed.admin_path));
} catch {
  // The Wizard renders its actionable readiness state when infrastructure is unavailable.
}

Astro.response.headers.set('Cache-Control', 'no-store');
const language = Astro.url.searchParams.get('lang') === 'en' ? 'en' : 'th';
const english = language === 'en';
const languageOptions = [
  { href: '/install?lang=en', locale: 'en' },
  { href: '/install?lang=th', locale: 'th' },
] as const;
---

<!doctype html>
<html lang={language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="color-scheme" content="light" />
    <title>{english ? 'Set up your website' : 'ตั้งค่าเว็บไซต์ของคุณ'} · TomeCMS</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <nav class="installer-nav" aria-label={english ? 'Installer navigation' : 'เมนูหน้าติดตั้ง'}>
      <a class="installer-wordmark" href="#top" aria-label="TomeCMS installer">
        <img class="tomecms-logo" src="/brand/tomecms-logo.png" alt="" width="2172" height="724" />
      </a>
      <LanguageSwitcher
        currentLocale={language}
        menuLabel={english ? 'Choose language' : 'เลือกภาษา'}
        options={languageOptions}
        triggerLabel={english ? 'Change language. Current language: English (US)' : 'เปลี่ยนภาษา ภาษาปัจจุบัน: ไทย'}
        variant="installer"
      />
    </nav>

    <main class="installer-page" id="top">
      <header class="installer-intro">
        <h1>{english ? 'A friendly start for your new site' : 'เริ่มต้นเว็บไซต์ใหม่แบบสบาย ๆ'}</h1>
        <p>{english ? 'Six short steps. No password, no hidden setup, and clear help whenever something needs attention.' : 'เพียง 6 ขั้นตอนสั้น ๆ ไม่ต้องตั้งรหัสผ่าน และมีคำแนะนำตรงจุดเมื่อระบบต้องการให้คุณช่วย'}</p>
      </header>

      <InstallerWizard client:only="react" language={language} />

      <p class="installer-footer">© TomeCMS · v{packageMetadata.version} · {english ? 'Set up once, then come back to write.' : 'ตั้งค่าครั้งเดียว แล้วกลับมาเขียนได้ทุกวัน'}</p>
    </main>
  </body>
</html>
