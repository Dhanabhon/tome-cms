---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { localePath, otherLocale, postPath, publicCopy } from '../../lib/i18n';
import { getPublishedPost } from '../../server/content/published';
import { getSiteSettings } from '../../server/content/settings';
import type { Post } from '../../types/cms';

const slug = Astro.params.slug;
const settings = await getSiteSettings();
const defaultLocale = settings?.default_locale ?? 'th';
let post: Post | null = null;
let loadError = false;

try {
  if (slug) {
    post = await getPublishedPost(defaultLocale, slug)
      ?? await getPublishedPost(otherLocale(defaultLocale), slug);
  }
} catch (error) {
  console.error('Legacy blog post query failed:', error);
  Astro.response.status = 500;
  loadError = true;
}

if (post) {
  Astro.response.status = 301;
  Astro.response.headers.set('Location', postPath(post));
} else if (!loadError) {
  Astro.response.status = 404;
}
const copy = publicCopy(defaultLocale);
---

{!post && (
  <BaseLayout
    locale={defaultLocale}
    robots="noindex, follow"
    title={loadError ? copy.unavailable : copy.postNotFound}
  >
    <section class="notice-page mx-auto max-w-3xl px-5 py-20 sm:px-7">
      <p class="notice-status">{loadError ? copy.unavailable : '404'}</p>
      <h1 class="article-title">{loadError ? copy.postUnavailable : copy.postNotFound}</h1>
      <p class="notice-back"><a href={localePath(defaultLocale)}>{copy.returnToAllPosts}</a></p>
    </section>
  </BaseLayout>
)}
