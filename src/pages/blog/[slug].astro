---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { localePath, otherLocale, postPath } from '../../lib/i18n';
import { getSiteSettings } from '../../lib/installation';
import { createServerSupabaseClient } from '../../lib/supabase';
import type { Post } from '../../types/cms';

const slug = Astro.params.slug;
const settings = await getSiteSettings();
const defaultLocale = settings?.default_locale ?? 'th';
let post: Post | null = null;
let loadError = false;

try {
  if (slug) {
    const supabase = createServerSupabaseClient(Astro.cookies, Astro.request);
    const { data, error } = await supabase
      .from('posts')
      .select('*')
      .eq('locale', defaultLocale)
      .eq('slug', slug)
      .eq('status', 'published')
      .maybeSingle();
    if (error) throw error;
    post = data;

    if (!post) {
      const { data: fallback, error: fallbackError } = await supabase
        .from('posts')
        .select('*')
        .eq('locale', otherLocale(defaultLocale))
        .eq('slug', slug)
        .eq('status', 'published')
        .maybeSingle();
      if (fallbackError) throw fallbackError;
      post = fallback;
    }
  }
} catch (error) {
  console.error('Legacy blog post query failed:', error);
  Astro.response.status = 500;
  loadError = true;
}

if (post) {
  Astro.response.status = 301;
  Astro.response.headers.set('Location', postPath(post));
} else if (!loadError) {
  Astro.response.status = 404;
}
---

{!post && (
  <BaseLayout
    locale={defaultLocale}
    robots="noindex, follow"
    title={loadError ? 'Unavailable' : 'Post not found'}
  >
    <section class="mx-auto max-w-3xl px-5 py-20 text-center sm:px-7">
      <p class="text-xs font-medium uppercase tracking-[0.125px] text-muted">{loadError ? 'Unavailable' : '404'}</p>
      <h1 class="mt-4 font-display text-[40px] font-normal leading-[60px]">{loadError ? 'This post is temporarily unavailable.' : 'Post not found.'}</h1>
      <a class="mt-8 inline-block font-medium text-link hover:underline" href={localePath(defaultLocale)}>Return to all posts</a>
    </section>
  </BaseLayout>
)}
