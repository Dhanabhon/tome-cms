---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { localePath, otherLocale, postPath } from '../../lib/i18n';
import { getPublishedPost } from '../../server/content/published';
import { getSiteSettings } from '../../server/content/settings';
import type { Post } from '../../types/cms';

const slug = Astro.params.slug;
const settings = await getSiteSettings();
const defaultLocale = settings?.default_locale ?? 'th';
let post: Post | null = null;
let loadError = false;

try {
  if (slug) {
    post = await getPublishedPost(defaultLocale, slug)
      ?? await getPublishedPost(otherLocale(defaultLocale), slug);
  }
} catch (error) {
  console.error('Legacy blog post query failed:', error);
  Astro.response.status = 500;
  loadError = true;
}

if (post) {
  Astro.response.status = 301;
  Astro.response.headers.set('Location', postPath(post));
} else if (!loadError) {
  Astro.response.status = 404;
}
---

{!post && (
  <BaseLayout
    locale={defaultLocale}
    robots="noindex, follow"
    title={loadError ? 'Unavailable' : 'Post not found'}
  >
    <section class="mx-auto max-w-3xl px-5 py-20 text-center sm:px-7">
      <p class="text-xs font-medium uppercase tracking-[0.125px] text-muted">{loadError ? 'Unavailable' : '404'}</p>
      <h1 class="notice-title mt-4">{loadError ? 'This post is temporarily unavailable.' : 'Post not found.'}</h1>
      <a class="mt-8 inline-block font-medium text-link hover:underline" href={localePath(defaultLocale)}>Return to all posts</a>
    </section>
  </BaseLayout>
)}
