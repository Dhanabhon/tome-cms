---
import { z } from 'zod';

import AdminSkeleton from '../../../../components/admin/AdminSkeleton.astro';
import PageEditor from '../../../../components/admin/PageEditor';
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import AiUndoBar from '../../../../components/admin/AiUndoBar';
import EditingStatus from '../../../../components/admin/EditingStatus';
import { adminCopy, adminDateFormat } from '../../../../lib/admin-i18n';
import { adminLoginPath } from '../../../../lib/admin';
import { requireInstalledOwner } from '../../../../server/auth/session';
import { getPage, listPageTranslations } from '../../../../server/content/pages';
import { getSiteSettings, type SiteSettings } from '../../../../server/content/settings';
import { HttpError } from '../../../../server/http/errors';
import type { Page, PageTranslationSummary } from '../../../../types/cms';
import { suggestionsAvailable } from '../../../../server/plugins/suggestions';
import { readSnapshot } from '../../../../server/mcp/snapshots';

let page: Page | null = null;
let editorPage: Omit<Page, 'translation_group_id'> | null = null;
let translations: PageTranslationSummary[] = [];
let errorKey: 'editorUnavailable' | 'pageNotFound' | null = null;
let serverMessage: string | null = null;
let settings: SiteSettings | null = null;
const id = z.uuid().safeParse(Astro.params.id);

try {
  if (!id.success) {
    Astro.response.status = 404;
    errorKey = 'pageNotFound';
  } else {
    settings = await getSiteSettings();
    const current = await requireInstalledOwner(Astro.request.headers);
    if (!settings || settings.owner_id !== current.user.id) throw new HttpError(404, '');
    page = await getPage(current.user.id, id.data);
    if (!page) {
      Astro.response.status = 404;
      errorKey = 'pageNotFound';
    } else {
      translations = await listPageTranslations(current.user.id, page.translation_group_id);
      const { translation_group_id: _translationGroupId, ...safePage } = page;
      editorPage = safePage;
    }
  }
} catch (error) {
  if (error instanceof HttpError && error.status === 401) {
    Astro.response.status = 302;
    Astro.response.headers.set('Location', adminLoginPath(Astro.url.pathname + Astro.url.search, settings?.admin_path ?? '/admin'));
  } else {
    console.error('Page editor query failed.');
    Astro.response.status = error instanceof HttpError && error.status === 404 ? 404 : 500;
    if (error instanceof HttpError && error.status === 404) { if (error.message) serverMessage = error.message; else errorKey = 'pageNotFound'; }
    else errorKey = 'editorUnavailable';
  }
}

const copy = adminCopy(settings?.default_locale);
const errorMessage = serverMessage ?? (errorKey ? copy.preview[errorKey] : null);
// Drawn only when the owner has switched on a plugin that can make suggestions.
const canSuggest = settings ? await suggestionsAvailable(settings.owner_id) : false;
// An AI changed this draft and its copy from before is kept: offer it back. Only on a draft,
// because an AI never writes anything else and putting back keeps the status a draft.
const aiChange = settings && page?.status === 'draft' ? await readSnapshot(settings.owner_id, 'page', page.id) : null;
const aiUndo = aiChange && settings ? {
  clientName: aiChange.clientName,
  ownerEditedSince: aiChange.ownerEditedSince,
  time: adminDateFormat(settings.default_locale, settings.timezone).format(new Date(aiChange.aiWrittenAt)),
} : null;
---

<AdminLayout adminPath={settings?.admin_path ?? '/admin'} title={page?.title ?? 'Edit page'}>
  <main>
    {page && aiUndo && <AiUndoBar cancelLabel={copy.shell.cancel} client:load id={page.id} kind="page" snapshot={aiUndo} text={copy.aiUndo} updatedAt={page.updated_at} />}
    {/* Drafts only: an AI cannot change anything else, so there is nothing to hold or tell. */}
    {page?.status === 'draft' && <EditingStatus client:load id={page.id} kind="page" locale={settings?.default_locale} text={copy.editing} undoClient={aiUndo?.clientName ?? null} updatedAt={page.updated_at} />}
    {page && editorPage ? (
      <PageEditor canSuggest={canSuggest} adminPath={settings?.admin_path ?? '/admin'} ownerLocale={settings?.default_locale} client:only="react" initialPage={editorPage} locale={page.locale} translations={translations}>
        <AdminSkeleton kind="editor" label={copy.preview.loadingEditor} slot="fallback" />
      </PageEditor>
    ) : (
      <p class="admin-alert admin-alert--page" role="alert">{errorMessage}</p>
    )}
  </main>
</AdminLayout>
