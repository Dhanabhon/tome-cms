---
import { z } from 'zod';

import PageEditor from '../../../../components/admin/PageEditor';
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import { adminLoginPath } from '../../../../lib/admin';
import { requireInstalledOwner } from '../../../../server/auth/session';
import { getPage, listPageTranslations } from '../../../../server/content/pages';
import { getSiteSettings, type SiteSettings } from '../../../../server/content/settings';
import { HttpError } from '../../../../server/http/errors';
import type { Page, PageTranslationSummary } from '../../../../types/cms';

let page: Page | null = null;
let editorPage: Omit<Page, 'translation_group_id'> | null = null;
let translations: PageTranslationSummary[] = [];
let errorMessage: string | null = null;
let settings: SiteSettings | null = null;
const id = z.uuid().safeParse(Astro.params.id);

try {
  if (!id.success) {
    Astro.response.status = 404;
    errorMessage = 'Page not found.';
  } else {
    settings = await getSiteSettings();
    const current = await requireInstalledOwner(Astro.request.headers);
    if (!settings || settings.owner_id !== current.user.id) throw new HttpError(404, 'Page not found.');
    page = await getPage(current.user.id, id.data);
    if (!page) {
      Astro.response.status = 404;
      errorMessage = 'Page not found.';
    } else {
      translations = await listPageTranslations(current.user.id, page.translation_group_id);
      const { translation_group_id: _translationGroupId, ...safePage } = page;
      editorPage = safePage;
    }
  }
} catch (error) {
  if (error instanceof HttpError && error.status === 401) {
    Astro.response.status = 302;
    Astro.response.headers.set('Location', adminLoginPath(Astro.url.pathname + Astro.url.search, settings?.admin_path ?? '/admin'));
  } else {
    console.error('Page editor query failed.');
    Astro.response.status = error instanceof HttpError && error.status === 404 ? 404 : 500;
    errorMessage = error instanceof HttpError && error.status === 404 ? error.message : 'The editor is temporarily unavailable.';
  }
}
---

<AdminLayout adminPath={settings?.admin_path ?? '/admin'} title={page?.title ?? 'Edit page'}>
  <main>
    {page && editorPage ? (
      <PageEditor adminPath={settings?.admin_path ?? '/admin'} ownerLocale={settings?.default_locale} client:only="react" initialPage={editorPage} locale={page.locale} translations={translations}>
        <div class="admin-editor-fallback" slot="fallback" role="status">Loading editor…</div>
      </PageEditor>
    ) : (
      <p class="admin-alert admin-alert--page" role="alert">{errorMessage}</p>
    )}
  </main>
</AdminLayout>
