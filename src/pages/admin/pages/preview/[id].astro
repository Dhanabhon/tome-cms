---
import { z } from 'zod';

import { resolveTheme } from '../../../../themes/registry';
import { themeStylesheet } from '../../../../themes/styles';
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import { adminCopy } from '../../../../lib/admin-i18n';
import { adminHref } from '../../../../lib/admin';
import { requireInstalledOwner } from '../../../../server/auth/session';
import { getPage } from '../../../../server/content/pages';
import { getSiteSettings } from '../../../../server/content/settings';
import { HttpError } from '../../../../server/http/errors';
import type { Page, PageLocale } from '../../../../types/cms';

let page: Page | null = null;
let errorKey: 'pageNotFound' | 'signInToPreviewPage' | 'previewUnavailable' | null = null;
let serverMessage: string | null = null;
let adminPath = '/admin';
let themeId: string | null = null;
let ownerLocale: PageLocale | null = null;
const id = z.uuid().safeParse(Astro.params.id);
Astro.response.headers.set('Cache-Control', 'private, no-store');

try {
  if (!id.success) {
    Astro.response.status = 404;
    errorKey = 'pageNotFound';
  } else {
    const current = await requireInstalledOwner(Astro.request.headers);
    const settings = await getSiteSettings();
    if (!settings || settings.owner_id !== current.user.id) throw new HttpError(404, '');
    adminPath = settings.admin_path;
    ownerLocale = settings.default_locale;
    themeId = settings.theme_id;
    page = await getPage(current.user.id, id.data);
    if (!page) {
      Astro.response.status = 404;
      errorKey = 'pageNotFound';
    }
  }
} catch (error) {
  if (error instanceof HttpError && error.status === 401) {
    Astro.response.status = 401;
    errorKey = 'signInToPreviewPage';
  } else {
    console.error('Page preview query failed.');
    Astro.response.status = error instanceof HttpError && error.status === 404 ? 404 : 500;
    if (error instanceof HttpError && error.status === 404) { if (error.message) serverMessage = error.message; else errorKey = 'pageNotFound'; }
    else errorKey = 'previewUnavailable';
  }
}

// A preview is what a reader will see, so the theme draws it.
const activeTheme = await resolveTheme(themeId);
const copy = adminCopy(ownerLocale);
const errorMessage = serverMessage ?? (errorKey ? copy.preview[errorKey] : null);
---

<AdminLayout stylesheet={themeStylesheet(themeId)} adminPath={adminPath} lang={page?.locale} title={page ? `${copy.preview.previewPrefix}: ${page.title}` : copy.preview.draftPreview}>
  <main>
    {errorMessage ? <p class="admin-alert admin-alert--page" role="alert">{errorMessage}</p> : page ? (
      <>
        <div class="admin-preview-bar">
          <span>{copy.preview.draftPreview}</span>
          <a class="admin-button admin-button--secondary" href={adminHref({ admin_path: adminPath }, `/pages/edit/${page.id}`)}>{copy.preview.editPage}</a>
        </div>
        <activeTheme.Page locale={page.locale} page={page} preview />
      </>
    ) : null}
  </main>
</AdminLayout>
