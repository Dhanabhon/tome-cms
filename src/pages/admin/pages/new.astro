---
import { z } from 'zod';

import PageEditor from '../../../components/admin/PageEditor';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { adminLoginPath } from '../../../lib/admin';
import { isPostLocale } from '../../../lib/i18n';
import { getSiteSettings } from '../../../lib/installation';
import { authenticate } from '../../../lib/supabase';
import type { PageLocale, PageTranslationSummary } from '../../../types/cms';

let errorMessage: string | null = null;
let locale: PageLocale | null = null;
let sourcePage: { id: string } | undefined;
let translations: PageTranslationSummary[] = [];

try {
  const auth = await authenticate(Astro.cookies, Astro.request);
  if (!auth) {
    Astro.response.status = 302;
    Astro.response.headers.set('Location', adminLoginPath(Astro.url.pathname + Astro.url.search));
  } else {
    const settings = await getSiteSettings();
    if (!settings) throw new Error('Site settings not found.');

    const sourcePageId = Astro.url.searchParams.get('sourcePageId');
    const targetLocale = Astro.url.searchParams.get('locale');
    const parsedSourcePageId = z.uuid().safeParse(sourcePageId);
    if (!Astro.url.searchParams.has('sourcePageId') && !Astro.url.searchParams.has('locale')) {
      locale = settings.default_locale;
    } else if (!parsedSourcePageId.success || !isPostLocale(targetLocale)) {
      Astro.response.status = 404;
      errorMessage = 'Page not found.';
    } else {
      const { data: source, error } = await auth.supabase
        .from('pages')
        .select('id, locale, status, title, translation_group_id')
        .eq('id', parsedSourcePageId.data)
        .eq('author_id', auth.user.id)
        .maybeSingle();
      if (error) throw error;

      const { data: existing, error: existingError } = source
        ? await auth.supabase
            .from('pages')
            .select('id')
            .eq('translation_group_id', source.translation_group_id)
            .eq('locale', targetLocale)
            .eq('author_id', auth.user.id)
            .maybeSingle()
        : { data: null, error: null };
      if (existingError) throw existingError;

      if (!source || source.locale === targetLocale || existing) {
        Astro.response.status = 404;
        errorMessage = 'Page not found.';
      } else {
        locale = targetLocale;
        sourcePage = { id: source.id };
        translations = [{ id: source.id, locale: source.locale, status: source.status, title: source.title }];
      }
    }
  }
} catch (error) {
  console.error('New page authentication failed:', error);
  Astro.response.status = 500;
  errorMessage = 'The editor is temporarily unavailable.';
}
---

<AdminLayout title="New page">
  <main>
    {errorMessage ? (
      <p class="admin-alert admin-alert--page" role="alert">{errorMessage}</p>
    ) : locale ? (
      <PageEditor client:only="react" locale={locale} sourcePage={sourcePage} translations={translations}>
        <div class="admin-editor-fallback" slot="fallback" role="status">Loading editor…</div>
      </PageEditor>
    ) : null}
  </main>
</AdminLayout>
