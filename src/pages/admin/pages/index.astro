---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import AdminShell from '../../../components/admin/AdminShell.astro';
import UiSelect from '../../../components/admin/UiSelect';
import { adminHref, adminLoginPath } from '../../../lib/admin';
import { adminCopy, adminDateFormat, statusLabel } from '../../../lib/admin-i18n';
import { filterAdminPages, type AdminPageFilters } from '../../../lib/pages';
import { requireInstalledOwner } from '../../../server/auth/session';
import { listPages } from '../../../server/content/pages';
import { getSiteSettings } from '../../../server/content/settings';
import { HttpError } from '../../../server/http/errors';
import type { Page, PageLocale } from '../../../types/cms';

let pages: Page[] = [];
let userEmail: string | null = null;
let errorKey: 'pagesHidden' | 'pagesUnavailable' | null = null;
let authRequired = false;
let settings = null;

try {
  settings = await getSiteSettings();
  const current = await requireInstalledOwner(Astro.request.headers);
  if (!settings || settings.owner_id !== current.user.id) {
    Astro.response.status = 404;
    errorKey = 'pagesHidden';
  } else {
    userEmail = current.user.email;
    pages = await listPages(current.user.id);
  }
} catch (error) {
  if (error instanceof HttpError && error.status === 401) {
    authRequired = true;
    Astro.response.status = 302;
    Astro.response.headers.set('Location', adminLoginPath(Astro.url.pathname + Astro.url.search, settings?.admin_path ?? '/admin'));
  } else {
    console.error('Admin page query failed.');
    Astro.response.status = 500;
    errorKey = 'pagesUnavailable';
  }
}

const adminPath = settings?.admin_path ?? '/admin';
const adminSettings = { admin_path: adminPath };

const ownerLocale = settings?.default_locale ?? null;
const copy = adminCopy(ownerLocale);
const errorMessage = errorKey ? copy.errors[errorKey] : null;
const dateFormatter = adminDateFormat(ownerLocale, settings?.timezone ?? 'UTC');
const status = ['draft', 'published', 'all'].includes(Astro.url.searchParams.get('status') ?? '')
  ? Astro.url.searchParams.get('status') as 'draft' | 'published' | 'all'
  : 'draft';
const locale = ['th', 'en', 'all'].includes(Astro.url.searchParams.get('locale') ?? '')
  ? Astro.url.searchParams.get('locale') as PageLocale | 'all'
  : 'all';
const query = (Astro.url.searchParams.get('q') ?? '').trim().slice(0, 100);
const filters: AdminPageFilters = { status, locale, query };
const filteredPages = filterAdminPages(pages, filters);
const editions = new Map<string, Page[]>();
for (const page of pages) {
  const group = editions.get(page.translation_group_id) ?? [];
  group.push(page);
  editions.set(page.translation_group_id, group);
}
const tabs = [{ status: 'draft', label: copy.status.drafts }, { status: 'published', label: copy.status.published }, { status: 'all', label: copy.status.all }];
---

<AdminLayout adminPath={adminPath} lang={ownerLocale ?? 'en'} title={copy.pages.heading}>
  {authRequired || errorMessage ? (
    <main><p class="admin-alert admin-alert--page" role="alert">{errorMessage}</p></main>
  ) : (
    <AdminShell active="pages" adminPath={adminPath} locale={settings?.default_locale} siteName={settings?.site_name ?? 'TomeCMS'} userEmail={userEmail}>
      <section class="admin-page">
        <header class="admin-page__head">
          <div><h1>{copy.pages.heading}</h1><p>{copy.pages.subheading}</p></div>
          <a class="admin-button admin-button--primary" href={adminHref(adminSettings, '/pages/new')}>{copy.pages.newPage} <span aria-hidden="true">+</span></a>
        </header>
        <div data-admin-pages data-timezone={settings?.timezone ?? 'UTC'} data-locale={ownerLocale} data-copy-draft={copy.status.draft} data-copy-published={copy.status.published} data-copy-published-at={copy.status.publishedAt} data-copy-updated-at={copy.status.updatedAt} data-copy-publish={copy.row.publish} data-copy-unpublish={copy.row.unpublish} data-copy-delete={copy.row.delete} data-copy-delete-prefix={copy.row.deletePrefix} data-copy-delete-title={copy.pages.deleteTitle} data-copy-delete-message={copy.pages.deleteMessage} data-copy-unpublish-title={copy.pages.unpublishTitle} data-copy-unpublish-message={copy.pages.unpublishMessage}>
          <nav class="admin-post-tabs" aria-label={copy.pages.statusLabel}>
            {tabs.map((tab) => (
              <a aria-current={status === tab.status ? "page" : undefined} href={adminHref(adminSettings, `/pages?${new URLSearchParams({ status: tab.status, locale, q: query })}`)}>{tab.label}</a>
            ))}
          </nav>
          <form class="admin-post-filters" action={adminHref(adminSettings, '/pages')} method="get" novalidate>
            <input type="hidden" name="status" value={status} />
            <div class="admin-field">
              <label for="page-search">{copy.pages.search}</label>
              <input class="admin-control" id="page-search" name="q" type="search" maxlength="100" value={query} placeholder={copy.filters.searchByTitle} />
            </div>
            <div class="admin-field">
              <label for="page-locale">{copy.filters.language}</label>
              <UiSelect
                client:load
                className="admin-control"
                defaultValue={locale}
                id="page-locale"
                name="locale"
                options={[
                  { label: copy.filters.allLanguages, value: 'all' },
                  { label: copy.filters.thai, value: 'th' },
                  { label: copy.filters.english, value: 'en' },
                ]}
              />
            </div>
            <button class="admin-button" type="submit">{copy.filters.apply}</button>
          </form>
          <p class="admin-alert" data-page-error role="alert" hidden></p>
          <div class="admin-story-list">
            {filteredPages.map((page) => {
              const title = page.title.trim() || copy.pages.untitled;
              const sibling = editions.get(page.translation_group_id)?.find((edition) => edition.locale !== page.locale);
              const timestamp = page.status === 'published' ? page.published_at ?? page.updated_at : page.updated_at;
              return (
                <article class="admin-story-row admin-page-row" aria-label={`${title} (${page.locale.toUpperCase()})`}>
                  <div class="admin-story-content">
                    <h2><a href={adminHref(adminSettings, `/pages/edit/${page.id}`)}>{title}</a></h2>
                    <p class="admin-page-path">/{page.locale}/{page.slug}</p>
                    <div class="admin-story-meta">
                      <span class="admin-locale">{page.locale.toUpperCase()}</span>
                      <span class="admin-status" data-status={page.status}>{statusLabel(copy, page.status)}</span>
                      <span data-story-when><span data-story-verb>{page.status === 'published' ? copy.status.publishedAt : copy.status.updatedAt}</span> <time datetime={timestamp}>{dateFormatter.format(new Date(timestamp))}</time> ({settings?.timezone ?? 'UTC'})</span>
                    </div>
                    <p class="admin-story-sibling">
                      {sibling ? <a href={adminHref(adminSettings, `/pages/edit/${sibling.id}`)}>{sibling.locale.toUpperCase()} {statusLabel(copy, sibling.status)}</a> : <a href={adminHref(adminSettings, `/pages/new?${new URLSearchParams({ sourcePageId: page.id, locale: page.locale === 'th' ? 'en' : 'th' })}`)}>{page.locale === 'th' ? 'EN' : 'TH'} {copy.row.missing}</a>}
                    </p>
                  </div>
                  <details class="admin-story-menu">
                    <summary aria-label={`${copy.pages.actionsFor} ${title} (${page.locale.toUpperCase()})`}><span aria-hidden="true">⋯</span></summary>
                    <div>
                      <a href={adminHref(adminSettings, `/pages/edit/${page.id}`)}>{copy.row.edit}</a>
                      <a href={adminHref(adminSettings, `/pages/preview/${page.id}`)} target="_blank" rel="noopener noreferrer">{copy.row.preview}</a>
                      <button type="button" data-page-action={page.status === 'draft' ? 'published' : 'draft'} data-page-id={page.id} data-page-updated-at={page.updated_at} data-page-title={title} data-page-locale={page.locale.toUpperCase()}>{page.status === 'draft' ? copy.row.publish : copy.row.unpublish}</button>
                      <button type="button" data-page-action="delete" data-page-id={page.id} data-page-updated-at={page.updated_at} data-page-title={title} data-page-locale={page.locale.toUpperCase()}>{copy.row.delete}</button>
                    </div>
                  </details>
                </article>
              );
            })}
            {!filteredPages.length && (
              <div class="admin-empty">
                <span class="admin-empty__mark" aria-hidden="true">+</span>
                <div><h2>{pages.length ? copy.pages.noMatchTitle : copy.pages.emptyTitle}</h2><p>{pages.length ? copy.pages.noMatchBody : copy.pages.emptyBody}</p></div>
                {!pages.length && <a class="admin-button admin-button--secondary" href={adminHref(adminSettings, '/pages/new')}>{copy.pages.createFirst}</a>}
              </div>
            )}
          </div>
        </div>
      </section>
    </AdminShell>
  )}
</AdminLayout>

<script>
  import { confirmUi } from '../../../lib/ui-dialog';

  const pagesContainer = document.querySelector<HTMLElement>('[data-admin-pages]');
  const pageError = pagesContainer?.querySelector<HTMLElement>('[data-page-error]');
  pagesContainer?.addEventListener('click', async (event) => {
    const button = event.target instanceof Element ? event.target.closest<HTMLButtonElement>('button[data-page-action]') : null;
    if (!button || button.disabled) return;
    const { pageAction: action, pageId: id, pageUpdatedAt: updatedAt } = button.dataset;
    if (!id || !action || !updatedAt) return;
    if (action === 'delete' || action === 'draft') {
      const edition = `“${button.dataset.pageTitle}” (${button.dataset.pageLocale})`;
      const confirmed = await confirmUi(action === 'delete' ? {
        title: 'Delete page?',
        message: `Delete ${edition}? This edition and its menu references will be permanently removed. Other language editions will stay saved. This cannot be undone.`,
        confirmLabel: 'Delete',
        tone: 'danger',
      } : {
        title: 'Unpublish page?',
        message: `Unpublish ${edition}? Menu placements stay saved but disappear publicly until republished.`,
        confirmLabel: 'Unpublish',
      });
      if (!confirmed) return;
    }
    button.disabled = true;
    try {
      const response = action === 'delete'
        ? await fetch('/api/admin/pages', {
            method: 'DELETE',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ id, updatedAt }),
          })
        : await fetch('/api/admin/pages', {
            method: 'PATCH',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ id, status: action, updatedAt }),
          });
      if (!response.ok) {
        const body = await response.json().catch(() => null);
        throw new Error(body?.error || 'The action could not be completed. Please try again.');
      }
      window.location.reload();
    } catch (error) {
      if (pageError) {
        pageError.textContent = error instanceof Error ? error.message : 'The action could not be completed. Please try again.';
        pageError.hidden = false;
      }
      button.disabled = false;
    }
  });
</script>
