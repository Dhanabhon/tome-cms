---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import Icon from '../../../components/Icon.astro';
import AdminShell from '../../../components/admin/AdminShell.astro';
import UiSelect from '../../../components/admin/UiSelect';
import { adminHref, adminLoginPath, adminPreviewHref } from '../../../lib/admin';
import { adminCopy, adminDateFormat, statusLabel } from '../../../lib/admin-i18n';
import { filterAdminPages, type AdminPageFilters } from '../../../lib/pages';
import { groupAdminStories } from '../../../lib/posts';
import { requireInstalledOwner } from '../../../server/auth/session';
import { listPages } from '../../../server/content/pages';
import { getSiteSettings } from '../../../server/content/settings';
import { HttpError } from '../../../server/http/errors';
import { POST_LOCALES, type Page, type PageLocale } from '../../../types/cms';

let pages: Page[] = [];
let userEmail: string | null = null;
let errorKey: 'pagesHidden' | 'pagesUnavailable' | null = null;
let authRequired = false;
let settings = null;

try {
  settings = await getSiteSettings();
  const current = await requireInstalledOwner(Astro.request.headers);
  if (!settings || settings.owner_id !== current.user.id) {
    Astro.response.status = 404;
    errorKey = 'pagesHidden';
  } else {
    userEmail = current.user.email;
    pages = await listPages(current.user.id);
  }
} catch (error) {
  if (error instanceof HttpError && error.status === 401) {
    authRequired = true;
    Astro.response.status = 302;
    Astro.response.headers.set('Location', adminLoginPath(Astro.url.pathname + Astro.url.search, settings?.admin_path ?? '/admin'));
  } else {
    console.error('Admin page query failed.');
    Astro.response.status = 500;
    errorKey = 'pagesUnavailable';
  }
}

const adminPath = settings?.admin_path ?? '/admin';
const adminSettings = { admin_path: adminPath };

const ownerLocale = settings?.default_locale ?? null;
const copy = adminCopy(ownerLocale);
const errorMessage = errorKey ? copy.errors[errorKey] : null;
const dateFormatter = adminDateFormat(ownerLocale, settings?.timezone ?? 'UTC');
const status = ['draft', 'published', 'all'].includes(Astro.url.searchParams.get('status') ?? '')
  ? Astro.url.searchParams.get('status') as 'draft' | 'published' | 'all'
  : 'draft';
const locale = ['th', 'en', 'all'].includes(Astro.url.searchParams.get('locale') ?? '')
  ? Astro.url.searchParams.get('locale') as PageLocale | 'all'
  : 'all';
const query = (Astro.url.searchParams.get('q') ?? '').trim().slice(0, 100);
const filters: AdminPageFilters = { status, locale, query };
const stories = groupAdminStories(pages, filterAdminPages(pages, filters), ownerLocale);
// The count is what the tab would show with the current language and search still
// applied -- and it counts stories, because stories are what the list renders.
const tabLabels = { draft: copy.status.drafts, published: copy.status.published, all: copy.status.all };
const tabs = (['draft', 'published', 'all'] as const).map((tabStatus) => ({
  status: tabStatus,
  label: tabLabels[tabStatus],
  count: groupAdminStories(pages, filterAdminPages(pages, { ...filters, status: tabStatus }), ownerLocale).length,
}));
---

<AdminLayout adminPath={adminPath} lang={ownerLocale ?? 'en'} title={copy.pages.heading}>
  {authRequired || errorMessage ? (
    <main><p class="admin-alert admin-alert--page" role="alert">{errorMessage}</p></main>
  ) : (
    <AdminShell active="pages" adminPath={adminPath} locale={settings?.default_locale} siteName={settings?.site_name ?? 'TomeCMS'} userEmail={userEmail}>
      <section class="admin-page">
        <header class="admin-page__head">
          <div><h1>{copy.pages.heading}</h1><p>{copy.pages.subheading}</p></div>
          <a class="admin-button admin-button--primary" href={adminHref(adminSettings, '/pages/new')}>{copy.pages.newPage} <span aria-hidden="true">+</span></a>
        </header>
        <div data-admin-pages data-edit-base={adminHref(adminSettings, '/pages/edit')} data-timezone={settings?.timezone ?? 'UTC'} data-locale={ownerLocale} data-copy-action-failed={copy.errors.actionFailed} data-copy-content-required={copy.editor.contentRequired} data-copy-draft={copy.status.draft} data-copy-published={copy.status.published} data-copy-published-at={copy.status.publishedAt} data-copy-updated-at={copy.status.updatedAt} data-copy-publish={copy.row.publish} data-copy-unpublish={copy.row.unpublish} data-copy-delete={copy.row.delete} data-copy-cancel={copy.shell.cancel} data-copy-delete-prefix={copy.row.deletePrefix} data-copy-delete-title={copy.pages.deleteTitle} data-copy-delete-message={copy.pages.deleteMessage}>
          <nav class="admin-post-tabs" aria-label={copy.pages.statusLabel}>
            {tabs.map((tab) => (
              <a aria-current={status === tab.status ? "page" : undefined} href={adminHref(adminSettings, `/pages?${new URLSearchParams({ status: tab.status, locale, q: query })}`)}>{tab.label} <span class="admin-tab-count">{tab.count}</span></a>
            ))}
          </nav>
          <form class="admin-post-filters" action={adminHref(adminSettings, '/pages')} method="get" novalidate>
            <input type="hidden" name="status" value={status} />
            <div class="admin-field">
              <label for="page-search">{copy.pages.search}</label>
              <input class="admin-control" id="page-search" name="q" type="search" maxlength="100" value={query} placeholder={copy.filters.searchByTitle} />
            </div>
            <div class="admin-field">
              <label for="page-locale">{copy.filters.language}</label>
              <UiSelect
                client:load
                className="admin-control"
                defaultValue={locale}
                id="page-locale"
                name="locale"
                options={[
                  { label: copy.filters.allLanguages, value: 'all' },
                  { label: copy.filters.thai, value: 'th' },
                  { label: copy.filters.english, value: 'en' },
                ]}
              />
            </div>
            <button class="admin-button" type="submit">{copy.filters.apply}</button>
          </form>
          <p class="admin-alert" data-page-error role="alert" hidden></p>
          <div class:list={['admin-story-list', stories.length && 'admin-story-panel admin-page-list']}>
            {stories.length > 0 && (
              <div class="admin-page-head" aria-hidden="true">
                <span>{copy.pages.columnPage}</span>
                <span>{copy.pages.columnStatus}</span>
                <span>{copy.pages.columnDate} ({settings?.timezone ?? 'UTC'})</span>
                <span></span>
              </div>
            )}
            {stories.map((story) => {
              const newest = story.editions.reduce((latest, edition) => edition.updated_at > latest.updated_at ? edition : latest);
              const timestamp = newest.status === 'published' ? newest.published_at ?? newest.updated_at : newest.updated_at;
              const missing = POST_LOCALES.filter((candidate) => !story.editions.some(({ locale: written }) => written === candidate));
              return (
                <article class="admin-story-row admin-page-row" aria-label={story.primary.title.trim() || copy.pages.untitled}>
                  <div class="admin-story-content">
                    {story.editions.map((edition, index) => {
                      const title = edition.title.trim() || copy.pages.untitled;
                      const label = `${title} (${edition.locale.toUpperCase()})`;
                      return (
                        <div class:list={['admin-story-edition', index === 0 && 'admin-story-edition--lead']} style={`--edition-row: ${index + 1}`}>
                          <a class="admin-story-edition__link" href={adminHref(adminSettings, `/pages/edit/${edition.id}`)}>
                            <span class="admin-locale">{edition.locale.toUpperCase()}</span>
                            {index === 0
                              ? <h2 class="admin-story-edition__title">{title}</h2>
                              : <span class="admin-story-edition__title">{title}</span>}
                            <span class="admin-page-path">/{edition.locale}/{edition.slug}</span>
                          </a>
                          <span class="admin-status" data-status={edition.status}>{statusLabel(copy, edition.status, edition.published_at)}</span>
                          <details class="admin-story-menu">
                            <summary aria-label={`${copy.pages.actionsFor} ${label}`}><Icon name="more" /></summary>
                            <div>
                              <a href={adminHref(adminSettings, `/pages/edit/${edition.id}`)}>{copy.row.edit}</a>
                              <a href={adminPreviewHref(adminSettings, 'page', edition.id)} target="_blank" rel="noopener noreferrer">{copy.row.preview}</a>
                              <button type="button" data-page-action="duplicate" data-page-id={edition.id} data-page-updated-at={edition.updated_at}>{copy.row.duplicate}</button>
                              <button type="button" data-page-action={edition.status === 'draft' ? 'published' : 'draft'} data-page-id={edition.id} data-page-updated-at={edition.updated_at} data-page-title={title} data-page-locale={edition.locale.toUpperCase()}>{edition.status === 'draft' ? copy.row.publish : copy.row.unpublish}</button>
                              <button type="button" data-page-action="delete" data-page-id={edition.id} data-page-updated-at={edition.updated_at} data-page-title={title} data-page-locale={edition.locale.toUpperCase()}>{copy.row.delete}</button>
                            </div>
                          </details>
                        </div>
                      );
                    })}
                    {missing.map((candidate, offset) => (
                      <a class="admin-story-start" href={adminHref(adminSettings, `/pages/new?${new URLSearchParams({ sourcePageId: story.primary.id, locale: candidate })}`)} style={`--edition-row: ${story.editions.length + offset + 1}`}>
                        <span class="admin-locale">{candidate.toUpperCase()}</span>
                        <span class="admin-story-edition__title">{copy.row.missing}</span>
                      </a>
                    ))}
                  </div>
                  <div class="admin-story-foot">
                    <span data-story-when><Icon name="clock" /><span data-story-verb>{newest.status === 'published' ? copy.status.publishedAt : copy.status.updatedAt}</span> <time datetime={timestamp}>{dateFormatter.format(new Date(timestamp))}</time><span class="admin-story-tz"> ({settings?.timezone ?? 'UTC'})</span></span>
                  </div>
                </article>
              );
            })}
            {!stories.length && (
              <div class="admin-empty">
                <span class="admin-empty__mark" aria-hidden="true"><Icon name="pages" /></span>
                <div><h2>{pages.length ? copy.pages.noMatchTitle : copy.pages.emptyTitle}</h2><p>{pages.length ? copy.pages.noMatchBody : copy.pages.emptyBody}</p></div>
                {!pages.length && <a class="admin-button admin-button--secondary" href={adminHref(adminSettings, '/pages/new')}>{copy.pages.createFirst}</a>}
              </div>
            )}
          </div>
        </div>
      </section>
    </AdminShell>
  )}
</AdminLayout>

<script>
  import wireStoryList from '../../../lib/admin-story-list';
  import { confirmUi } from '../../../lib/ui-dialog';

  const copy = (document.querySelector<HTMLElement>('[data-admin-pages]') ?? document.createElement('div')).dataset;

  wireStoryList({
    endpoint: '/api/admin/pages',
    entity: 'page',
    // Unpublishing is reversible, and its undo is this same button: the row
    // reconciles and it reads "Publish" again. Only the delete is worth a gate.
    confirm: async (action, row) => action !== 'delete' || confirmUi({
      title: copy.copyDeleteTitle ?? 'Delete page?',
      message: `${copy.copyDeletePrefix} “${row.pageTitle}” (${row.pageLocale})? ${copy.copyDeleteMessage}`,
      confirmLabel: copy.copyDelete ?? 'Delete',
      cancelLabel: copy.copyCancel ?? 'Cancel',
      tone: 'danger',
    }),
  });
</script>
