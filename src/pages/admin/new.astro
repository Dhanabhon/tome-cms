---
import Editor from '../../components/admin/Editor';
import AdminLayout from '../../layouts/AdminLayout.astro';
import { authenticate } from '../../lib/supabase';

let userEmail: string | null = null;
let errorMessage: string | null = null;

try {
  const auth = await authenticate(Astro.cookies, Astro.request);
  if (!auth) {
    Astro.response.status = 401;
    errorMessage = 'Sign in with your configured Supabase Auth flow to create a post.';
  } else {
    userEmail = auth.user.email ?? null;
  }
} catch (error) {
  console.error('New post authentication failed:', error);
  Astro.response.status = 500;
  errorMessage = 'The editor is temporarily unavailable.';
}
---

<AdminLayout title="New post" userEmail={userEmail} showHeader={Boolean(errorMessage)}>
  <main>
    {errorMessage ? (
      <p class="admin-alert admin-alert--page" role="alert">{errorMessage}</p>
    ) : (
      <Editor client:only="react">
        <div class="admin-editor-fallback" slot="fallback" role="status">Loading editor…</div>
      </Editor>
    )}
  </main>
</AdminLayout>
