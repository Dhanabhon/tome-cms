---
import { z } from 'zod';

import AdminSkeleton from '../../components/admin/AdminSkeleton.astro';
import Editor from '../../components/admin/Editor';
import AdminLayout from '../../layouts/AdminLayout.astro';
import { adminCopy } from '../../lib/admin-i18n';
import { adminLoginPath } from '../../lib/admin';
import { isPostLocale } from '../../lib/i18n';
import { requireInstalledOwner } from '../../server/auth/session';
import { categoryIdsForPost, listCategories } from '../../server/content/categories';
import { getPost, listPostTranslations } from '../../server/content/posts';
import { getSiteSettings, type SiteSettings } from '../../server/content/settings';
import { HttpError } from '../../server/http/errors';
import type { PostCategory, PostLocale, PostTranslationSummary } from '../../types/cms';
import { hasJudgement } from '../../server/ai/typesafe';

let errorKey: 'editorUnavailable' | 'postNotFound' | null = null;
let serverMessage: string | null = null;
let locale: PostLocale | null = null;
let sourcePost: { cover_image: string | null; cover_media_id: string | null; id: string } | undefined;
let translations: PostTranslationSummary[] = [];
let categories: PostCategory[] = [];
let initialCategoryIds: string[] = [];
let settings: SiteSettings | null = null;

try {
  settings = await getSiteSettings();
  const current = await requireInstalledOwner(Astro.request.headers);
  if (!settings || settings.owner_id !== current.user.id) throw new HttpError(404, 'Site settings not found.');
  categories = await listCategories(current.user.id);
  initialCategoryIds = categories.filter(({ is_default }) => is_default).map(({ id }) => id);

  const sourcePostId = Astro.url.searchParams.get('sourcePostId');
  const targetLocale = Astro.url.searchParams.get('locale');
  const parsedSourcePostId = z.uuid().safeParse(sourcePostId);
  if (!Astro.url.searchParams.has('sourcePostId') && !Astro.url.searchParams.has('locale')) {
    locale = settings.default_locale;
  } else if (!parsedSourcePostId.success || !isPostLocale(targetLocale)) {
    Astro.response.status = 404;
    errorKey = 'postNotFound';
  } else {
    const source = await getPost(current.user.id, parsedSourcePostId.data);
    const editions = source ? await listPostTranslations(current.user.id, source.translation_group_id) : [];
    const existing = editions.find((edition) => edition.locale === targetLocale);

    if (!source || source.locale === targetLocale || existing) {
      Astro.response.status = 404;
      errorKey = 'postNotFound';
    } else {
      locale = targetLocale;
      sourcePost = { cover_image: source.cover_image, cover_media_id: source.cover_media_id, id: source.id };
      initialCategoryIds = await categoryIdsForPost(current.user.id, source.id);
      translations = editions;
    }
  }
} catch (error) {
  if (error instanceof HttpError && error.status === 401) {
    Astro.response.status = 302;
    Astro.response.headers.set('Location', adminLoginPath(Astro.url.pathname + Astro.url.search, settings?.admin_path ?? '/admin'));
  } else {
    console.error('New post loading failed.');
    Astro.response.status = error instanceof HttpError && error.status === 404 ? 404 : 500;
    if (error instanceof HttpError && error.status === 404) serverMessage = error.message;
    else errorKey = 'editorUnavailable';
  }
}

const copy = adminCopy(settings?.default_locale);
const errorMessage = serverMessage ?? (errorKey ? copy.preview[errorKey] : null);
---

<AdminLayout adminPath={settings?.admin_path ?? '/admin'} lang={settings?.default_locale ?? 'en'} title={copy.preview.newPost}>
  <main>
    {errorMessage ? (
      <p class="admin-alert admin-alert--page" role="alert">{errorMessage}</p>
    ) : locale ? (
      <Editor canSuggest={hasJudgement()} adminPath={settings?.admin_path ?? '/admin'} ownerLocale={settings?.default_locale} client:only="react" categories={categories} initialCategoryIds={initialCategoryIds} locale={locale} sourcePost={sourcePost} translations={translations}>
        <AdminSkeleton kind="editor" label={copy.preview.loadingEditor} slot="fallback" />
      </Editor>
    ) : null}
  </main>
</AdminLayout>
