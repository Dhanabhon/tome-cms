---
import AdminLayout from '../../layouts/AdminLayout.astro';
import AdminIcon from '../../components/admin/AdminIcon.astro';
import AdminShell from '../../components/admin/AdminShell.astro';
import PasskeySignIn from '../../components/admin/PasskeySignIn';
import UiSelect from '../../components/admin/UiSelect';
import { adminHref, adminPreviewHref } from '../../lib/admin';
import { adminCopy, adminDateFormat, statusLabel } from '../../lib/admin-i18n';
import { filterAdminPosts, groupAdminStories, type AdminPostFilters } from '../../lib/posts';
import { requireInstalledOwner } from '../../server/auth/session';
import { categoriesByPostGroup } from '../../server/content/categories';
import { listPosts } from '../../server/content/posts';
import { getSiteSettings } from '../../server/content/settings';
import { HttpError } from '../../server/http/errors';
import { POST_LOCALES, type Post, type PostCategoryBadge, type PostLocale } from '../../types/cms';

let posts: Post[] = [];
let userEmail: string | null = null;
let errorKey: 'dashboardHidden' | 'dashboardUnavailable' | null = null;
let authRequired = false;
let settings = null;
let postCategories = new Map<string, PostCategoryBadge[]>();

try {
  settings = await getSiteSettings();
  const current = await requireInstalledOwner(Astro.request.headers);
  if (!settings || settings.owner_id !== current.user.id) {
    Astro.response.status = 404;
    errorKey = 'dashboardHidden';
  } else {
    userEmail = current.user.email;
    posts = await listPosts(current.user.id);
    // One query for the whole page; assignments hang off the translation group.
    postCategories = await categoriesByPostGroup(current.user.id, posts.map(({ translation_group_id }) => translation_group_id));
  }
} catch (error) {
  if (error instanceof HttpError && error.status === 401) {
    Astro.response.status = 401;
    authRequired = true;
  } else {
    console.error('Admin post query failed.');
    Astro.response.status = 500;
    errorKey = 'dashboardUnavailable';
  }
}

const adminPath = settings?.admin_path ?? '/admin';
const adminSettings = { admin_path: adminPath };

const ownerLocale = settings?.default_locale ?? null;
const copy = adminCopy(ownerLocale);
const errorMessage = errorKey ? copy.errors[errorKey] : null;
const dateFormatter = adminDateFormat(ownerLocale, settings?.timezone ?? 'UTC');
const status = ['draft', 'published', 'all'].includes(Astro.url.searchParams.get('status') ?? '')
  ? Astro.url.searchParams.get('status') as 'draft' | 'published' | 'all'
  : 'draft';
const locale = ['th', 'en', 'all'].includes(Astro.url.searchParams.get('locale') ?? '')
  ? Astro.url.searchParams.get('locale') as PostLocale | 'all'
  : 'all';
const query = (Astro.url.searchParams.get('q') ?? '').trim().slice(0, 100);
const filters: AdminPostFilters = { status, locale, query };
const stories = groupAdminStories(posts, filterAdminPosts(posts, filters), ownerLocale);
// The count is what the tab would show with the current language and search still
// applied -- and it counts stories, because stories are what the list renders. A
// total of editions would say three and then draw two cards.
const tabLabels = { draft: copy.status.drafts, published: copy.status.published, all: copy.status.all };
const tabs = (['draft', 'published', 'all'] as const).map((tabStatus) => ({
  status: tabStatus,
  label: tabLabels[tabStatus],
  count: groupAdminStories(posts, filterAdminPosts(posts, { ...filters, status: tabStatus }), ownerLocale).length,
}));
const Frame = authRequired || errorMessage ? 'main' : AdminShell;
---

<AdminLayout adminPath={adminPath} lang={ownerLocale ?? 'en'} title={authRequired ? copy.auth.signInTitle : copy.posts.heading}>
  {authRequired ? (
    <main class="admin-auth-page">
      <header class="admin-auth-nav" aria-label={copy.auth.adminSignIn}>
        <a class="admin-auth-brand" href="/" aria-label={copy.auth.tomecmsHome}>
          <img class="tomecms-logo" src="/brand/tomecms-logo-color.png" alt="TomeCMS" width="2172" height="724" />
        </a>
        <a class="admin-auth-nav__link" href="/">{copy.auth.viewSite} <span aria-hidden="true">↗</span></a>
      </header>

      <div class="admin-auth-stage">
        <section class="admin-auth-context" aria-labelledby="admin-auth-context-title">
          <div>
            <h2 id="admin-auth-context-title">{copy.auth.contextTitle}</h2>
            <p>{copy.auth.contextHint}</p>
          </div>
          <ul aria-label={copy.auth.toolsLabel}>
            <li><strong>{copy.auth.draftFirst}</strong><span>{copy.auth.draftFirstHint}</span></li>
            <li><strong>{copy.auth.bothLanguages}</strong><span>{copy.auth.bothLanguagesHint}</span></li>
            <li><strong>{copy.auth.oneLibrary}</strong><span>{copy.auth.oneLibraryHint}</span></li>
          </ul>
        </section>

        <section class="admin-auth-panel" aria-labelledby="admin-auth-title">
          <header>
            <h1 id="admin-auth-title">{copy.auth.welcome}</h1>
            <p>{copy.auth.welcomeHint}</p>
          </header>
          <PasskeySignIn adminPath={adminPath} ownerLocale={ownerLocale} client:only="react" returnTo={Astro.url.searchParams.get('returnTo')} />
        </section>
      </div>

      <footer class="admin-auth-footer">
        <span>TomeCMS</span>
        <span>{copy.auth.ownerAdministration}</span>
      </footer>
    </main>
  ) : (
  <Frame active="posts" adminPath={adminPath} locale={settings?.default_locale} siteName={settings?.site_name ?? 'TomeCMS'} userEmail={userEmail}>
  <section class="admin-page">
    <header class="admin-page__head">
      <div>
        <h1>{copy.posts.heading}</h1>
        <p>{copy.posts.subheading}</p>
      </div>
      {!authRequired && !errorMessage && (
        <div class="admin-page__actions">
          <a class="admin-button admin-button--secondary" href={adminHref(adminSettings, '/categories')}>{copy.posts.manageCategories}</a>
          <a class="admin-button admin-button--primary" href={adminHref(adminSettings, '/new')}>{copy.posts.newPost} <span aria-hidden="true">+</span></a>
        </div>
      )}
    </header>

    {errorMessage ? (
      <p class="admin-alert" role="alert">{errorMessage}</p>
    ) : (
      <div data-admin-posts data-edit-base={adminHref(adminSettings, '/edit')} data-timezone={settings?.timezone ?? 'UTC'} data-locale={ownerLocale} data-copy-draft={copy.status.draft} data-copy-published={copy.status.published} data-copy-published-at={copy.status.publishedAt} data-copy-updated-at={copy.status.updatedAt} data-copy-publish={copy.row.publish} data-copy-unpublish={copy.row.unpublish} data-copy-delete={copy.row.delete} data-copy-delete-prefix={copy.row.deletePrefix} data-copy-delete-title={copy.posts.deleteTitle} data-copy-delete-message={copy.posts.deleteMessage}>
        <nav class="admin-post-tabs" aria-label={copy.posts.statusLabel}>
          {tabs.map((tab) => (
            <a aria-current={status === tab.status ? "page" : undefined} href={adminHref(adminSettings, `?${new URLSearchParams({ status: tab.status, locale, q: query })}`)}>{tab.label} <span class="admin-tab-count">{tab.count}</span></a>
          ))}
        </nav>
        <form class="admin-post-filters admin-post-filters--compact" action={adminHref(adminSettings)} method="get" novalidate>
          <input type="hidden" name="status" value={status} />
          {query && <input type="hidden" name="q" value={query} />}
          <div class="admin-field">
            <label for="post-locale">{copy.filters.language}</label>
            <UiSelect
              client:load
              className="admin-control"
              defaultValue={locale}
              id="post-locale"
              name="locale"
              options={[
                { label: copy.filters.allLanguages, value: 'all' },
                { label: copy.filters.thai, value: 'th' },
                { label: copy.filters.english, value: 'en' },
              ]}
            />
          </div>
          <button class="admin-button" type="submit">{copy.filters.apply}</button>
        </form>
        <p class="admin-alert" data-post-error role="alert" hidden></p>
        <div class="admin-story-list admin-story-grid">
          {stories.map((story) => {
            const cover = story.editions.find(({ cover_image }) => cover_image)?.cover_image ?? null;
            const badges = postCategories.get(story.groupId) ?? [];
            const newest = story.editions.reduce((latest, edition) => edition.updated_at > latest.updated_at ? edition : latest);
            const timestamp = newest.status === 'published' ? newest.published_at ?? newest.updated_at : newest.updated_at;
            const missing = POST_LOCALES.filter((candidate) => !story.editions.some(({ locale: written }) => written === candidate));
            return (
              <article class="admin-story-row" aria-label={story.primary.title.trim() || copy.posts.untitled}>
                <div class="admin-story-cover" aria-hidden="true">
                  {cover ? <img src={cover} alt="" loading="lazy" /> : <span>✎</span>}
                </div>
                <div class="admin-story-content">
                  {badges.length > 0 && (
                    <ul class="admin-story-categories" aria-label={copy.drawer.categories}>
                      {badges.map((category) => <li>{category.name}</li>)}
                    </ul>
                  )}
                  {story.editions.map((edition, index) => {
                    const title = edition.title.trim() || copy.posts.untitled;
                    const label = `${title} (${edition.locale.toUpperCase()})`;
                    return (
                      <div class:list={['admin-story-edition', index === 0 && 'admin-story-edition--lead']}>
                        <a class="admin-story-edition__link" href={adminHref(adminSettings, `/edit/${edition.id}`)}>
                          <span class="admin-locale">{edition.locale.toUpperCase()}</span>
                          {index === 0
                            ? <h2 class="admin-story-edition__title">{title}</h2>
                            : <span class="admin-story-edition__title">{title}</span>}
                          <span class="admin-status" data-status={edition.status}>{statusLabel(copy, edition.status)}</span>
                        </a>
                        <details class="admin-story-menu">
                          <summary aria-label={`${copy.posts.actionsFor} ${label}`}><span aria-hidden="true">⋯</span></summary>
                          <div>
                            <a href={adminHref(adminSettings, `/edit/${edition.id}`)}>{copy.row.edit}</a>
                            <a href={adminPreviewHref(adminSettings, 'post', edition.id)} target="_blank" rel="noopener noreferrer">{copy.row.preview}</a>
                            <button type="button" data-post-action="duplicate" data-post-id={edition.id} data-post-updated-at={edition.updated_at}>{copy.row.duplicate}</button>
                            <button type="button" data-post-action={edition.status === 'draft' ? 'published' : 'draft'} data-post-id={edition.id} data-post-updated-at={edition.updated_at}>{edition.status === 'draft' ? copy.row.publish : copy.row.unpublish}</button>
                            <button type="button" data-post-action="delete" data-post-id={edition.id} data-post-updated-at={edition.updated_at} data-post-title={title} data-post-locale={edition.locale.toUpperCase()}>{copy.row.delete}</button>
                          </div>
                        </details>
                      </div>
                    );
                  })}
                  {missing.map((candidate) => (
                    <a class="admin-story-start" href={adminHref(adminSettings, `/new?${new URLSearchParams({ sourcePostId: story.primary.id, locale: candidate })}`)}>
                      <span class="admin-locale">{candidate.toUpperCase()}</span>
                      <span class="admin-story-edition__title">{copy.row.missing}</span>
                    </a>
                  ))}
                </div>
                <div class="admin-story-foot">
                  <span data-story-when><span data-story-verb>{newest.status === 'published' ? copy.status.publishedAt : copy.status.updatedAt}</span> <time datetime={timestamp}>{dateFormatter.format(new Date(timestamp))}</time> ({settings?.timezone ?? 'UTC'})</span>
                </div>
              </article>
            );
          })}
          {!stories.length && (
            <div class="admin-empty">
              <span class="admin-empty__mark" aria-hidden="true"><AdminIcon name="posts" /></span>
              <div><h2>{posts.length ? copy.posts.noMatchTitle : copy.posts.emptyTitle}</h2><p>{posts.length ? copy.posts.noMatchBody : copy.posts.emptyBody}</p></div>
              {!posts.length && <a class="admin-button admin-button--secondary" href={adminHref(adminSettings, '/new')}>{copy.posts.createFirst}</a>}
            </div>
          )}
        </div>
      </div>
    )}
  </section>
  </Frame>
  )}
</AdminLayout>

<script>
  import wireStoryList from '../../lib/admin-story-list';
  import { confirmUi } from '../../lib/ui-dialog';

  const copy = (document.querySelector<HTMLElement>('[data-admin-posts]') ?? document.createElement('div')).dataset;

  wireStoryList({
    endpoint: '/api/admin/posts',
    entity: 'post',
    confirm: async (action, row) => action !== 'delete' || confirmUi({
      title: copy.copyDeleteTitle ?? 'Delete post?',
      message: `${copy.copyDeletePrefix} “${row.postTitle}” (${row.postLocale})? ${copy.copyDeleteMessage}`,
      confirmLabel: copy.copyDelete ?? 'Delete',
      tone: 'danger',
    }),
  });
</script>
