---
import AdminLayout from '../../layouts/AdminLayout.astro';
import AdminShell from '../../components/admin/AdminShell.astro';
import PasskeySignIn from '../../components/admin/PasskeySignIn';
import UiSelect from '../../components/admin/UiSelect';
import { adminHref } from '../../lib/admin';
import { filterAdminPosts, readingMinutes, type AdminPostFilters } from '../../lib/posts';
import { requireInstalledOwner } from '../../server/auth/session';
import { listPosts } from '../../server/content/posts';
import { getSiteSettings } from '../../server/content/settings';
import { HttpError } from '../../server/http/errors';
import type { Post, PostLocale } from '../../types/cms';

let posts: Post[] = [];
let userEmail: string | null = null;
let errorMessage: string | null = null;
let authRequired = false;
let settings = null;

try {
  settings = await getSiteSettings();
  const current = await requireInstalledOwner(Astro.request.headers);
  if (!settings || settings.owner_id !== current.user.id) {
    Astro.response.status = 404;
    errorMessage = 'The dashboard is unavailable.';
  } else {
    userEmail = current.user.email;
    posts = await listPosts(current.user.id);
  }
} catch (error) {
  if (error instanceof HttpError && error.status === 401) {
    Astro.response.status = 401;
    authRequired = true;
  } else {
    console.error('Admin post query failed.');
    Astro.response.status = 500;
    errorMessage = 'The dashboard is temporarily unavailable.';
  }
}

const adminPath = settings?.admin_path ?? '/admin';
const adminSettings = { admin_path: adminPath };

const dateFormatter = new Intl.DateTimeFormat('en', {
  dateStyle: 'medium',
  timeStyle: 'short',
  timeZone: settings?.timezone ?? 'UTC',
});
const status = ['draft', 'published', 'all'].includes(Astro.url.searchParams.get('status') ?? '')
  ? Astro.url.searchParams.get('status') as 'draft' | 'published' | 'all'
  : 'draft';
const locale = ['th', 'en', 'all'].includes(Astro.url.searchParams.get('locale') ?? '')
  ? Astro.url.searchParams.get('locale') as PostLocale | 'all'
  : 'all';
const query = (Astro.url.searchParams.get('q') ?? '').trim().slice(0, 100);
const filters: AdminPostFilters = { status, locale, query };
const filteredPosts = filterAdminPosts(posts, filters);
const editions = new Map<string, Post[]>();
for (const post of posts) {
  const group = editions.get(post.translation_group_id) ?? [];
  group.push(post);
  editions.set(post.translation_group_id, group);
}
const tabs = [{ status: 'draft', label: 'Drafts' }, { status: 'published', label: 'Published' }, { status: 'all', label: 'All' }];
const Frame = authRequired || errorMessage ? 'main' : AdminShell;
---

<AdminLayout adminPath={adminPath} title={authRequired ? 'Sign in' : 'Posts'}>
  {authRequired ? (
    <main class="admin-auth-page">
      <header class="admin-auth-nav" aria-label="Admin sign in">
        <a class="admin-auth-brand" href="/" aria-label="TomeCMS home">
          <img class="tomecms-logo" src="/brand/tomecms-logo.png" alt="TomeCMS" width="2172" height="724" />
        </a>
        <a class="admin-auth-nav__link" href="/">View site <span aria-hidden="true">↗</span></a>
      </header>

      <div class="admin-auth-stage">
        <section class="admin-auth-context" aria-labelledby="admin-auth-context-title">
          <div>
            <h2 id="admin-auth-context-title">Write, preview, publish.</h2>
            <p>Manage the work behind your site from one focused workspace.</p>
          </div>
          <ul aria-label="Admin workspace tools">
            <li><strong>Draft first</strong><span>Preview every post before it goes live.</span></li>
            <li><strong>Thai and English</strong><span>Keep both language editions together.</span></li>
            <li><strong>One File Manager</strong><span>Organize images where you write.</span></li>
          </ul>
        </section>

        <section class="admin-auth-panel" aria-labelledby="admin-auth-title">
          <header>
            <h1 id="admin-auth-title">Welcome back</h1>
            <p>Sign in with the owner account created during setup.</p>
          </header>
          <PasskeySignIn adminPath={adminPath} client:only="react" returnTo={Astro.url.searchParams.get('returnTo')} />
        </section>
      </div>

      <footer class="admin-auth-footer">
        <span>TomeCMS</span>
        <span>Owner administration</span>
      </footer>
    </main>
  ) : (
  <Frame active="posts" adminPath={adminPath} siteName={settings?.site_name ?? 'TomeCMS'} userEmail={userEmail}>
  <section class="admin-page">
    <header class="admin-page__head">
      <div>
        <h1>Posts</h1>
        <p>Draft, publish, and keep your writing in one place.</p>
      </div>
      {!authRequired && !errorMessage && (
        <div class="admin-page__actions">
          <a class="admin-button admin-button--secondary" href={adminHref(adminSettings, '/categories')}>Manage categories</a>
          <a class="admin-button admin-button--primary" href={adminHref(adminSettings, '/new')}>New post <span aria-hidden="true">+</span></a>
        </div>
      )}
    </header>

    {errorMessage ? (
      <p class="admin-alert" role="alert">{errorMessage}</p>
    ) : (
      <div data-admin-posts>
        <nav class="admin-post-tabs" role="tablist" aria-label="Post status">
          {tabs.map((tab) => (
            <a role="tab" aria-selected={status === tab.status} href={adminHref(adminSettings, `?${new URLSearchParams({ status: tab.status, locale, q: query })}`)}>{tab.label}</a>
          ))}
        </nav>
        <form class="admin-post-filters" action={adminHref(adminSettings)} method="get" novalidate>
          <input type="hidden" name="status" value={status} />
          <div class="admin-field">
            <label for="post-search">Search posts</label>
            <input class="admin-control" id="post-search" name="q" type="search" maxlength="100" value={query} placeholder="Search by title" />
          </div>
          <div class="admin-field">
            <label for="post-locale">Language</label>
            <UiSelect
              client:load
              className="admin-control"
              defaultValue={locale}
              id="post-locale"
              name="locale"
              options={[
                { label: 'All languages', value: 'all' },
                { label: 'Thai', value: 'th' },
                { label: 'English', value: 'en' },
              ]}
            />
          </div>
          <button class="admin-button" type="submit">Apply filters</button>
        </form>
        <p class="admin-alert" data-post-error role="alert" hidden></p>
        <div class="admin-story-list">
          {filteredPosts.map((post) => {
            const title = post.title.trim() || 'Untitled post';
            const sibling = editions.get(post.translation_group_id)?.find((edition) => edition.locale !== post.locale);
            const timestamp = post.status === 'published' ? post.published_at ?? post.updated_at : post.updated_at;
            return (
              <article class="admin-story-row" aria-label={`${title} (${post.locale.toUpperCase()})`}>
                <div class="admin-story-cover" aria-hidden="true">
                  {post.cover_image ? <img src={post.cover_image} alt="" loading="lazy" /> : <span>✎</span>}
                </div>
                <div class="admin-story-content">
                  <h2><a href={adminHref(adminSettings, `/edit/${post.id}`)}>{title}</a></h2>
                  <div class="admin-story-meta">
                    <span class="admin-locale">{post.locale.toUpperCase()}</span>
                    <span>{readingMinutes(post.content_json)} min read</span>
                    <span class="admin-status" data-status={post.status}>{post.status}</span>
                    <span>{post.status === 'published' ? 'Published' : 'Updated'} <time datetime={timestamp}>{dateFormatter.format(new Date(timestamp))}</time> ({settings?.timezone ?? 'UTC'})</span>
                  </div>
                  <p class="admin-story-sibling">
                    {sibling ? <a href={adminHref(adminSettings, `/edit/${sibling.id}`)}>{sibling.locale.toUpperCase()} {sibling.status}</a> : <a href={adminHref(adminSettings, `/new?${new URLSearchParams({ sourcePostId: post.id, locale: post.locale === 'th' ? 'en' : 'th' })}`)}>{post.locale === 'th' ? 'EN' : 'TH'} missing</a>}
                  </p>
                </div>
                <details class="admin-story-menu">
                  <summary aria-label={`Actions for ${title} (${post.locale.toUpperCase()})`}><span aria-hidden="true">⋯</span></summary>
                  <div>
                    <a href={adminHref(adminSettings, `/edit/${post.id}`)}>Edit</a>
                    <a href={adminHref(adminSettings, `/preview/${post.id}`)} target="_blank" rel="noopener noreferrer">Preview</a>
                    <button type="button" data-post-action={post.status === 'draft' ? 'published' : 'draft'} data-post-id={post.id} data-post-updated-at={post.updated_at}>{post.status === 'draft' ? 'Publish' : 'Unpublish'}</button>
                    <button type="button" data-post-action="delete" data-post-id={post.id} data-post-updated-at={post.updated_at} data-post-title={title} data-post-locale={post.locale.toUpperCase()}>Delete</button>
                  </div>
                </details>
              </article>
            );
          })}
          {!filteredPosts.length && (
            <div class="admin-empty">
              <span class="admin-empty__mark" aria-hidden="true">+</span>
              <div><h2>{posts.length ? 'No posts match these filters.' : 'Your first post starts here'}</h2><p>{posts.length ? 'Try another title, language, or status.' : 'Create a draft now and publish whenever it is ready.'}</p></div>
              {!posts.length && <a class="admin-button admin-button--secondary" href={adminHref(adminSettings, '/new')}>Create first post</a>}
            </div>
          )}
        </div>
      </div>
    )}
  </section>
  </Frame>
  )}
</AdminLayout>

<script>
  import { confirmUi } from '../../lib/ui-dialog';

  const postsContainer = document.querySelector<HTMLElement>('[data-admin-posts]');
  const postError = postsContainer?.querySelector<HTMLElement>('[data-post-error]');
  postsContainer?.addEventListener('click', async (event) => {
    const button = event.target instanceof Element ? event.target.closest<HTMLButtonElement>('button[data-post-action]') : null;
    if (!button || button.disabled) return;
    const { postAction: action, postId: id, postUpdatedAt: updatedAt } = button.dataset;
    if (!id || !action || !updatedAt) return;
    if (action === 'delete') {
      const confirmed = await confirmUi({
        title: 'Delete post?',
        message: `Delete “${button.dataset.postTitle}” (${button.dataset.postLocale})? Only this language edition will be deleted. This cannot be undone.`,
        confirmLabel: 'Delete',
        tone: 'danger',
      });
      if (!confirmed) return;
    }
    button.disabled = true;
    try {
      const response = action === 'delete'
        ? await fetch('/api/admin/posts', {
            method: 'DELETE',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ id, updatedAt }),
          })
        : await fetch('/api/admin/posts', {
            method: 'PATCH',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ id, status: action, updatedAt }),
          });
      if (!response.ok) {
        const body = await response.json().catch(() => null);
        throw new Error(body?.error || 'The action could not be completed. Please try again.');
      }
      window.location.reload();
    } catch (error) {
      if (postError) {
        postError.textContent = error instanceof Error ? error.message : 'The action could not be completed. Please try again.';
        postError.hidden = false;
      }
      button.disabled = false;
    }
  });

</script>
