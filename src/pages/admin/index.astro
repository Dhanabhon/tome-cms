---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { authenticate } from '../../lib/supabase';
import type { Post } from '../../types/cms';

let posts: Post[] = [];
let userEmail: string | null = null;
let errorMessage: string | null = null;
let authRequired = false;

try {
  const auth = await authenticate(Astro.cookies, Astro.request);
  if (!auth) {
    Astro.response.status = 401;
    authRequired = true;
  } else {
    userEmail = auth.user.email ?? null;
    const { data, error } = await auth.supabase
      .from('posts')
      .select('*')
      .eq('author_id', auth.user.id)
      .order('updated_at', { ascending: false });

    if (error) throw error;
    posts = data;
  }
} catch (error) {
  console.error('Admin post query failed:', error);
  Astro.response.status = 500;
  errorMessage = 'The dashboard is temporarily unavailable.';
}

const dateFormatter = new Intl.DateTimeFormat('en', {
  dateStyle: 'medium',
  timeStyle: 'short',
});
const publishedCount = posts.filter((post) => post.status === 'published').length;
const draftCount = posts.length - publishedCount;
---

<AdminLayout title="Posts" userEmail={userEmail}>
  <section class="admin-page">
    <header class="admin-page__head">
      <div>
        <h1>Posts</h1>
        <p>Draft, publish, and keep your writing in one place.</p>
      </div>
      {!authRequired && !errorMessage && (
        <a class="admin-button admin-button--primary" href="/admin/new">New post <span aria-hidden="true">+</span></a>
      )}
    </header>

    {authRequired ? (
      <div class="admin-auth">
        <div class="admin-auth__intro">
          <h2>Welcome back</h2>
          <p>Sign in with the owner account you created during setup.</p>
        </div>
        <form class="admin-auth__form" data-auth-form>
          <label class="admin-field">
            <span>Email address</span>
            <input class="admin-control" name="email" required type="email" autocomplete="email" />
          </label>
          <label class="admin-field">
            <span>Password</span>
            <input class="admin-control" name="password" required type="password" autocomplete="current-password" />
          </label>
          <p class="admin-form-error" data-auth-error role="alert"></p>
          <button class="admin-button admin-button--primary" type="submit">Sign in</button>
        </form>
      </div>
    ) : errorMessage ? (
      <p class="admin-alert" role="alert">{errorMessage}</p>
    ) : (
      <>
        <div class="admin-summary" aria-label="Post summary">
          <p><strong>{posts.length}</strong><span>Total</span></p>
          <p><strong>{draftCount}</strong><span>Drafts</span></p>
          <p><strong>{publishedCount}</strong><span>Published</span></p>
        </div>
        <div class="admin-posts">
          <div class="admin-posts__head" aria-hidden="true">
            <span>Post</span>
            <span>Status</span>
            <span>Last updated</span>
          </div>
          {posts.map((post) => (
            <a class="admin-post-row" href={`/admin/edit/${post.id}`}>
              <span class="admin-post-row__title"><strong>{post.title}</strong><small>/{post.slug}</small></span>
              <span class="admin-status" data-status={post.status}>{post.status}</span>
              <time datetime={post.updated_at}>{dateFormatter.format(new Date(post.updated_at))}</time>
              <span class="admin-post-row__arrow" aria-hidden="true">→</span>
            </a>
          ))}
          {!posts.length && (
            <div class="admin-empty">
              <span class="admin-empty__mark" aria-hidden="true">+</span>
              <div><h2>Your first post starts here</h2><p>Create a draft now and publish whenever it is ready.</p></div>
              <a class="admin-button admin-button--secondary" href="/admin/new">Create first post</a>
            </div>
          )}
        </div>
      </>
    )}
  </section>
</AdminLayout>

<script>
  import { createBrowserSupabaseClient } from '../../lib/supabase';

  const form = document.querySelector<HTMLFormElement>('[data-auth-form]');
  const errorElement = document.querySelector<HTMLElement>('[data-auth-error]');

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const formData = new FormData(form);
    const email = formData.get('email');
    const password = formData.get('password');
    if (typeof email !== 'string' || typeof password !== 'string') return;

    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (button) button.disabled = true;
    if (errorElement) errorElement.textContent = '';

    try {
      const { error } = await createBrowserSupabaseClient().auth.signInWithPassword({ email, password });
      if (error) throw error;
      window.location.reload();
    } catch (error) {
      if (errorElement) errorElement.textContent = error instanceof Error ? error.message : 'Sign in failed.';
      if (button) button.disabled = false;
    }
  });
</script>
