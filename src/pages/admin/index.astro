---
import AdminLayout from '../../layouts/AdminLayout.astro';
import AdminShell from '../../components/admin/AdminShell.astro';
import { getSiteSettings } from '../../lib/installation';
import { authenticate } from '../../lib/supabase';
import { filterAdminPosts, readingMinutes, type AdminPostFilters } from '../../lib/posts';
import type { Post, PostLocale } from '../../types/cms';

let posts: Post[] = [];
let userEmail: string | null = null;
let errorMessage: string | null = null;
let authRequired = false;
let settings = null;

try {
  const auth = await authenticate(Astro.cookies, Astro.request);
  if (!auth) {
    Astro.response.status = 401;
    authRequired = true;
  } else {
    userEmail = auth.user.email ?? null;
    settings = await getSiteSettings();
    const { data, error } = await auth.supabase
      .from('posts')
      .select('*')
      .eq('author_id', auth.user.id)
      .order('updated_at', { ascending: false });

    if (error) throw error;
    posts = data;
  }
} catch (error) {
  console.error('Admin post query failed:', error);
  Astro.response.status = 500;
  errorMessage = 'The dashboard is temporarily unavailable.';
}

const dateFormatter = new Intl.DateTimeFormat('en', {
  dateStyle: 'medium',
  timeStyle: 'short',
  timeZone: settings?.timezone ?? 'UTC',
});
const status = ['draft', 'published', 'all'].includes(Astro.url.searchParams.get('status') ?? '')
  ? Astro.url.searchParams.get('status') as 'draft' | 'published' | 'all'
  : 'draft';
const locale = ['th', 'en', 'all'].includes(Astro.url.searchParams.get('locale') ?? '')
  ? Astro.url.searchParams.get('locale') as PostLocale | 'all'
  : 'all';
const query = (Astro.url.searchParams.get('q') ?? '').trim().slice(0, 100);
const filters: AdminPostFilters = { status, locale, query };
const filteredPosts = filterAdminPosts(posts, filters);
const editions = new Map<string, Post[]>();
for (const post of posts) {
  const group = editions.get(post.translation_group_id) ?? [];
  group.push(post);
  editions.set(post.translation_group_id, group);
}
const tabs = [{ status: 'draft', label: 'Drafts' }, { status: 'published', label: 'Published' }, { status: 'all', label: 'All' }];
const Frame = authRequired || errorMessage ? 'main' : AdminShell;
---

<AdminLayout title="Posts">
  <Frame active="posts" siteName={settings?.site_name ?? 'TomeCMS'} userEmail={userEmail}>
  <section class="admin-page">
    <header class="admin-page__head">
      <div>
        <h1>Posts</h1>
        <p>Draft, publish, and keep your writing in one place.</p>
      </div>
      {!authRequired && !errorMessage && (
        <a class="admin-button admin-button--primary" href="/admin/new">New post <span aria-hidden="true">+</span></a>
      )}
    </header>

    {authRequired ? (
      <div class="admin-auth">
        <div class="admin-auth__intro">
          <h2>Welcome back</h2>
          <p>Sign in with the owner account you created during setup.</p>
        </div>
        <form class="admin-auth__form" data-auth-form novalidate>
          <div class="admin-field">
            <label for="admin-email">Email address</label>
            <input class="admin-control" id="admin-email" name="email" required type="email" autocomplete="email" aria-describedby="admin-email-error" />
            <p class="admin-field-error" id="admin-email-error" data-auth-email-error aria-live="polite"></p>
          </div>
          <div class="admin-field">
            <label for="admin-password">Password</label>
            <input class="admin-control" id="admin-password" name="password" required type="password" autocomplete="current-password" aria-describedby="admin-password-error" />
            <p class="admin-field-error" id="admin-password-error" data-auth-password-error aria-live="polite"></p>
          </div>
          <p class="admin-form-error" data-auth-error role="alert"></p>
          <button class="admin-button admin-button--primary" type="submit">Sign in</button>
        </form>
      </div>
    ) : errorMessage ? (
      <p class="admin-alert" role="alert">{errorMessage}</p>
    ) : (
      <div data-admin-posts>
        <nav class="admin-post-tabs" role="tablist" aria-label="Post status">
          {tabs.map((tab) => (
            <a role="tab" aria-selected={status === tab.status} href={`/admin?${new URLSearchParams({ status: tab.status, locale, q: query })}`}>{tab.label}</a>
          ))}
        </nav>
        <form class="admin-post-filters" action="/admin" method="get">
          <input type="hidden" name="status" value={status} />
          <div class="admin-field">
            <label for="post-search">Search posts</label>
            <input class="admin-control" id="post-search" name="q" type="search" maxlength="100" value={query} placeholder="Search by title" />
          </div>
          <div class="admin-field">
            <label for="post-locale">Language</label>
            <select class="admin-control" id="post-locale" name="locale">
              <option value="all" selected={locale === 'all'}>All languages</option>
              <option value="th" selected={locale === 'th'}>Thai</option>
              <option value="en" selected={locale === 'en'}>English</option>
            </select>
          </div>
          <button class="admin-button" type="submit">Apply filters</button>
        </form>
        <p class="admin-alert" data-post-error role="alert" hidden></p>
        <div class="admin-story-list">
          {filteredPosts.map((post) => {
            const title = post.title.trim() || 'Untitled post';
            const sibling = editions.get(post.translation_group_id)?.find((edition) => edition.locale !== post.locale);
            const timestamp = post.status === 'published' ? post.published_at ?? post.updated_at : post.updated_at;
            return (
              <article class="admin-story-row" aria-label={`${title} (${post.locale.toUpperCase()})`}>
                <div class="admin-story-cover" aria-hidden="true">
                  {post.cover_image ? <img src={post.cover_image} alt="" loading="lazy" /> : <span>✎</span>}
                </div>
                <div class="admin-story-content">
                  <h2><a href={`/admin/edit/${post.id}`}>{title}</a></h2>
                  <div class="admin-story-meta">
                    <span class="admin-locale">{post.locale.toUpperCase()}</span>
                    <span>{readingMinutes(post.content_json)} min read</span>
                    <span class="admin-status" data-status={post.status}>{post.status}</span>
                    <span>{post.status === 'published' ? 'Published' : 'Updated'} <time datetime={timestamp}>{dateFormatter.format(new Date(timestamp))}</time> ({settings?.timezone ?? 'UTC'})</span>
                  </div>
                  <p class="admin-story-sibling">
                    {sibling ? <a href={`/admin/edit/${sibling.id}`}>{sibling.locale.toUpperCase()} {sibling.status}</a> : <a href={`/admin/new?${new URLSearchParams({ sourcePostId: post.id, locale: post.locale === 'th' ? 'en' : 'th' })}`}>{post.locale === 'th' ? 'EN' : 'TH'} missing</a>}
                  </p>
                </div>
                <details class="admin-story-menu">
                  <summary aria-label={`Actions for ${title} (${post.locale.toUpperCase()})`}><span aria-hidden="true">⋯</span></summary>
                  <div>
                    <a href={`/admin/edit/${post.id}`}>Edit</a>
                    <a href={`/admin/preview/${post.id}`} target="_blank" rel="noopener noreferrer">Preview</a>
                    <button type="button" data-post-action={post.status === 'draft' ? 'published' : 'draft'} data-post-id={post.id}>{post.status === 'draft' ? 'Publish' : 'Unpublish'}</button>
                    <button type="button" data-post-action="delete" data-post-id={post.id} data-post-title={title} data-post-locale={post.locale.toUpperCase()}>Delete</button>
                  </div>
                </details>
              </article>
            );
          })}
          {!filteredPosts.length && (
            <div class="admin-empty">
              <span class="admin-empty__mark" aria-hidden="true">+</span>
              <div><h2>{posts.length ? 'No posts match these filters.' : 'Your first post starts here'}</h2><p>{posts.length ? 'Try another title, language, or status.' : 'Create a draft now and publish whenever it is ready.'}</p></div>
              {!posts.length && <a class="admin-button admin-button--secondary" href="/admin/new">Create first post</a>}
            </div>
          )}
        </div>
      </div>
    )}
  </section>
  </Frame>
</AdminLayout>

<script>
  import { createBrowserSupabaseClient } from '../../lib/supabase';
  import { safeAdminReturnTo } from '../../lib/admin';

  const postsContainer = document.querySelector<HTMLElement>('[data-admin-posts]');
  const postError = postsContainer?.querySelector<HTMLElement>('[data-post-error]');
  postsContainer?.addEventListener('click', async (event) => {
    const button = event.target instanceof Element ? event.target.closest<HTMLButtonElement>('button[data-post-action]') : null;
    if (!button || button.disabled) return;
    const { postAction: action, postId: id } = button.dataset;
    if (!id || !action) return;
    if (action === 'delete' && !window.confirm(`Delete “${button.dataset.postTitle}” (${button.dataset.postLocale})? Only this language edition will be deleted. This cannot be undone.`)) return;
    button.disabled = true;
    try {
      const response = action === 'delete'
        ? await fetch(`/api/posts?id=${encodeURIComponent(id)}`, { method: 'DELETE' })
        : await fetch('/api/posts', {
            method: 'PATCH',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ id, status: action }),
          });
      if (!response.ok) {
        const body = await response.json().catch(() => null);
        throw new Error(body?.error || 'The action could not be completed. Please try again.');
      }
      window.location.reload();
    } catch (error) {
      if (postError) {
        postError.textContent = error instanceof Error ? error.message : 'The action could not be completed. Please try again.';
        postError.hidden = false;
      }
      button.disabled = false;
    }
  });

  const form = document.querySelector<HTMLFormElement>('[data-auth-form]');
  const errorElement = document.querySelector<HTMLElement>('[data-auth-error]');
  const emailInput = form?.querySelector<HTMLInputElement>('[name="email"]');
  const passwordInput = form?.querySelector<HTMLInputElement>('[name="password"]');
  const emailError = document.querySelector<HTMLElement>('[data-auth-email-error]');
  const passwordError = document.querySelector<HTMLElement>('[data-auth-password-error]');

  function setFieldError(input: HTMLInputElement, element: HTMLElement | null, message = '') {
    if (message) input.setAttribute('aria-invalid', 'true');
    else input.removeAttribute('aria-invalid');
    if (element) element.textContent = message;
  }

  form?.addEventListener('input', (event) => {
    if (emailInput && event.target === emailInput) setFieldError(emailInput, emailError);
    if (passwordInput && event.target === passwordInput) setFieldError(passwordInput, passwordError);
    if (errorElement) errorElement.textContent = '';
  });

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!emailInput || !passwordInput) return;

    setFieldError(emailInput, emailError);
    setFieldError(passwordInput, passwordError);
    if (emailInput.validity.valueMissing) setFieldError(emailInput, emailError, 'Enter your email address.');
    else if (emailInput.validity.typeMismatch) setFieldError(emailInput, emailError, 'Enter a valid email address.');
    if (passwordInput.validity.valueMissing) setFieldError(passwordInput, passwordError, 'Enter your password.');

    const firstInvalid = form.querySelector<HTMLInputElement>('[aria-invalid="true"]');
    if (firstInvalid) {
      firstInvalid.focus();
      return;
    }

    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (button) button.disabled = true;
    if (errorElement) errorElement.textContent = '';

    try {
      const { error } = await createBrowserSupabaseClient().auth.signInWithPassword({
        email: emailInput.value,
        password: passwordInput.value,
      });
      if (error) throw error;
      const returnTo = new URLSearchParams(window.location.search).get('returnTo')
        ?? `${window.location.pathname}${window.location.search}`;
      window.location.assign(safeAdminReturnTo(returnTo));
    } catch (error) {
      const message = error instanceof Error && 'code' in error && error.code === 'invalid_credentials'
        ? 'Email or password is incorrect.'
        : 'Unable to sign in. Please try again.';
      if (errorElement) errorElement.textContent = message;
      if (button) button.disabled = false;
    }
  });
</script>
