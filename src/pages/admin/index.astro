---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { authenticate } from '../../lib/supabase';
import type { Post } from '../../types/cms';

let posts: Post[] = [];
let userEmail: string | null = null;
let errorMessage: string | null = null;
let authRequired = false;

try {
  const auth = await authenticate(Astro.cookies, Astro.request);
  if (!auth) {
    Astro.response.status = 401;
    authRequired = true;
  } else {
    userEmail = auth.user.email ?? null;
    const { data, error } = await auth.supabase
      .from('posts')
      .select('*')
      .eq('author_id', auth.user.id)
      .order('updated_at', { ascending: false });

    if (error) throw error;
    posts = data;
  }
} catch (error) {
  console.error('Admin post query failed:', error);
  Astro.response.status = 500;
  errorMessage = 'The dashboard is temporarily unavailable.';
}

const dateFormatter = new Intl.DateTimeFormat('en', {
  dateStyle: 'medium',
  timeStyle: 'short',
});
---

<AdminLayout title="Posts" userEmail={userEmail}>
  <section class="mx-auto max-w-7xl px-5 py-12 sm:px-8 sm:py-16">
    <div class="flex items-center justify-between gap-6">
      <h1 class="font-display text-5xl font-semibold tracking-tight sm:text-6xl">Posts</h1>
      {!authRequired && !errorMessage && (
        <a class="rounded-md bg-accent px-5 py-3 text-sm font-medium text-white hover:bg-blue-800" href="/admin/new">New post</a>
      )}
    </div>

    {authRequired ? (
      <form class="mt-12 max-w-md space-y-5 border-t border-line pt-8" data-auth-form>
        <div>
          <h2 class="font-display text-3xl font-semibold">Sign in</h2>
          <p class="mt-2 text-sm leading-6 text-muted">Use an existing Supabase email and password account.</p>
        </div>
        <label class="block">
          <span class="mb-2 block text-sm font-medium">Email</span>
          <input class="w-full rounded-md border border-line px-3 py-2" name="email" required type="email" autocomplete="email" />
        </label>
        <label class="block">
          <span class="mb-2 block text-sm font-medium">Password</span>
          <input class="w-full rounded-md border border-line px-3 py-2" name="password" required type="password" autocomplete="current-password" />
        </label>
        <p class="text-sm text-red-700" data-auth-error role="alert"></p>
        <button class="rounded-md bg-accent px-5 py-2.5 text-sm font-medium text-white hover:bg-blue-800" type="submit">Sign in</button>
      </form>
    ) : errorMessage ? (
      <p class="mt-12 border-l-2 border-accent pl-4 text-muted" role="alert">{errorMessage}</p>
    ) : (
      <div class="mt-10 border-t border-line">
        <div class="hidden grid-cols-[1fr_10rem_14rem] border-b border-line px-5 py-4 text-xs font-semibold uppercase tracking-[0.1em] text-muted sm:grid">
          <span>Title</span>
          <span>Status</span>
          <span>Updated</span>
        </div>
        {posts.map((post) => (
          <a
            class="group grid gap-2 border-b border-line px-1 py-6 transition-colors hover:border-l-2 hover:border-l-accent hover:bg-soft hover:pl-5 sm:grid-cols-[1fr_10rem_14rem] sm:items-center sm:px-5"
            href={`/admin/edit/${post.id}`}
          >
            <span class="font-display text-2xl font-medium group-hover:text-accent">{post.title}</span>
            <span class="text-sm capitalize text-muted">{post.status}</span>
            <time class="text-sm text-muted" datetime={post.updated_at}>{dateFormatter.format(new Date(post.updated_at))}</time>
          </a>
        ))}
        {!posts.length && <p class="border-b border-line py-12 text-center text-muted">No posts yet. Start with a new one.</p>}
      </div>
    )}
  </section>
</AdminLayout>

<script>
  import { createBrowserSupabaseClient } from '../../lib/supabase';

  const form = document.querySelector<HTMLFormElement>('[data-auth-form]');
  const errorElement = document.querySelector<HTMLElement>('[data-auth-error]');

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const formData = new FormData(form);
    const email = formData.get('email');
    const password = formData.get('password');
    if (typeof email !== 'string' || typeof password !== 'string') return;

    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (button) button.disabled = true;
    if (errorElement) errorElement.textContent = '';

    try {
      const { error } = await createBrowserSupabaseClient().auth.signInWithPassword({ email, password });
      if (error) throw error;
      window.location.reload();
    } catch (error) {
      if (errorElement) errorElement.textContent = error instanceof Error ? error.message : 'Sign in failed.';
      if (button) button.disabled = false;
    }
  });
</script>
