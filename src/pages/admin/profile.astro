---
import AdminShell from '../../components/admin/AdminShell.astro';
import ProfileForm from '../../components/admin/ProfileForm';
import AdminLayout from '../../layouts/AdminLayout.astro';
import { adminLoginPath } from '../../lib/admin';
import { getSiteSettingsForOwner } from '../../lib/installation';
import { authenticate } from '../../lib/supabase';
import type { MediaAsset, SiteSettings } from '../../types/cms';

let settings: SiteSettings | null = null;
let avatar: MediaAsset | null = null;
let userEmail: string | null = null;
let errorMessage = '';
try {
  const auth = await authenticate(Astro.cookies, Astro.request);
  if (!auth) {
    Astro.response.status = 302;
    Astro.response.headers.set('Location', adminLoginPath(Astro.url.pathname + Astro.url.search));
  } else {
    settings = await getSiteSettingsForOwner(auth.user.id);
    if (!settings) {
      Astro.response.status = 404;
      errorMessage = 'Profile not found.';
    } else {
      userEmail = auth.user.email ?? null;
      if (settings.author_avatar_media_id) {
        const { data, error } = await auth.supabase.from('media_items').select('*')
          .eq('id', settings.author_avatar_media_id).eq('owner_id', auth.user.id).maybeSingle();
        if (error) throw error;
        if (data) avatar = { ...data, publicUrl: auth.supabase.storage.from('blog-media').getPublicUrl(data.storage_path).data.publicUrl };
      }
    }
  }
} catch (error) {
  console.error('Profile query failed:', error);
  Astro.response.status = 500;
  errorMessage = 'The profile is temporarily unavailable.';
}
---

<AdminLayout title="Profile">
  {errorMessage || !settings ? <main><p class="admin-alert admin-alert--page" role="alert">{errorMessage}</p></main> : (
    <AdminShell active="profile" siteName={settings.site_name} userEmail={userEmail}>
      <section class="admin-page admin-form-page">
        <header class="admin-page__head"><div><h1>Profile</h1><p>Your name, avatar, and author biography.</p></div></header>
        <ProfileForm client:load initialSettings={settings} initialAvatar={avatar} />
      </section>
    </AdminShell>
  )}
</AdminLayout>
