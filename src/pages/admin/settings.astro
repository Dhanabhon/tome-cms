---
import AdminShell from '../../components/admin/AdminShell.astro';
import SettingsForm from '../../components/admin/SettingsForm';
import AdminLayout from '../../layouts/AdminLayout.astro';
import { adminCopy } from '../../lib/admin-i18n';
import { adminLoginPath } from '../../lib/admin';
import { editableBrand } from '../../lib/site-brand';
import { requireOwner } from '../../server/auth/session';
import { getOwnerSettings, type SiteSettings } from '../../server/content/settings';
import { HttpError } from '../../server/http/errors';
import { resolveMediaUrl } from '../../server/media/url';

let settings: SiteSettings | null = null;
let userEmail: string | null = null;
let errorMessage = '';
try {
  const current = await requireOwner(Astro.request.headers);
  settings = await getOwnerSettings(current.user.id);
  if (!settings) {
    Astro.response.status = 404;
    errorMessage = 'Site settings not found.';
  } else {
    userEmail = current.user.email;
  }
} catch (error) {
  if (error instanceof HttpError && error.status === 401) {
    Astro.response.status = 302;
    Astro.response.headers.set('Location', adminLoginPath(Astro.url.pathname + Astro.url.search));
  } else if (error instanceof HttpError && error.status === 403) {
    Astro.response.status = 404;
    errorMessage = 'Site settings not found.';
  } else {
    console.error('Settings page query failed.');
    Astro.response.status = 500;
    errorMessage = 'The settings are temporarily unavailable.';
  }
}

const ownerLocale = settings?.default_locale ?? null;
const copy = adminCopy(ownerLocale);
---

<AdminLayout lang={ownerLocale ?? 'en'} title={copy.settings.heading}>
  {errorMessage || !settings ? <main><p class="admin-alert admin-alert--page" role="alert">{errorMessage}</p></main> : (
    <AdminShell active="settings" title={copy.nav.settings} adminPath={settings.admin_path} locale={settings?.default_locale} siteName={settings.site_name} userEmail={userEmail}>
      <section class="admin-page admin-form-page">
        <header class="admin-page__head"><div><h1>{copy.settings.heading}</h1><p>{copy.settings.subheading}</p></div></header>
        <SettingsForm client:load initialBrand={editableBrand(settings, resolveMediaUrl)} ownerLocale={settings?.default_locale} initialSettings={{ ...settings, updated_at: settings.updated_at.toISOString() }} />
      </section>
    </AdminShell>
  )}
</AdminLayout>
