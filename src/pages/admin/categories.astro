---
import CategoryManager from '../../components/admin/CategoryManager';
import AdminShell from '../../components/admin/AdminShell.astro';
import AdminLayout from '../../layouts/AdminLayout.astro';
import { adminHref, adminLoginPath } from '../../lib/admin';
import { requireOwner } from '../../server/auth/session';
import { listCategories } from '../../server/content/categories';
import { getOwnerSettings, type SiteSettings } from '../../server/content/settings';
import { HttpError } from '../../server/http/errors';
import type { PostCategorySummary } from '../../types/cms';

let initialCategories: PostCategorySummary[] = [];
let userEmail: string | null = null;
let errorMessage: string | null = null;
let settings: SiteSettings | null = null;
let authRequired = false;

try {
  const current = await requireOwner(Astro.request.headers);
  [settings, initialCategories] = await Promise.all([
    getOwnerSettings(current.user.id),
    listCategories(current.user.id),
  ]);
  if (!settings) {
    Astro.response.status = 404;
    errorMessage = 'Categories not found.';
  } else {
    userEmail = current.user.email;
  }
} catch (error) {
  if (error instanceof HttpError && error.status === 401) {
    authRequired = true;
    Astro.response.status = 302;
    Astro.response.headers.set('Location', adminLoginPath(Astro.url.pathname + Astro.url.search));
  } else if (error instanceof HttpError && error.status === 403) {
    Astro.response.status = 404;
    errorMessage = 'Categories not found.';
  } else {
    console.error('Category manager loading failed.');
    Astro.response.status = 500;
    errorMessage = 'Categories are temporarily unavailable.';
  }
}
---

<AdminLayout title="Categories">
  {authRequired || errorMessage ? (
    <main><p class="admin-alert admin-alert--page" role="alert">{errorMessage}</p></main>
  ) : (
    <AdminShell active="posts" adminPath={settings?.admin_path} siteName={settings?.site_name ?? 'TomeCMS'} userEmail={userEmail}>
      <section class="admin-page">
        <header class="admin-page__head">
          <div>
            <h1>Categories</h1>
            <p>Group related Posts without changing how their language editions stay together.</p>
          </div>
          <a class="admin-button admin-button--secondary" href={settings ? adminHref(settings) : '/admin'}>Back to Posts</a>
        </header>
        <CategoryManager initialCategories={initialCategories} client:only="react">
          <p class="admin-editor-fallback" slot="fallback" role="status">Loading Categories…</p>
        </CategoryManager>
      </section>
    </AdminShell>
  )}
</AdminLayout>
