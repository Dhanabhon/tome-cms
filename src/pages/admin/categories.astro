---
import AdminSkeleton from '../../components/admin/AdminSkeleton.astro';
import CategoryManager from '../../components/admin/CategoryManager';
import AdminShell from '../../components/admin/AdminShell.astro';
import AdminLayout from '../../layouts/AdminLayout.astro';
import { adminHref, adminLoginPath } from '../../lib/admin';
import { adminCopy } from '../../lib/admin-i18n';
import { requireOwner } from '../../server/auth/session';
import { listCategories } from '../../server/content/categories';
import { getOwnerSettings, type SiteSettings } from '../../server/content/settings';
import { HttpError } from '../../server/http/errors';
import type { PostCategorySummary } from '../../types/cms';

let initialCategories: PostCategorySummary[] = [];
let userEmail: string | null = null;
let errorKey: 'categoriesHidden' | 'categoriesUnavailable' | null = null;
let settings: SiteSettings | null = null;
let authRequired = false;

try {
  const current = await requireOwner(Astro.request.headers);
  [settings, initialCategories] = await Promise.all([
    getOwnerSettings(current.user.id),
    listCategories(current.user.id),
  ]);
  if (!settings) {
    Astro.response.status = 404;
    errorKey = 'categoriesHidden';
  } else {
    userEmail = current.user.email;
  }
} catch (error) {
  if (error instanceof HttpError && error.status === 401) {
    authRequired = true;
    Astro.response.status = 302;
    Astro.response.headers.set('Location', adminLoginPath(Astro.url.pathname + Astro.url.search));
  } else if (error instanceof HttpError && error.status === 403) {
    Astro.response.status = 404;
    errorKey = 'categoriesHidden';
  } else {
    console.error('Category manager loading failed.');
    Astro.response.status = 500;
    errorKey = 'categoriesUnavailable';
  }
}

const ownerLocale = settings?.default_locale ?? null;
const copy = adminCopy(ownerLocale);
const errorMessage = errorKey ? copy.errors[errorKey] : null;
---

<AdminLayout lang={ownerLocale ?? 'en'} title={copy.categories.heading}>
  {authRequired || errorMessage ? (
    <main><p class="admin-alert admin-alert--page" role="alert">{errorMessage}</p></main>
  ) : (
    <AdminShell active="posts" adminPath={settings?.admin_path} locale={settings?.default_locale} siteName={settings?.site_name ?? 'TomeCMS'} userEmail={userEmail}>
      <section class="admin-page">
        <header class="admin-page__head">
          <div>
            <h1>{copy.categories.heading}</h1>
            <p>{copy.categories.subheading}</p>
          </div>
          <a class="admin-button admin-button--secondary" href={settings ? adminHref(settings) : '/admin'}>{copy.categories.backToPosts}</a>
        </header>
        <CategoryManager initialCategories={initialCategories} ownerLocale={ownerLocale} client:only="react">
          <AdminSkeleton head={false} kind="list" label={copy.categories.loading} slot="fallback" />
        </CategoryManager>
      </section>
    </AdminShell>
  )}
</AdminLayout>
