---
import { z } from 'zod';

import PostArticle from '../../../components/blog/PostArticle.astro';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { adminHref } from '../../../lib/admin';
import { requireInstalledOwner } from '../../../server/auth/session';
import { getPost } from '../../../server/content/posts';
import { getSiteSettings } from '../../../server/content/settings';
import { HttpError } from '../../../server/http/errors';
import type { Post, PublicAuthorProfile, SiteSettings } from '../../../types/cms';

let post: Post | null = null;
let settings: SiteSettings | null = null;
let profile: PublicAuthorProfile | null = null;
let errorMessage: string | null = null;
let adminPath = '/admin';
const id = z.uuid().safeParse(Astro.params.id);
Astro.response.headers.set('Cache-Control', 'private, no-store');

try {
  if (!id.success) {
    Astro.response.status = 404;
    errorMessage = 'Post not found.';
  } else {
    const current = await requireInstalledOwner(Astro.request.headers);
    const storedSettings = await getSiteSettings();
    if (!storedSettings || storedSettings.owner_id !== current.user.id) throw new HttpError(404, 'Post not found.');
    adminPath = storedSettings.admin_path;
    post = await getPost(current.user.id, id.data);
    if (!post) {
      Astro.response.status = 404;
      errorMessage = 'Post not found.';
    } else {
      settings = {
        ...storedSettings,
        installed_at: storedSettings.installed_at.toISOString(),
        updated_at: storedSettings.updated_at.toISOString(),
      };
      profile = {
        avatarUrl: null,
        bio: post.locale === 'th' ? storedSettings.author_bio_th : storedSettings.author_bio_en,
        links: storedSettings.author_links,
        name: storedSettings.author_name || storedSettings.site_name,
      };
    }
  }
} catch (error) {
  if (error instanceof HttpError && error.status === 401) {
    Astro.response.status = 401;
    errorMessage = 'Sign in to preview this post.';
  } else {
    console.error('Post preview query failed.');
    Astro.response.status = error instanceof HttpError && error.status === 404 ? 404 : 500;
    errorMessage = error instanceof HttpError && error.status === 404 ? error.message : 'The preview is temporarily unavailable.';
  }
}

const adminSettings = { admin_path: adminPath };
---

<AdminLayout adminPath={adminPath} lang={post?.locale} title={post ? `Preview: ${post.title}` : 'Draft preview'}>
  <main>
    {errorMessage ? <p class="admin-alert admin-alert--page" role="alert">{errorMessage}</p> : post && settings ? (
      <>
        <div class="admin-preview-bar">
          <strong>Draft preview</strong>
          <a class="admin-button admin-button--secondary" href={adminHref(adminSettings, `/edit/${post.id}`)}>Edit post</a>
        </div>
        <PostArticle post={post} preview profile={profile} settings={settings} />
      </>
    ) : null}
  </main>
</AdminLayout>
