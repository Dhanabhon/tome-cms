---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { adminCopy } from '../../../lib/admin-i18n';
import { safeAdminReturnTo } from '../../../lib/admin';
import { getSiteSettings } from '../../../server/content/settings';

const state = Astro.url.searchParams.get('state');
const errorMessage = state === 'save-error'
  ? 'The latest draft could not be saved.'
  : state === 'preview-error'
    ? 'The Preview link could not be created.'
    : null;
const adminPath = (await getSiteSettings())?.admin_path ?? '/admin';
const returnTo = safeAdminReturnTo(Astro.url.searchParams.get('returnTo'), adminPath);
const copy = adminCopy(null);
---

<AdminLayout adminPath={adminPath} title={copy.preview.draftPreview}>
  <main class="admin-preview-pending">
    <h1>{copy.preview.draftPreview}</h1>
    {errorMessage ? (
      <>
        <p role="alert">{errorMessage}</p>
        <div class="admin-preview-bar">
          <button class="admin-button admin-button--primary" type="button" data-preview-retry>{copy.preview.tryAgain}</button>
          <a class="admin-button admin-button--secondary" href={returnTo}>{copy.preview.returnToEditor}</a>
        </div>
      </>
    ) : <p role="status">{copy.preview.preparing}</p>}
  </main>
</AdminLayout>

<script>
  document.querySelector('[data-preview-retry]')?.addEventListener('click', () => {
    window.opener?.postMessage({ type: 'tome-preview-retry' }, window.location.origin);
  });
</script>
