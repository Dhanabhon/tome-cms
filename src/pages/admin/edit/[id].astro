---
import { z } from 'zod';

import Editor from '../../../components/admin/Editor';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { authenticate } from '../../../lib/supabase';
import type { Post, PostTranslationSummary } from '../../../types/cms';

let post: Post | null = null;
let editorPost: Omit<Post, 'translation_group_id'> | null = null;
let translations: PostTranslationSummary[] = [];
let errorMessage: string | null = null;
const id = z.uuid().safeParse(Astro.params.id);

try {
  if (!id.success) {
    Astro.response.status = 404;
    errorMessage = 'Post not found.';
  } else {
    const auth = await authenticate(Astro.cookies, Astro.request);
    if (!auth) {
      Astro.response.status = 401;
      errorMessage = 'Sign in with your configured Supabase Auth flow to edit this post.';
    } else {
      const { data, error } = await auth.supabase
        .from('posts')
        .select('*')
        .eq('id', id.data)
        .eq('author_id', auth.user.id)
        .maybeSingle();

      if (error) throw error;
      post = data;
      if (!post) {
        Astro.response.status = 404;
        errorMessage = 'Post not found.';
      } else {
        const { data: translationData, error: translationsError } = await auth.supabase
          .from('posts')
          .select('id, locale, status, title')
          .eq('translation_group_id', post.translation_group_id)
          .eq('author_id', auth.user.id)
          .order('locale');
        if (translationsError) throw translationsError;
        translations = translationData;
        const { translation_group_id: _translationGroupId, ...safePost } = post;
        editorPost = safePost;
      }
    }
  }
} catch (error) {
  console.error('Post editor query failed:', error);
  Astro.response.status = 500;
  errorMessage = 'The editor is temporarily unavailable.';
}
---

<AdminLayout title={post?.title ?? 'Edit post'}>
  <main>
    {post && editorPost ? (
      <Editor client:only="react" initialPost={editorPost} locale={post.locale} translations={translations}>
        <div class="admin-editor-fallback" slot="fallback" role="status">Loading editor…</div>
      </Editor>
    ) : (
      <p class="admin-alert admin-alert--page" role="alert">{errorMessage}</p>
    )}
  </main>
</AdminLayout>
