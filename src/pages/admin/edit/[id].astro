---
import { z } from 'zod';

import AdminSkeleton from '../../../components/admin/AdminSkeleton.astro';
import Editor from '../../../components/admin/Editor';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { adminCopy } from '../../../lib/admin-i18n';
import { adminLoginPath } from '../../../lib/admin';
import { requireInstalledOwner } from '../../../server/auth/session';
import { categoryIdsForPost, listCategories } from '../../../server/content/categories';
import { getPost, listPostTranslations } from '../../../server/content/posts';
import { getSiteSettings, type SiteSettings } from '../../../server/content/settings';
import { HttpError } from '../../../server/http/errors';
import type { Post, PostCategory, PostTranslationSummary } from '../../../types/cms';
import { hasJudgement } from '../../../server/ai/typesafe';

let post: Post | null = null;
let editorPost: Omit<Post, 'translation_group_id'> | null = null;
let translations: PostTranslationSummary[] = [];
let categories: PostCategory[] = [];
let initialCategoryIds: string[] = [];
let errorKey: 'editorUnavailable' | 'postNotFound' | null = null;
let serverMessage: string | null = null;
let settings: SiteSettings | null = null;
const id = z.uuid().safeParse(Astro.params.id);

try {
  if (!id.success) {
    Astro.response.status = 404;
    errorKey = 'postNotFound';
  } else {
    settings = await getSiteSettings();
    const current = await requireInstalledOwner(Astro.request.headers);
    if (!settings || settings.owner_id !== current.user.id) throw new HttpError(404, '');
    post = await getPost(current.user.id, id.data);
    if (!post) {
      Astro.response.status = 404;
      errorKey = 'postNotFound';
    } else {
      [categories, initialCategoryIds, translations] = await Promise.all([
        listCategories(current.user.id),
        categoryIdsForPost(current.user.id, post.id),
        listPostTranslations(current.user.id, post.translation_group_id),
      ]);
      const { translation_group_id: _translationGroupId, ...safePost } = post;
      editorPost = safePost;
    }
  }
} catch (error) {
  if (error instanceof HttpError && error.status === 401) {
    Astro.response.status = 302;
    Astro.response.headers.set('Location', adminLoginPath(Astro.url.pathname + Astro.url.search, settings?.admin_path ?? '/admin'));
  } else {
    console.error('Post editor query failed.');
    Astro.response.status = error instanceof HttpError && error.status === 404 ? 404 : 500;
    if (error instanceof HttpError && error.status === 404) { if (error.message) serverMessage = error.message; else errorKey = 'postNotFound'; }
    else errorKey = 'editorUnavailable';
  }
}

const copy = adminCopy(settings?.default_locale);
const errorMessage = serverMessage ?? (errorKey ? copy.preview[errorKey] : null);
---

<AdminLayout adminPath={settings?.admin_path ?? '/admin'} title={post?.title ?? 'Edit post'}>
  <main>
    {post && editorPost ? (
      <Editor canSuggest={hasJudgement()} adminPath={settings?.admin_path ?? '/admin'} ownerLocale={settings?.default_locale} client:only="react" categories={categories} initialCategoryIds={initialCategoryIds} initialPost={editorPost} locale={post.locale} translations={translations}>
        <AdminSkeleton kind="editor" label={copy.preview.loadingEditor} slot="fallback" />
      </Editor>
    ) : (
      <p class="admin-alert admin-alert--page" role="alert">{errorMessage}</p>
    )}
  </main>
</AdminLayout>
