---
import Header from '../components/blog/Header.astro';
import SEOHead from '../components/blog/SEOHead.astro';
import { getSiteSettings } from '../lib/installation';
import { getPublicSiteUrl } from '../lib/seo';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  headline?: string;
  image?: string | null;
  modifiedTime?: string | null;
  publishedTime?: string | null;
  robots?: string;
  type?: 'article' | 'website';
}

const settings = await getSiteSettings();
const siteName = settings?.site_name ?? 'TomeCMS';
const defaultDescription = settings?.site_description || 'A quiet place for thoughtful notes on design, software, and the work between.';
const locale = settings?.default_locale ?? 'en';
const {
  description = defaultDescription,
  headline,
  image,
  modifiedTime,
  publishedTime,
  robots = 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1',
  title = siteName,
  type = 'website',
} = Astro.props;
const siteUrl = getPublicSiteUrl(Astro.request, Astro.site);
const canonical = new URL(Astro.url.pathname, siteUrl).toString();
const homeUrl = siteUrl.toString();
const absoluteImage = image ? new URL(image, siteUrl).toString() : null;
const pageTitle = title === siteName ? title : `${title} | ${siteName}`;
const publisher = { '@type': 'Organization', name: siteName, url: homeUrl };
const structuredData = robots.includes('noindex')
  ? undefined
  : type === 'article'
    ? {
        '@context': 'https://schema.org',
        '@type': 'BlogPosting',
        author: publisher,
        dateModified: modifiedTime || undefined,
        datePublished: publishedTime || undefined,
        description,
        headline: headline ?? title,
        image: absoluteImage || undefined,
        inLanguage: locale,
        isAccessibleForFree: true,
        mainEntityOfPage: { '@id': canonical, '@type': 'WebPage' },
        publisher,
        url: canonical,
      }
    : {
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        description,
        inLanguage: locale,
        name: siteName,
        publisher,
        url: homeUrl,
      };
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SEOHead
      author={type === 'article' ? siteName : undefined}
      title={pageTitle}
      description={description}
      canonical={canonical}
      image={absoluteImage}
      imageAlt={headline ?? title}
      locale={locale}
      modifiedTime={modifiedTime}
      publishedTime={publishedTime}
      robots={robots}
      siteName={siteName}
      structuredData={structuredData}
      type={type}
    />
  </head>
  <body class="flex min-h-screen flex-col">
    <Header active="writing" siteName={siteName} />
    <main class="flex-1">
      <slot />
    </main>
    <footer class="mx-auto flex w-full max-w-6xl flex-col gap-3 border-t border-line px-5 py-7 text-sm text-muted sm:flex-row sm:items-center sm:justify-between sm:px-8">
      <p>&copy; {new Date().getFullYear()} {siteName}. All rights reserved.</p>
      <nav aria-label="Footer" class="flex gap-6">
        <a class="text-accent hover:underline" href="/">Writing</a>
        <a class="text-accent hover:underline" href="/admin">Admin</a>
      </nav>
    </footer>
  </body>
</html>
