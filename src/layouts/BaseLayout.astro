---
import Icon from '../components/Icon.astro';
import NoticeScript from '../components/NoticeScript.astro';
import PluginClients from '../components/PluginClients.astro';
import StatsBeacon from '../components/StatsBeacon.astro';
import VideoScript from '../components/VideoScript.astro';
import SEOHead from '../components/blog/SEOHead.astro';
import ThemeScript from '../components/ThemeScript.astro';
import { adminHref } from '../lib/admin';
import { getPublicSiteUrl } from '../lib/seo';
import { NO_BRAND, siteBrand } from '../lib/site-brand';
import { getPublicNavigation } from '../server/content/navigation';
import { publicAdditions } from '../server/plugins/public';
import { publicCopy } from '../lib/i18n';
import type { CountedPage } from '../lib/stats';
import { getSiteSettings } from '../server/content/settings';
import { normalizeTheme, themeAttribute } from '../lib/theme';
import { DEFAULT_THEME_ID, isThemeId, resolveTheme } from '../themes/registry';
import { readThemeSettings } from '../server/themes/store';
import { resolveMediaUrl } from '../server/media/url';
import { themeStylesheet } from '../themes/styles';
import type { PostAlternate, PostLocale } from '../types/cms';
import '../styles/global.css';

type AlternateLink = { href: string; hreflang: 'th' | 'en' | 'x-default' };

interface Props {
  authorName?: string;
  title?: string;
  description?: string;
  headline?: string;
  image?: string | null;
  modifiedTime?: string | null;
  publishedTime?: string | null;
  robots?: string;
  /**
   * What this page is, for the owner's Stats screen. Only the home page, a post and a page pass
   * it; everything else -- a 404, an error, a preview -- carries no counting script.
   */
  stats?: CountedPage;
  type?: 'article' | 'page' | 'website';
  alternates?: PostAlternate[];
  canonicalPath?: string;
  locale?: PostLocale;
  /**
   * A theme to draw with instead of the one the settings name, for the admin's preview of
   * a theme it has not applied. Left out everywhere else, which is every page a reader
   * reaches: the stored setting is what a site is drawn with.
   */
  themeId?: string | null;
  xDefaultHref?: string;
  /** Whether this page's content holds a video: only then does it load the script that plays one. */
  video?: boolean;
}

const settings = await getSiteSettings();
// null when the owner leaves it on 'system', which is how the stylesheet is told to
// follow each visitor's own setting. Astro drops an attribute whose value is null.
const themeChoice = normalizeTheme(settings?.theme);
const theme = themeAttribute(themeChoice);
// Off takes the script with the control. A hidden button that still let an old
// localStorage value override the owner would be the worst of both, and dropping
// the script puts the public pages back to carrying no JavaScript at all.
const allowVisitorTheme = settings?.allow_visitor_theme ?? true;
// A site whose settings could not be read still says what it runs on, which is the default.
const showPoweredBy = settings?.show_powered_by ?? true;
const siteName = settings?.site_name ?? 'TomeCMS';
const brand = settings ? siteBrand(settings, resolveMediaUrl) : NO_BRAND;
const defaultDescription = settings?.site_description || 'A quiet place for thoughtful notes on design, software, and the work between.';
const {
  alternates,
  authorName,
  canonicalPath,
  description = defaultDescription,
  headline,
  image,
  modifiedTime,
  publishedTime,
  robots = 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1',
  stats,
  title = siteName,
  type = 'website',
  locale = settings?.default_locale ?? 'en',
  themeId = settings?.theme_id,
  xDefaultHref,
} = Astro.props;
const navigation = await getPublicNavigation(locale);
const publicText = publicCopy(locale);
// What the enabled plugins add here. The band is drawn by this layout, from words and at
// most one checked link -- nothing a plugin returns is written into the page as markup.
const additions = settings
  ? await publicAdditions(
    settings.owner_id,
    { kind: type === 'article' ? 'post' : type === 'page' ? 'page' : 'home', locale },
    getPublicSiteUrl(Astro.request, Astro.site).origin,
  )
  : { clients: [], notice: null, popup: null };
// Only the admin's theme previews name a theme, and they are drawn in small frames on the
// Themes screen, where a popup would cover the picture of the theme with a box nobody can
// close. They keep the band, which is part of how the site looks, and go without the popup.
const plugins = Astro.props.themeId && additions.popup
  ? { ...additions, clients: additions.clients.filter(({ id }) => id !== additions.popup?.pluginId), popup: null }
  : additions;
// The head is the product's promise to a search engine and stays here. Everything a
// reader sees below it belongs to the theme, arrangement included.
const activeTheme = await resolveTheme(themeId);
const themeSettings = await readThemeSettings(isThemeId(themeId) ? themeId : DEFAULT_THEME_ID);
const themeCss = themeStylesheet(themeId);
const siteUrl = getPublicSiteUrl(Astro.request, Astro.site);
const canonical = new URL(canonicalPath ?? Astro.url.pathname, siteUrl).toString();
const homeUrl = siteUrl.toString();
const absoluteImage = image ? new URL(image, siteUrl).toString() : null;
const pageTitle = title === siteName ? title : `${title} | ${siteName}`;
const publisher = { '@type': 'Organization', name: siteName, url: homeUrl };
const author = authorName
  ? { '@type': 'Person', name: authorName }
  : publisher;
const seoAlternates: AlternateLink[] = [
  ...(alternates ?? []).map(({ href, locale }) => ({ href: new URL(href, siteUrl).toString(), hreflang: locale })),
  ...(xDefaultHref
    ? [{ href: new URL(xDefaultHref, siteUrl).toString(), hreflang: 'x-default' as const }]
    : []),
];
const structuredData = robots.includes('noindex')
  ? undefined
  : type === 'article'
    ? {
        '@context': 'https://schema.org',
        '@type': 'BlogPosting',
        author,
        dateModified: modifiedTime || undefined,
        datePublished: publishedTime || undefined,
        description,
        headline: headline ?? title,
        image: absoluteImage || undefined,
        inLanguage: locale,
        isAccessibleForFree: true,
        mainEntityOfPage: { '@id': canonical, '@type': 'WebPage' },
        publisher,
        url: canonical,
      }
    : type === 'page'
      ? {
          '@context': 'https://schema.org',
          '@type': 'WebPage',
          description,
          inLanguage: locale,
          isPartOf: { '@type': 'WebSite', name: siteName, url: homeUrl },
          name: headline ?? title,
          publisher,
          url: canonical,
        }
      : {
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        description,
        inLanguage: locale,
        name: siteName,
        publisher,
        url: homeUrl,
      };
---

<!doctype html>
<html data-theme={theme} lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SEOHead
      author={type === 'article' ? authorName ?? siteName : undefined}
      alternates={seoAlternates}
      title={pageTitle}
      description={description}
      canonical={canonical}
      icon={brand.icon}
      image={absoluteImage}
      imageAlt={headline ?? title}
      locale={locale}
      modifiedTime={modifiedTime}
      publishedTime={publishedTime}
      robots={robots}
      siteName={siteName}
      structuredData={structuredData}
      type={type}
    />
    <link rel="preload" href="/fonts/ibm-plex-sans-thai-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/ibm-plex-sans-thai-thai-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <!-- The display face, Thai only: the title is the largest thing on the page and
         font-synthesis is off, so a swap out of the fallback is the most visible one
         there is. Latin display is left to load on demand -- 22KB for the minority
         script is not worth doubling the critical path again. -->
    <link rel="preload" href="/fonts/google-sans-thai-700-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="/fonts.css" />
    <link rel="stylesheet" href={themeCss} />
    {allowVisitorTheme && <ThemeScript />}
    {plugins.notice?.dismissKey && <NoticeScript dismissKey={plugins.notice.dismissKey} />}
  </head>
  <activeTheme.Shell
    allowVisitorTheme={allowVisitorTheme}
    alternates={alternates ?? []}
    brand={brand}
    footer={navigation.footer}
    header={navigation.header}
    locale={locale}
    showPoweredBy={showPoweredBy}
    siteName={siteName}
    theme={themeChoice}
    themeSettings={themeSettings}
  >
    <Fragment slot="above">
      {Astro.locals.maintenanceOwner && settings && (
        <aside class="site-maintenance-bar">
          <p>{publicText.maintenanceBar} <a href={adminHref(settings, '/maintenance')}>{publicText.maintenanceManage}</a></p>
        </aside>
      )}
      {plugins.notice && (
        <aside
          class="site-notice"
          data-dismiss-key={plugins.notice.dismissKey}
          data-site-notice
          style={plugins.notice.colors
            ? `--notice-background: ${plugins.notice.colors.background}; --notice-text: ${plugins.notice.colors.text};`
            : undefined}
        >
          <p>
            {plugins.notice.text}
            {plugins.notice.link && <a href={plugins.notice.link.href}>{plugins.notice.link.label}</a>}
          </p>
          {plugins.notice.dismissKey && (
            <button aria-label={publicText.closeNotice} data-notice-close type="button">
              <Icon name="close" />
            </button>
          )}
        </aside>
      )}
      {plugins.popup && (
        <dialog
          aria-labelledby="site-popup-heading"
          class:list={['site-popup', { 'site-popup--picture': plugins.popup.image }]}
          data-delay={String(plugins.popup.delaySeconds)}
          data-dismiss-key={plugins.popup.dismissKey}
          data-site-popup
          data-trigger={plugins.popup.trigger}
          lang={plugins.popup.locale}
        >
          <form class="site-popup__close" method="dialog">
            <button aria-label={publicText.closePopup} type="submit" value="close"><Icon name="close" /></button>
          </form>
          {plugins.popup.image && (
            <img
              alt=""
              class="site-popup__image"
              decoding="async"
              height={plugins.popup.image.height}
              loading="lazy"
              src={plugins.popup.image.src}
              width={plugins.popup.image.width}
            />
          )}
          <div class="site-popup__body">
            <h2 id="site-popup-heading">{plugins.popup.heading}</h2>
            {plugins.popup.text && <p class="site-popup__text">{plugins.popup.text}</p>}
            <a class="site-popup__action" href={plugins.popup.action.href}>{plugins.popup.action.label}</a>
            <form method="dialog">
              <button class="site-popup__decline" type="submit" value="decline">{plugins.popup.decline ?? publicText.popupDecline}</button>
            </form>
            {plugins.popup.finePrint && <p class="site-popup__fine">{plugins.popup.finePrint}</p>}
          </div>
        </dialog>
      )}
      {plugins.clients.map(({ dataset, id }) => (
        <span
          data-close={publicText.closeImage}
          data-open={publicText.openImage}
          data-plugin={id}
          hidden
          {...Object.fromEntries(Object.entries(dataset).map(([key, value]) => [`data-${key}`, value]))}
        />
      ))}
    </Fragment>
    <slot />
  </activeTheme.Shell>
  {plugins.clients.length + (plugins.notice ? 1 : 0) > 0 && <PluginClients />}
  {/* A theme preview is the admin's own picture of a theme, not a reader. */}
  {stats && !Astro.props.themeId && <StatsBeacon locale={locale} stats={stats} />}
  {Astro.props.video && <VideoScript locale={locale} />}
</html>
