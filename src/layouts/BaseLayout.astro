---
import SEOHead from '../components/blog/SEOHead.astro';
import ThemeScript from '../components/ThemeScript.astro';
import { getPublicSiteUrl } from '../lib/seo';
import { getPublicNavigation } from '../server/content/navigation';
import { getSiteSettings } from '../server/content/settings';
import { normalizeTheme, themeAttribute } from '../lib/theme';
import { resolveTheme } from '../themes/registry';
import { themeStylesheet } from '../themes/styles';
import type { PostAlternate, PostLocale } from '../types/cms';
import '../styles/global.css';

type AlternateLink = { href: string; hreflang: 'th' | 'en' | 'x-default' };

interface Props {
  authorName?: string;
  title?: string;
  description?: string;
  headline?: string;
  image?: string | null;
  modifiedTime?: string | null;
  publishedTime?: string | null;
  robots?: string;
  type?: 'article' | 'page' | 'website';
  alternates?: PostAlternate[];
  canonicalPath?: string;
  locale?: PostLocale;
  /**
   * A theme to draw with instead of the one the settings name, for the admin's preview of
   * a theme it has not applied. Left out everywhere else, which is every page a reader
   * reaches: the stored setting is what a site is drawn with.
   */
  themeId?: string | null;
  xDefaultHref?: string;
}

const settings = await getSiteSettings();
// null when the owner leaves it on 'system', which is how the stylesheet is told to
// follow each visitor's own setting. Astro drops an attribute whose value is null.
const themeChoice = normalizeTheme(settings?.theme);
const theme = themeAttribute(themeChoice);
// Off takes the script with the control. A hidden button that still let an old
// localStorage value override the owner would be the worst of both, and dropping
// the script puts the public pages back to carrying no JavaScript at all.
const allowVisitorTheme = settings?.allow_visitor_theme ?? true;
// A site whose settings could not be read still says what it runs on, which is the default.
const showPoweredBy = settings?.show_powered_by ?? true;
const siteName = settings?.site_name ?? 'TomeCMS';
const defaultDescription = settings?.site_description || 'A quiet place for thoughtful notes on design, software, and the work between.';
const {
  alternates,
  authorName,
  canonicalPath,
  description = defaultDescription,
  headline,
  image,
  modifiedTime,
  publishedTime,
  robots = 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1',
  title = siteName,
  type = 'website',
  locale = settings?.default_locale ?? 'en',
  themeId = settings?.theme_id,
  xDefaultHref,
} = Astro.props;
const navigation = await getPublicNavigation(locale);
// The head is the product's promise to a search engine and stays here. Everything a
// reader sees below it belongs to the theme, arrangement included.
const activeTheme = await resolveTheme(themeId);
const themeCss = themeStylesheet(themeId);
const siteUrl = getPublicSiteUrl(Astro.request, Astro.site);
const canonical = new URL(canonicalPath ?? Astro.url.pathname, siteUrl).toString();
const homeUrl = siteUrl.toString();
const absoluteImage = image ? new URL(image, siteUrl).toString() : null;
const pageTitle = title === siteName ? title : `${title} | ${siteName}`;
const publisher = { '@type': 'Organization', name: siteName, url: homeUrl };
const author = authorName
  ? { '@type': 'Person', name: authorName }
  : publisher;
const seoAlternates: AlternateLink[] = [
  ...(alternates ?? []).map(({ href, locale }) => ({ href: new URL(href, siteUrl).toString(), hreflang: locale })),
  ...(xDefaultHref
    ? [{ href: new URL(xDefaultHref, siteUrl).toString(), hreflang: 'x-default' as const }]
    : []),
];
const structuredData = robots.includes('noindex')
  ? undefined
  : type === 'article'
    ? {
        '@context': 'https://schema.org',
        '@type': 'BlogPosting',
        author,
        dateModified: modifiedTime || undefined,
        datePublished: publishedTime || undefined,
        description,
        headline: headline ?? title,
        image: absoluteImage || undefined,
        inLanguage: locale,
        isAccessibleForFree: true,
        mainEntityOfPage: { '@id': canonical, '@type': 'WebPage' },
        publisher,
        url: canonical,
      }
    : type === 'page'
      ? {
          '@context': 'https://schema.org',
          '@type': 'WebPage',
          description,
          inLanguage: locale,
          isPartOf: { '@type': 'WebSite', name: siteName, url: homeUrl },
          name: headline ?? title,
          publisher,
          url: canonical,
        }
      : {
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        description,
        inLanguage: locale,
        name: siteName,
        publisher,
        url: homeUrl,
      };
---

<!doctype html>
<html data-theme={theme} lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SEOHead
      author={type === 'article' ? authorName ?? siteName : undefined}
      alternates={seoAlternates}
      title={pageTitle}
      description={description}
      canonical={canonical}
      image={absoluteImage}
      imageAlt={headline ?? title}
      locale={locale}
      modifiedTime={modifiedTime}
      publishedTime={publishedTime}
      robots={robots}
      siteName={siteName}
      structuredData={structuredData}
      type={type}
    />
    <link rel="preload" href="/fonts/ibm-plex-sans-thai-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/ibm-plex-sans-thai-thai-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <!-- The display face, Thai only: the title is the largest thing on the page and
         font-synthesis is off, so a swap out of the fallback is the most visible one
         there is. Latin display is left to load on demand -- 22KB for the minority
         script is not worth doubling the critical path again. -->
    <link rel="preload" href="/fonts/google-sans-thai-700-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="/fonts.css" />
    <link rel="stylesheet" href={themeCss} />
    {allowVisitorTheme && <ThemeScript />}
  </head>
  <activeTheme.Shell
    allowVisitorTheme={allowVisitorTheme}
    alternates={alternates ?? []}
    footer={navigation.footer}
    header={navigation.header}
    locale={locale}
    showPoweredBy={showPoweredBy}
    siteName={siteName}
    theme={themeChoice}
  >
    <slot />
  </activeTheme.Shell>
</html>
