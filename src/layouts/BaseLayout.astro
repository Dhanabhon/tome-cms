---
import Header from '../components/blog/Header.astro';
import SEOHead from '../components/blog/SEOHead.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string | null;
  type?: 'article' | 'website';
}

const {
  description = 'A quiet place for thoughtful notes on design, software, and the work between.',
  image,
  title = 'TomeCMS',
  type = 'website',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).toString();
const pageTitle = title === 'TomeCMS' ? title : `${title} | TomeCMS`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <SEOHead title={pageTitle} description={description} canonical={canonical} image={image} type={type} />
  </head>
  <body class="flex min-h-screen flex-col">
    <Header active="writing" />
    <main class="flex-1">
      <slot />
    </main>
    <footer class="mx-auto flex w-full max-w-6xl flex-col gap-3 border-t border-line px-5 py-7 text-sm text-muted sm:flex-row sm:items-center sm:justify-between sm:px-8">
      <p>&copy; {new Date().getFullYear()} TomeCMS. All rights reserved.</p>
      <nav aria-label="Footer" class="flex gap-6">
        <a class="text-accent hover:underline" href="/">Writing</a>
        <a class="text-accent hover:underline" href="/admin">Admin</a>
      </nav>
    </footer>
  </body>
</html>

