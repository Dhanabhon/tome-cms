---
import PageTransitionSkeleton from '../components/PageTransitionSkeleton.astro';
import ThemeScript from '../components/ThemeScript.astro';
import { normalizeAdminPath } from '../lib/admin';
import { adminCopy } from '../lib/admin-i18n';
import type { PostLocale } from '../types/cms';
import '../styles/global.css';

interface Props {
  adminPath?: string;
  title: string;
  lang?: PostLocale;
}

const { adminPath: requestedAdminPath = '/admin', title, lang = 'en' } = Astro.props;
const adminPath = normalizeAdminPath(requestedAdminPath);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} | TomeCMS</title>
    <meta name="description" content="TomeCMS publishing dashboard." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/ibm-plex-sans-thai-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/ibm-plex-sans-thai-thai-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <!-- The display face, Thai only: the title is the largest thing on the page and
         font-synthesis is off, so a swap out of the fallback is the most visible one
         there is. Latin display is left to load on demand -- 22KB for the minority
         script is not worth doubling the critical path again. -->
    <link rel="preload" href="/fonts/google-sans-thai-700-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="/fonts.css" />
    <ThemeScript />
  </head>
  <body class="admin-body" data-admin-path={adminPath}>
    <slot />
    <PageTransitionSkeleton label={adminCopy(lang).media.loading} />
  </body>
</html>
