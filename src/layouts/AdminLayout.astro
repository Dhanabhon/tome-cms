---
import SEOHead from '../components/blog/SEOHead.astro';
import '../styles/global.css';

interface Props {
  title: string;
  userEmail?: string | null;
  showHeader?: boolean;
}

const { showHeader = true, title, userEmail } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).toString();
const mediaActive = Astro.url.pathname === '/admin/media';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex, nofollow" />
    <SEOHead title={`${title} | TomeCMS`} description="TomeCMS publishing dashboard." canonical={canonical} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&family=IBM+Plex+Sans+Thai:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="admin-body">
    {showHeader && (
      <header class="admin-header">
        <div class="admin-header__inner">
          <div class="admin-header__brand">
            <a href="/admin" aria-label="TomeCMS dashboard">
              <img class="admin-logo" src="/brand/tomecms-logo.png" alt="TomeCMS" width="2172" height="724" />
            </a>
            <nav aria-label="Admin" class="admin-nav">
              <a class="admin-nav__link" href="/admin" aria-current={mediaActive ? undefined : 'page'}>Posts</a>
              <a class="admin-nav__link" href="/admin/media" aria-current={mediaActive ? 'page' : undefined}>Media</a>
              <a class="admin-nav__link" href="/" target="_blank" rel="noopener noreferrer" aria-label="View site (opens in a new tab)">
                View site <span aria-hidden="true">↗</span>
              </a>
            </nav>
          </div>
          {userEmail && <span class="admin-user">{userEmail}</span>}
        </div>
      </header>
    )}
    <main>
      <slot />
    </main>
  </body>
</html>
