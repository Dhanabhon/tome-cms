---
import SEOHead from '../components/blog/SEOHead.astro';
import '../styles/global.css';

interface Props {
  title: string;
  userEmail?: string | null;
  showHeader?: boolean;
}

const { title } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex, nofollow" />
    <SEOHead title={`${title} | TomeCMS`} description="TomeCMS publishing dashboard." canonical={canonical} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Thai:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="admin-body">
    <slot />
  </body>
</html>
