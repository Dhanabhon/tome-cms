---
import Icon from '../../components/Icon.astro';
import HeroControls from './parts/HeroControls.astro';
import { FOCUS_POSITION } from '../../lib/home-slides';
import { dateLocale, localePath, postPath, publicCopy } from '../../lib/i18n';
import { postExcerpt, postReadingMinutes } from '../../lib/posts';
import { PAPER_SIZES, responsiveAttrs } from '../../lib/responsive-image';
import type { Post } from '../../types/cms';
import type { ThemeHomeProps } from '../contract';

interface Props extends ThemeHomeProps {}

const { activeCategory, categories, cursor, loadError, locale, nextCursor, posts, profile, query, slides: ownSlides, siteName, tagline, themeSettings, timezone } = Astro.props;
// Off leaves the link a reader without JavaScript already follows, and the script below
// finds nothing to wire -- the marker is what it looks for.
const endless = themeSettings.infiniteScroll !== 'off';
// Four across on an 80rem page is 18.9rem a card, just under the floor the other two keep,
// so asking for four is also asking for that much less room per title.
const columns = themeSettings.gridColumns ?? '3';
const hero = themeSettings.hero ?? 'text';
// The owner's slides turn, how often, and how: covers keep turning every six seconds, sliding.
const turn = themeSettings.heroTurn === 'off' ? 'off' : 'on';
const every = themeSettings.heroEvery === '4' || themeSettings.heroEvery === '8' ? themeSettings.heroEvery : '6';
const moveBy = themeSettings.heroMove === 'fade' ? 'fade' : 'slide';
const gridStyle = `--post-grid-columns: ${columns}; --post-grid-min: ${columns === '4' ? '16rem' : '19rem'};`;
const cardSizes = PAPER_SIZES.cards[columns === '2' || columns === '4' ? columns : '3'];

const copy = locale === 'th'
  ? {
    all: 'บทความทั้งหมด',
    defaultHeadline: 'เขียนไว้อย่างตั้งใจ เผยแพร่อย่างพิถีพิถัน',
    featured: 'บทความล่าสุด',
    highlights: 'ไฮไลต์',
    nextSlide: 'ภาพถัดไป',
    previousSlide: 'ภาพก่อนหน้า',
    slideOf: 'ภาพที่ {index} จาก {count}',
    startRotating: 'เริ่มเลื่อนภาพอัตโนมัติ',
    stopRotating: 'หยุดเลื่อนภาพอัตโนมัติ',
    categories: 'หมวดหมู่',
    empty: 'ยังไม่มีบทความที่เผยแพร่',
    emptyCategory: 'ยังไม่มีบทความในหมวดหมู่นี้',
    failed: 'โหลดบทความเพิ่มไม่สำเร็จ',
    loading: 'กำลังโหลด…',
    older: 'บทความเก่ากว่า',
    retry: 'ลองอีกครั้ง',
    showing: 'กำลังแสดง {name}',
    unavailable: 'ขณะนี้ยังแสดงบทความไม่ได้ โปรดลองใหม่ภายหลัง',
  }
  : {
    all: 'All posts',
    defaultHeadline: 'Ideas, carefully published.',
    featured: 'Newest posts',
    highlights: 'Highlights',
    nextSlide: 'Next image',
    previousSlide: 'Previous image',
    slideOf: 'Image {index} of {count}',
    startRotating: 'Start rotating the images',
    stopRotating: 'Stop rotating the images',
    categories: 'Categories',
    empty: 'No published posts yet.',
    emptyCategory: 'No posts in this category yet.',
    failed: 'More posts could not be loaded.',
    loading: 'Loading…',
    older: 'Older posts',
    retry: 'Try again',
    showing: 'Showing {name}',
    unavailable: 'Published posts are temporarily unavailable.',
  };

// Never an empty h1: a site with no name yet is called what the route calls it.
const name = siteName.trim() || 'TomeCMS';
// The byline a post carries on the feed: the author when the profile names one, the site
// when it does not.
const byline = profile?.name || siteName;
const home = localePath(locale);
const categoryHref = (name: string) => `${home}?${new URLSearchParams({ category: name })}`;
const isCurrent = (name: string) => activeCategory?.toLocaleLowerCase() === name.toLocaleLowerCase();
// The owner's words, or the theme's in the language the page is read in. It was one English
// sentence written into the template, which a Thai reader met in English.
const headline = themeSettings.heroHeadline?.trim() || copy.defaultHeadline;
// The covers the route already fetched. A hero of one is not a slider, and a page whose
// newest posts have no covers falls back to text rather than to an empty band.
const slides = hero === 'slider' ? posts.filter(({ cover_image }) => cover_image).slice(0, 5) : [];
// The owner's own slides: a still banner for one, the slider for more, and the text hero when
// none is live, as covers falls back when no post has a cover.
// A search shows its results first: whoever typed one wants them, not the banner above them.
// A category is the same: a reader who chose one wants its posts, not six hundred pixels of
// slider above them.
const band = query || activeCategory ? 'none'
  : hero === 'slides'
    ? ownSlides.length > 1 ? 'slides' : ownSlides.length === 1 ? 'banner' : 'text'
    : slides.length > 1 ? 'slider' : hero === 'slider' ? 'text' : hero;

const olderHref = nextCursor
  ? `${home}?${new URLSearchParams({ ...(activeCategory ? { category: activeCategory } : {}), ...(query ? { q: query } : {}), cursor: nextCursor })}`
  : null;
const shared = publicCopy(locale);
// The reader's words go into a sentence as text, whatever they contain.
const saying = (template: string) => template.replace('{query}', () => query ?? '');
// The category as the site names it, not as the address happened to spell it.
const categoryName = activeCategory
  && (categories.find(({ name: category }) => isCurrent(category))?.name ?? activeCategory);
const dateFormatter = new Intl.DateTimeFormat(dateLocale(locale), {
  day: 'numeric',
  month: 'short',
  timeZone: timezone,
  year: 'numeric',
});
const postDate = (post: Post) => dateFormatter.format(new Date(post.published_at ?? post.created_at));
const readTime = (post: Post) => {
  const minutes = postReadingMinutes(post);
  return locale === 'th' ? `อ่าน ${minutes} นาที` : `${minutes} min read`;
};
---

{/* The page's one h1, whatever the band: the site's name. It stands outside every band, so a
    category chosen by its pill, which hides the band, leaves it in place. The text band's headline
    is the owner's line about the site, drawn large, not the page's title. */}
<h1 class="sr-only">{name}</h1>

{band === 'slider' && (
  <section class="home-hero home-hero--slider" aria-roledescription="carousel" aria-label={copy.featured} data-hero-slider>
    <ul class="hero-slider" data-hero-track>
      {slides.map((post, index) => (
        <li
          class="hero-slider__slide"
          aria-label={copy.slideOf.replace('{index}', String(index + 1)).replace('{count}', String(slides.length))}
          aria-roledescription="slide"
          data-hero-slide
        >
          <a href={postPath(post)}>
            {/* The first is the page's largest paint: it is asked for at once and at
                priority, and the ones a reader has not reached are not asked for at all. */}
            <img
              alt=""
              fetchpriority={index === 0 ? 'high' : 'low'}
              height={post.coverImage?.height ?? 900}
              loading={index === 0 ? 'eager' : 'lazy'}
              src={post.cover_image}
              width={post.coverImage?.width ?? 1600}
              {...responsiveAttrs(post.coverImage, PAPER_SIZES.hero)}
            />
            <span class="hero-slider__caption"><span class="hero-slider__title">{post.title}</span></span>
          </a>
        </li>
      ))}
    </ul>
    <HeroControls next={copy.nextSlide} previous={copy.previousSlide} start={copy.startRotating} stop={copy.stopRotating} />
  </section>
)}

{(band === 'slides' || band === 'banner') && (
  <section
    aria-label={copy.highlights}
    aria-roledescription={band === 'slides' ? 'carousel' : undefined}
    class="home-hero home-hero--slider home-hero--slides"
    data-every={every}
    data-hero-slider={band === 'slides' ? '' : undefined}
    data-turn={turn}
  >
    <ul class="hero-slider" data-hero-track data-move={moveBy}>
      {ownSlides.map((slide, index) => (
        <li
          aria-label={band === 'slides' ? copy.slideOf.replace('{index}', String(index + 1)).replace('{count}', String(ownSlides.length)) : undefined}
          aria-roledescription={band === 'slides' ? 'slide' : undefined}
          class="hero-slide"
          data-align={slide.align}
          data-hero-slide
          data-overlay={slide.overlay}
        >
          {/* The first is the page's largest paint: asked for at once and first. The others are
              behind it until they turn, so they are asked for last, and only as they near. */}
          <img
            alt={slide.image.alt}
            decoding="async"
            fetchpriority={index === 0 ? 'high' : 'low'}
            height={slide.image.height}
            loading={index === 0 ? 'eager' : 'lazy'}
            sizes={slide.image.srcset && PAPER_SIZES.hero}
            src={slide.image.src}
            srcset={slide.image.srcset}
            style={`object-position: ${FOCUS_POSITION[slide.focus]};`}
            width={slide.image.width}
          />
          {(slide.heading || slide.body || slide.button) && (
            <div class="hero-slide__words">
              {slide.heading && <h2 class="hero-slide__heading">{slide.heading}</h2>}
              {slide.body && <p class="hero-slide__body">{slide.body}</p>}
              {slide.button && (
                <a
                  class="hero-slide__button"
                  href={slide.button.href}
                  rel={slide.button.newTab ? 'noopener noreferrer' : undefined}
                  target={slide.button.newTab ? '_blank' : undefined}
                >
                  {slide.button.label}{slide.button.newTab && <span class="sr-only"> {publicCopy(locale).opensInNewTab}</span>}
                </a>
              )}
            </div>
          )}
        </li>
      ))}
    </ul>
    {band === 'slides' && <HeroControls next={copy.nextSlide} previous={copy.previousSlide} start={copy.startRotating} stop={copy.stopRotating} />}
  </section>
)}

{(band === 'text' || band === 'animated') && (
  <section class="home-hero" data-hero={band === 'animated' ? 'moving' : undefined}>
    <div class="mx-auto max-w-7xl px-5 pt-12 pb-16 sm:px-7 sm:pt-16 sm:pb-24">
      <p class="hero-title max-w-xl">{headline}</p>
      {tagline && (
        <p class="lead mt-6 max-w-md">
          {tagline}
        </p>
      )}
    </div>
  </section>
)}

<section class="mx-auto w-full max-w-7xl px-5 py-12 sm:px-7 sm:py-16">
  <!-- What narrows the feed, on one row: the categories, and at the row's end a quiet search.
       Both are the same kind of thing, so they sit together; the search used to be a filled
       button above them, the one loud control on the page. -->
  <div class="post-controls">
    {categories.length > 0 && (
      <nav class="post-filter" aria-label={copy.categories} data-post-filter data-announce={copy.showing}>
        <ul>
          <li><a href={home} aria-current={activeCategory || query ? undefined : 'page'}>{copy.all}</a></li>
          {categories.map(({ name }) => (
            <li><a href={categoryHref(name)} aria-current={isCurrent(name) ? 'page' : undefined}>{name}</a></li>
          ))}
        </ul>
        <p class="sr-only" role="status" data-post-filter-status></p>
      </nav>
    )}
    <form class="post-search" role="search" method="get" action={home} data-post-search>
      <label class="sr-only" for="post-search-q">{shared.searchLabel}</label>
      <input id="post-search-q" name="q" type="search" value={query ?? ''} maxlength="100" placeholder={shared.searchLabel} autocomplete="off" enterkeyhint="search" />
      <button class="post-search__submit" type="submit" aria-label={shared.search} title={shared.search}><Icon name="search" /></button>
    </form>
  </div>

  <!-- Everything a category changes, so a chosen pill can swap it whole. -->
  <div class="post-feed" data-post-feed={endless ? "" : undefined}>
    {/* The heading names the list; the status says what was found, apart from it, so the heading
        is not read out again every time the list is swapped. */}
    {query ? (
      <>
        <div class="post-search__status">
          <h2 class="post-feed__heading">{saying(shared.searchResults)}</h2> <a href={home}>{shared.clearSearch}</a>
        </div>
        <p class="sr-only" role="status">{saying(shared.searchResults)}</p>
      </>
    ) : categoryName && <h2 class="post-feed__heading">{categoryName}</h2>}
    {posts.length > 0 ? (
      <div class="post-grid" data-post-grid style={gridStyle}>
        {posts.map((post, index) => {
          const excerpt = postExcerpt(post, '');
          return (
            <article class="post-card" style={`--card-index: ${index};`}>
              <div class="post-card__cover" aria-hidden="true">
                {post.cover_image
                  ? <img src={post.cover_image} alt="" width={post.coverImage?.width ?? 800} height={post.coverImage?.height ?? 400}
                    {...responsiveAttrs(post.coverImage, cardSizes)} loading={!cursor && index < 3 ? 'eager' : 'lazy'} />
                  : !activeCategory && <span>{post.categories?.[0]?.name ?? name}</span>}
              </div>
              <h2 class="card-title post-card__title">
                <a href={postPath(post)}>{post.title}</a>
              </h2>
              {excerpt && <p class="post-card__excerpt">{excerpt}</p>}
              <p class="post-card__meta">
                <span class="post-card__byline">
                  {profile?.avatarUrl && <img class="post-card__avatar" src={profile.avatarUrl} alt="" width="24" height="24" loading="lazy" />}
                  <span>{byline}</span>
                </span>
                <span class="post-card__when">
                  <span class="post-card__date"><Icon name="clock" /><time datetime={post.published_at ?? post.created_at}>{postDate(post)}</time></span>
                  <span>{readTime(post)}</span>
                </span>
              </p>
            </article>
          );
        })}
      </div>
    ) : !loadError && (
      <p class="post-feed__empty">{query ? saying(shared.noResults) : activeCategory ? <>{copy.emptyCategory} <a href={home}>{copy.all}</a></> : copy.empty}</p>
    )}

    {olderHref && (
      <div class="post-more" data-post-more data-failed={copy.failed} data-loading={copy.loading}>
        <a data-post-next href={olderHref}>{copy.older} <span aria-hidden="true">→</span></a>
        <p data-post-status role="status"></p>
        <button data-post-retry type="button" hidden>{copy.retry}</button>
      </div>
    )}

    {loadError && (
      <p class="post-feed__error" role="alert">
        {copy.unavailable}
      </p>
    )}
  </div>
</section>

<script>
  /* The same arrangement the feed has: fetched only when there is a slider on the page, so
   * the two hero modes that do not rotate do not carry the code that rotates. */
  const slider = document.querySelector<HTMLElement>('[data-hero-slider]');
  if (slider) {
    const { default: wireHeroSlider } = await import('./hero-slider');
    wireHeroSlider(slider);
  }
</script>

<script>
  /*
   * Imported only when there is a feed to wire.
   *
   * A static import puts the feed's code in the page's own script, which a reader downloads
   * whether or not the theme was told to load more as they scroll -- measured, not assumed:
   * post-feed was requested in both states. A dynamic one makes it a chunk of its own, and
   * an owner who switched the setting off is not served the thing they switched off.
   */
  const feed = document.querySelector<HTMLElement>('[data-post-feed]');
  if (feed) {
    const { default: wirePostFeed } = await import('../../lib/post-feed');
    wirePostFeed(feed, document.querySelector<HTMLElement>('[data-post-filter]'));
  }
</script>
