---
import { demoteH1, pageBodyParts, sanitizedContentHtmlSchema, withLeadImage, withResponsiveImages } from '../../../lib/editor-content';
import { PAPER_SIZES } from '../../../lib/responsive-image';
import type { ThemePageProps } from '../../contract';
import { publicCopy } from '../../../lib/i18n';
import PostList from './PostList.astro';

interface Props extends Pick<ThemePageProps, 'page' | 'postLists' | 'preview' | 'profile' | 'settings'> {}

const { page, postLists, preview = false, profile, settings } = Astro.props;
// Keep the document title as the only h1, including when the body contains heading blocks.
const contentHtml = demoteH1(sanitizedContentHtmlSchema.parse(page.content_html));
const parts = pageBodyParts(withLeadImage(withResponsiveImages(contentHtml, page.media ?? [], PAPER_SIZES.article)), postLists ?? []);
const copy = publicCopy(page.locale);
---

<article class="page-article post-page">
  <header>
    {preview && <p class="post-draft-note">{copy.draftPreview}</p>}
    <h1 class="article-title">{page.title}</h1>
  </header>
  {parts.map((part) => part.kind === 'html'
    ? <div class="prose post-body max-w-none prose-headings:font-display prose-a:text-link" set:html={part.html} />
    : settings && <PostList list={part.list} locale={page.locale} profile={profile} settings={settings} />)}
</article>
