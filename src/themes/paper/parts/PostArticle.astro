---
import { demoteH1 } from '../../../lib/editor-content';
import { categoryHref, dateLocale, localePath, publicCopy } from '../../../lib/i18n';
import { articleCover } from '../../../lib/post-cover';
import { readingRail } from '../../../lib/reading-rail';
import { PAPER_SIZES } from '../../../lib/responsive-image';
import type { ThemePostProps } from '../../contract';
import type { PostCategoryBadge, PublicAuthorProfile, SiteSettings } from '../../../types/cms';
import AuthorBlock from './AuthorBlock.astro';
import Icon from '../../../components/Icon.astro';

interface Props {
  /** The theme's `authorLinks` setting: words, icons, or both. */
  authorLinks?: string;
  post: ThemePostProps['post'];
  categories?: PostCategoryBadge[];
  preview?: boolean;
  profile?: PublicAuthorProfile | null;
  /** The theme's `readingProgress` setting: off, the bar across the top, or the rail at the side. */
  readingPosition?: string;
  settings: Pick<SiteSettings, 'site_name' | 'timezone'>;
}

const { authorLinks, categories = [], post, preview = false, profile, readingPosition, settings } = Astro.props;
const { cover, coverAlt, coverPicture, bodyHtml: coverHtml } = articleCover(post, PAPER_SIZES.article);
// The title is the page's one h1, whatever heading level the body was written in.
const demotedHtml = demoteH1(coverHtml);
// The rail and the anchors it links to come from one pass over the body. A post it has nothing
// to list comes back untouched, and is given the bar on every width instead.
const { headings, html: bodyHtml } = readingPosition === 'rail' ? readingRail(demotedHtml) : { headings: [], html: demotedHtml };
const formatter = new Intl.DateTimeFormat(dateLocale(post.locale), {
  day: 'numeric',
  month: 'long',
  timeZone: settings.timezone,
  year: 'numeric',
});
const publishedAt = post.published_at ?? post.created_at;
const primaryDate = preview ? post.updated_at : publishedAt;
const modifiedAt = post.updated_at;
const showModifiedDate = !preview && new Date(modifiedAt).getTime() - new Date(publishedAt).getTime() > 60_000;
const copy = publicCopy(post.locale);
---

{(readingPosition === 'on' || readingPosition === 'rail') && (
  <div class="reading-progress" data-rail={headings.length > 0 ? '' : undefined} aria-hidden="true"></div>
)}
{headings.length > 0 && (
  <nav class="reading-rail" aria-label={copy.onThisPage} data-reading-rail>
    <ul>
      {headings.map(({ id, level, text }) => (
        <li>
          <a href={`#${id}`} class={`reading-rail__link reading-rail__link--h${level}`}>
            <span class="reading-rail__label">{text}</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}

<article class="post-page">
  <a class="post-back" href={localePath(post.locale)}><Icon name="arrowLeft" />{copy.allPosts}</a>
  <header class="post-head">
    <h1 class="article-title">{post.title}</h1>
    {post.meta_description && <p class="lead">{post.meta_description}</p>}
    <div class="post-meta">
      <span>{copy.by} <a href={localePath(post.locale)}>{settings.site_name}</a></span>
      <span class="post-meta__when"><Icon name="clock" /><span>{preview ? copy.lastSaved : copy.published} <time datetime={primaryDate}>{formatter.format(new Date(primaryDate))}</time></span></span>
      {showModifiedDate && (
        <span>{copy.updated} <time datetime={modifiedAt}>{formatter.format(new Date(modifiedAt))}</time></span>
      )}
    </div>
    {categories.length > 0 && (
      <ul class="post-categories" aria-label={copy.categories}>
        {/* Each goes to its category's page; the default category has none, so it stays a word. */}
        {categories.map((category) => <li>{category.is_default ? category.name : <a href={categoryHref(post.locale, category)}>{category.name}</a>}</li>)}
      </ul>
    )}
  </header>
  {cover && (
    <img class="post-cover" src={cover} alt={coverAlt} fetchpriority="high" {...coverPicture} />
  )}
  <div class="prose post-body max-w-none prose-headings:font-display prose-a:text-link" set:html={bodyHtml} />
  {headings.length > 0 && <div data-rail-end aria-hidden="true"></div>}
  {profile && <AuthorBlock linkStyle={authorLinks === 'icons' || authorLinks === 'both' ? authorLinks : 'text'} locale={post.locale} profile={profile} />}
</article>

<script>
  /*
   * Marks the heading being read: the last one whose top is above the line 40% down the window,
   * the first while the reader is above all of them, and the last once the end of the body is
   * on screen, which a short last section would never carry to the line.
   *
   * The observers are only the trigger. Every time one fires, the answer is worked out again
   * from where the headings are, because the order in which entries arrive says nothing about
   * which heading is nearer: an instant jump upward (reduced motion, Home, find-in-page) delivers
   * the heading it lands on and the one it left in the same batch. No scroll listener; scrollend
   * is one event when scrolling has stopped, and catches a jump that crossed the line without any
   * heading being seen in the band.
   */
  const rail = document.querySelector<HTMLElement>('[data-reading-rail]');
  if (rail) {
    const links = [...rail.querySelectorAll<HTMLAnchorElement>('a')];
    const targets = links.map((link) => document.getElementById(link.getAttribute('href')!.slice(1)));
    let atEnd = false;
    const mark = (index: number) => {
      links.forEach((link, at) => {
        if (at === index) link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
        link.toggleAttribute('data-passed', at < index);
      });
    };
    const update = () => {
      let current = 0;
      if (atEnd) current = targets.length - 1;
      else targets.forEach((target, index) => { if (target && target.getBoundingClientRect().top <= window.innerHeight * 0.4) current = index; });
      mark(current);
    };
    const headings = new IntersectionObserver(update, { rootMargin: '0px 0px -60% 0px' });
    for (const target of targets) if (target) headings.observe(target);
    const end = document.querySelector('[data-rail-end]');
    if (end) {
      new IntersectionObserver((entries) => {
        atEnd = entries[entries.length - 1].isIntersecting;
        update();
      }).observe(end);
    }
    window.addEventListener('scrollend', update);
    update();
  }
</script>
