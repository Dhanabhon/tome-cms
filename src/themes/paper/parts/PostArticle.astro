---
import { dateLocale, localePath, publicCopy } from '../../../lib/i18n';
import { articleCover } from '../../../lib/post-cover';
import { readingRail } from '../../../lib/reading-rail';
import type { Post, PostCategoryBadge, PublicAuthorProfile, SiteSettings } from '../../../types/cms';
import AuthorBlock from './AuthorBlock.astro';
import Icon from '../../../components/Icon.astro';

interface Props {
  /** The theme's `authorLinks` setting: words, icons, or both. */
  authorLinks?: string;
  post: Post;
  categories?: PostCategoryBadge[];
  preview?: boolean;
  profile?: PublicAuthorProfile | null;
  /** The theme's `readingProgress` setting: off, the bar across the top, or the rail at the side. */
  readingPosition?: string;
  settings: Pick<SiteSettings, 'site_name' | 'timezone'>;
}

const { authorLinks, categories = [], post, preview = false, profile, readingPosition, settings } = Astro.props;
const { cover, bodyHtml: coverHtml } = articleCover(post);
// The rail and the anchors it links to come from one pass over the body. A post it has nothing
// to list comes back untouched, and is given the bar on every width instead.
const { headings, html: bodyHtml } = readingPosition === 'rail' ? readingRail(coverHtml) : { headings: [], html: coverHtml };
const formatter = new Intl.DateTimeFormat(dateLocale(post.locale), {
  day: 'numeric',
  month: 'long',
  timeZone: settings.timezone,
  year: 'numeric',
});
const publishedAt = post.published_at ?? post.created_at;
const primaryDate = preview ? post.updated_at : publishedAt;
const modifiedAt = post.updated_at;
const showModifiedDate = !preview && new Date(modifiedAt).getTime() - new Date(publishedAt).getTime() > 60_000;
const copy = publicCopy(post.locale);
---

{(readingPosition === 'on' || readingPosition === 'rail') && (
  <div class="reading-progress" data-rail={headings.length > 0 ? '' : undefined} aria-hidden="true"></div>
)}
{headings.length > 0 && (
  <nav class="reading-rail" aria-label={copy.onThisPage} data-reading-rail>
    <ul>
      {headings.map(({ id, level, text }) => (
        <li>
          <a href={`#${id}`} class={`reading-rail__link reading-rail__link--h${level}`}>
            <span class="reading-rail__label">{text}</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}

<article class="post-page">
  <a class="post-back" href={localePath(post.locale)}><Icon name="arrowLeft" />{copy.allPosts}</a>
  <header class="post-head">
    <h1 class="article-title">{post.title}</h1>
    {post.meta_description && <p class="lead">{post.meta_description}</p>}
    <div class="post-meta">
      <span>{copy.by} <a href={localePath(post.locale)}>{settings.site_name}</a></span>
      <span class="post-meta__when"><Icon name="clock" /><span>{preview ? copy.lastSaved : copy.published} <time datetime={primaryDate}>{formatter.format(new Date(primaryDate))}</time></span></span>
      {showModifiedDate && (
        <span>{copy.updated} <time datetime={modifiedAt}>{formatter.format(new Date(modifiedAt))}</time></span>
      )}
    </div>
    {categories.length > 0 && (
      <ul class="post-categories" aria-label={copy.categories}>
        {categories.map((category) => <li>{category.name}</li>)}
      </ul>
    )}
  </header>
  {cover && (
    <img class="post-cover" src={cover} alt={post.title} fetchpriority="high" width="1200" height="675" />
  )}
  <div class="prose post-body max-w-none prose-headings:font-display prose-a:text-link prose-img:rounded-lg" set:html={bodyHtml} />
  {profile && <AuthorBlock linkStyle={authorLinks === 'icons' || authorLinks === 'both' ? authorLinks : 'text'} locale={post.locale} profile={profile} />}
</article>

<script>
  /*
   * Marks the heading being read. One observer, no scroll listener: a heading counts as current
   * from the moment it enters the top of the window until the next one does, and going back up
   * past it hands the mark to the one before.
   */
  const rail = document.querySelector<HTMLElement>('[data-reading-rail]');
  if (rail) {
    const links = [...rail.querySelectorAll<HTMLAnchorElement>('a')];
    const targets = links.map((link) => document.getElementById(link.getAttribute('href')!.slice(1)));
    const inBand = new Set<Element>();
    const mark = (index: number) => {
      links.forEach((link, at) => {
        if (at === index) link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
      });
    };
    const observer = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        const index = targets.indexOf(entry.target as HTMLElement);
        if (entry.isIntersecting) {
          inBand.add(entry.target);
          mark(index);
        } else if (inBand.delete(entry.target) && entry.rootBounds && entry.boundingClientRect.top > entry.rootBounds.top) {
          // It left through the bottom of the band, so the reader went back above it.
          mark(index - 1);
        }
      }
    }, { rootMargin: '0px 0px -60% 0px' });
    for (const target of targets) if (target) observer.observe(target);
  }
</script>
