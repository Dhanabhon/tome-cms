---
import type { PublicNavigationItem } from '../../../types/cms';
import { isLink } from '../../../lib/navigation-current';
import { currentYear, localePath, publicCopy } from '../../../lib/i18n';
import { OFFICIAL_REPOSITORY_URL } from '../../../update/contracts';
import type { PostLocale } from '../../../types/cms';

interface Props {
  locale: PostLocale;
  items?: PublicNavigationItem[];
  /** The owner can switch the credit off; a site that has never been asked shows it. */
  showPoweredBy?: boolean;
  siteName?: string;
}

const { locale, items = [], showPoweredBy = true, siteName = 'TomeCMS' } = Astro.props;
const copy = publicCopy(locale);
// The footer is flat: the menu builder gives it links only, never a group or a sub-item.
const links = items.filter(isLink);
// The one word of the credit that is a link is where {tomecms} stands.
const [creditBefore, creditAfter] = copy.poweredBy.split('{tomecms}');
---

<footer class="site-footer mx-auto w-full max-w-7xl border-t border-line px-5 py-7 text-sm text-muted sm:px-7">
  {links.length > 0 && (
    <nav aria-label={copy.footerNavigation} class="public-navigation">
      <ul>{links.map(({ href, label, newTab }) => <li><a aria-current={href === Astro.url.pathname ? 'page' : undefined} href={href} rel={newTab ? 'noopener noreferrer' : undefined} target={newTab ? '_blank' : undefined}>{label}{newTab && <span class="sr-only"> {copy.opensInNewTab}</span>}</a></li>)}</ul>
    </nav>
  )}
  <p>
    &copy; {currentYear(locale)} <a href={localePath(locale)}>{siteName}</a>. {copy.allRightsReserved}
  </p>
  {showPoweredBy && <p class="site-footer__credit">{creditBefore}<a href={OFFICIAL_REPOSITORY_URL} rel="noopener noreferrer" target="_blank">TomeCMS<span class="sr-only"> {copy.opensInNewTab}</span></a>{creditAfter}</p>}
</footer>
