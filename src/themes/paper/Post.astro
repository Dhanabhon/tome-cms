---
import PostArticle from './parts/PostArticle.astro';
import type { ThemePostProps } from '../contract';

interface Props extends ThemePostProps {}

const { categories, post, preview, profile, settings, themeSettings } = Astro.props;
---

<PostArticle authorLinks={themeSettings.authorLinks} categories={categories} post={post} preview={preview} profile={profile} readingPosition={themeSettings.readingProgress} settings={settings} />
