---
import { demoteH1, sanitizedContentHtmlSchema, withLeadImage, withResponsiveImages } from '../../lib/editor-content';
import { ALMANAC_SIZES } from '../../lib/responsive-image';
import { publicCopy } from '../../lib/i18n';
import type { ThemePageProps } from '../contract';

/** The post's reading column with only the title above the body: a page has no category, no
 *  date to keep and no progress to show. */
interface Props extends ThemePageProps {}

const { page, preview } = Astro.props;
// Keep the document title as the only h1, including when the body contains heading blocks.
const contentHtml = demoteH1(sanitizedContentHtmlSchema.parse(page.content_html));
const copy = publicCopy(page.locale);
---

<article class="almanac-article">
  <header class="almanac-article__head">
    {preview && <p class="almanac-article__draft">{copy.draftPreview}</p>}
    <h1 class="almanac-article__title">{page.title}</h1>
  </header>
  <div class="almanac-prose" set:html={withLeadImage(withResponsiveImages(contentHtml, page.media ?? [], ALMANAC_SIZES.article))} />
</article>
