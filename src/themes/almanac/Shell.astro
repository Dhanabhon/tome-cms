---
import Footer from './parts/Footer.astro';
import Header from './parts/Header.astro';
import type { ThemeShellProps } from '../contract';

/**
 * Everything inside `<body>`. The class is what the stylesheet keys Almanac's palette and face
 * to, on the document as a whole, so a page is only ever drawn in them when this theme drew it.
 */
interface Props extends ThemeShellProps {}

const { allowVisitorTheme, alternates, brand, footer, header, locale, showPoweredBy, siteName, theme } = Astro.props;
---

<body class="almanac">
  <slot name="above" />
  <Header brand={brand} items={header} locale={locale} siteName={siteName} />
  <main class="almanac-main">
    <slot />
  </main>
  <Footer
    allowVisitorTheme={allowVisitorTheme}
    availableLocales={alternates}
    items={footer}
    locale={locale}
    showPoweredBy={showPoweredBy}
    siteName={siteName}
    theme={theme}
  />
</body>
