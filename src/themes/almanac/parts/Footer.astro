---
import LanguageSwitcher from '../../../components/LanguageSwitcher.astro';
import SiteNavLink from '../../../components/SiteNavLink.astro';
import ThemeToggle from '../../../components/ThemeToggle.astro';
import { currentYear, localePath, publicCopy } from '../../../lib/i18n';
import { isLink } from '../../../lib/navigation-current';
import { THEME_LABELS, type ThemeChoice } from '../../../lib/theme';
import { OFFICIAL_REPOSITORY_URL } from '../../../update/contracts';
import type { PostAlternate, PostLocale, PublicNavigationItem } from '../../../types/cms';

interface Props {
  allowVisitorTheme: boolean;
  availableLocales: PostAlternate[];
  items: PublicNavigationItem[];
  locale: PostLocale;
  /** The owner can switch the credit off; a site that has never been asked shows it. */
  showPoweredBy: boolean;
  siteName: string;
  /** What the server rendered, so the control is not briefly checked on the wrong option. */
  theme: ThemeChoice;
}

/**
 * One slim row: the year, the site and the credit on one line at the left; the footer menu, the
 * language and the theme at the right. The header has neither switch, so these are the page's
 * only ones, and their document-wide ids are theirs alone.
 */
const { allowVisitorTheme, availableLocales, items, locale, showPoweredBy, siteName, theme } = Astro.props;
const copy = publicCopy(locale);
// The footer is flat: the menu builder gives it links only, never a group or a sub-item.
const links = items.filter(isLink);
const languageOptions = availableLocales
  .filter(({ locale: optionLocale }) => optionLocale === 'en' || optionLocale === 'th')
  .sort((left, right) => left.locale.localeCompare(right.locale));
// The one word of the credit that is a link is where {tomecms} stands.
const [creditBefore, creditAfter] = copy.poweredBy.split('{tomecms}');
---

<footer class="almanac-footer">
  <div class="almanac-footer__inner almanac-frame">
    <p class="almanac-footer__line">&copy; {currentYear(locale)} <a href={localePath(locale)}>{siteName}</a>{showPoweredBy && (
      <> <span aria-hidden="true" class="almanac-footer__dot">•</span> {creditBefore}<a href={OFFICIAL_REPOSITORY_URL} rel="noopener noreferrer" target="_blank">TomeCMS<span class="sr-only"> {copy.opensInNewTab}</span></a>{creditAfter}</>
    )}</p>
    <div class="almanac-footer__end">
      {links.length > 0 && (
        <nav aria-label={copy.footerNavigation} class="almanac-footer__nav">
          <ul>{links.map((item) => <li><SiteNavLink copy={copy} currentPath={Astro.url.pathname} item={item} /></li>)}</ul>
        </nav>
      )}
      {languageOptions.length > 1 && <LanguageSwitcher currentLocale={locale} options={languageOptions} />}
      {allowVisitorTheme && <ThemeToggle initial={theme} labels={THEME_LABELS[locale]} name="tome-theme-site" />}
    </div>
  </div>
</footer>
