---
import { categoryHref, localePath, publicCopy } from '../../../lib/i18n';
import type { PostCategoryBadge, PostLocale } from '../../../types/cms';

interface Props {
  activeCategory: string | undefined;
  categories: PostCategoryBadge[];
  locale: PostLocale;
}

/**
 * The pills. The data attributes are the ones Paper's row carries, which is what lib/post-feed.ts
 * looks for: a pill swaps the list in place with it, and is a plain link to the category's page
 * without it. The search is the header's.
 */
const { activeCategory, categories, locale } = Astro.props;
const copy = publicCopy(locale);
const home = localePath(locale);
const isCurrent = (name: string) => activeCategory?.toLocaleLowerCase() === name.toLocaleLowerCase();
---

{categories.length > 0 && (
  <nav class="almanac-pills" aria-label={copy.categories} data-post-filter data-announce={copy.showing}>
    <ul>
      <li><a href={home} aria-current={activeCategory ? undefined : 'page'}>{copy.allPosts}</a></li>
      {categories.map((category) => (
        <li><a href={categoryHref(locale, category)} aria-current={isCurrent(category.name) ? 'page' : undefined}>{category.name}</a></li>
      ))}
    </ul>
    <p class="sr-only" role="status" data-post-filter-status></p>
  </nav>
)}
