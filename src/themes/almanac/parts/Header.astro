---
import Icon from '../../../components/Icon.astro';
import SiteBrand from '../../../components/SiteBrand.astro';
import SiteNavLink from '../../../components/SiteNavLink.astro';
import SiteSubmenu from '../../../components/SiteSubmenu.astro';
import SubmenuScript from '../../../components/SubmenuScript.astro';
import { localePath, publicCopy } from '../../../lib/i18n';
import { isCurrentSection, isLink } from '../../../lib/navigation-current';
import { searchQuery } from '../../../lib/search-query';
import type { PostLocale, PublicNavigationItem } from '../../../types/cms';
import type { ThemeBrand } from '../../contract';

interface Props {
  brand: ThemeBrand;
  items: PublicNavigationItem[];
  locale: PostLocale;
  siteName: string;
}

/**
 * The brand with the menu right after it, and the search at the row's end. The language and the
 * theme are the footer's. The menu is drawn by the same shared pieces as Paper's, so a sub-menu
 * behaves on an Almanac page exactly as it does on a Paper one.
 *
 * The search is a plain GET form to the home page, which is what lib/post-feed.ts looks for. On a
 * phone with scripting it folds behind a button, from the first paint, so nothing shifts when the
 * script below arrives; without scripting there is no button and the field stays open.
 */
const { brand, items, locale, siteName } = Astro.props;
const copy = publicCopy(locale);
const home = localePath(locale);
const currentPath = Astro.url.pathname;
// What a results page was searched for stays in the box, as the words the home page looked for.
const query = searchQuery(Astro.url.searchParams.get('q')) ?? '';
---

<header class="almanac-header">
  <div class="almanac-header__inner almanac-frame">
    <a class="almanac-brand" href={home}><SiteBrand brand={brand} siteName={siteName} /></a>
    {items.length > 0 && (
      <nav aria-label={copy.primaryNavigation} class="almanac-nav almanac-header__desktop">
        <ul>{items.map((item) => item.children.length ? <SiteSubmenu copy={copy} currentPath={currentPath} item={item} />
          : isLink(item) && <li><SiteNavLink copy={copy} currentPath={currentPath} item={item} /></li>)}</ul>
      </nav>
    )}
    {items.some(({ children }) => children.length) && <SubmenuScript />}
    {items.length > 0 && (
      <details class="almanac-header__mobile">
        <summary>{copy.menu}</summary>
        <nav aria-label={copy.primaryNavigation} class="almanac-nav">
          {/* A phone lists every sub-item under its parent: the Menu is already the one tap. */}
          <ul>{items.map((item) => {
            const section = isCurrentSection(item, currentPath);
            return (
              <li>
                {isLink(item) ? <SiteNavLink copy={copy} currentPath={currentPath} item={item} section={section} />
                  : <span aria-current={section ? 'true' : undefined} class="almanac-nav__group">{item.label}</span>}
                {item.children.length > 0 && <ul>{item.children.filter(isLink).map((child) => <li><SiteNavLink copy={copy} currentPath={currentPath} item={child} /></li>)}</ul>}
              </li>
            );
          })}</ul>
        </nav>
      </details>
    )}
    <button aria-controls="almanac-search" aria-expanded="false" aria-label={copy.searchLabel} class="almanac-search-toggle" title={copy.searchLabel} type="button"><Icon name="search" /></button>
    <form class="almanac-search" id="almanac-search" role="search" method="get" action={home} data-post-search>
      <label class="sr-only" for="almanac-search-q">{copy.searchLabel}</label>
      <input id="almanac-search-q" name="q" type="search" value={query} maxlength="100" placeholder={copy.searchLabel} autocomplete="off" enterkeyhint="search" />
      <button class="almanac-search__submit" type="submit" aria-label={copy.search} title={copy.search}><Icon name="search" /></button>
    </form>
  </div>
</header>

<script>
  /*
   * On a phone the search is a disclosure: the button shows the field and hands it focus, and a
   * second press or Escape puts it away, with focus back on the button. The stylesheet draws the
   * button only on a phone with scripting on; a wide screen always has the field.
   */
  const toggle = document.querySelector<HTMLButtonElement>('.almanac-search-toggle');
  const form = document.querySelector<HTMLFormElement>('#almanac-search');
  if (toggle && form) {
    const field = form.querySelector('input')!;
    const show = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      if (open) field.focus();
    };
    toggle.addEventListener('click', () => show(toggle.getAttribute('aria-expanded') !== 'true'));
    const close = (event: KeyboardEvent) => {
      if (event.key !== 'Escape' || toggle.getAttribute('aria-expanded') !== 'true') return;
      // Not the field's own Escape, which would empty it: the words are kept for the next time.
      event.preventDefault();
      show(false);
      toggle.focus();
    };
    toggle.addEventListener('keydown', close);
    form.addEventListener('keydown', close);
  }
</script>
