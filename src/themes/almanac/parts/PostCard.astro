---
import { postPath } from '../../../lib/i18n';
import { postExcerpt, postReadingMinutes } from '../../../lib/posts';
import type { PostLocale } from '../../../types/cms';
import type { ThemeHomePost } from '../../contract';
import { cardMeta, cardPanel } from '../home';

interface Props {
  /** The cover is asked for at once, and shown without a fade: the first row of page one. */
  eager: boolean;
  /** The one cover asked for first: page one's largest paint, measured with the hero above it
   *  too, at 390 px as at 1440 -- a 16:9 cover outweighs the headline. */
  first: boolean;
  locale: PostLocale;
  /** A coverless band names its category; on that category's own list it is its tone alone. */
  named: boolean;
  post: ThemeHomePost;
  siteName: string;
  timezone: string;
}

/**
 * One post as one link. Its name is the title alone: the band's category, the excerpt and the
 * meta line are read inside the link but are not what it is called. The cover is decoration, so
 * its alt is empty on purpose: inside a link already named by the title, the media's alt would
 * only be read as a second name, or not at all.
 */
const { eager, first, locale, named, post, siteName, timezone } = Astro.props;
const excerpt = postExcerpt(post, '');
const published = post.published_at ?? post.created_at;
const meta = cardMeta(postReadingMinutes(post), published, locale, timezone);
const panel = post.cover_image ? null : cardPanel(post, siteName);
const titleId = `card-${post.id}`;
---

<article class="almanac-card">
  <a class="almanac-card__link" href={postPath(post)} aria-labelledby={titleId}>
    {post.cover_image ? (
      <div class="almanac-card__panel" aria-hidden="true">
        <img src={post.cover_image} alt="" width="800" height="450" decoding="async" fetchpriority={first ? 'high' : undefined} loading={eager ? 'eager' : 'lazy'} />
      </div>
    ) : panel && (
      <p class="almanac-card__band" aria-hidden={named ? undefined : 'true'} style={`--card-tone: var(--almanac-tone-${panel.tone}); --card-tone-ink: var(--almanac-tone-${panel.tone}-ink);`}>
        {named && <span>{panel.name}</span>}
      </p>
    )}
    <div class="almanac-card__body">
      <h3 class="almanac-card__title" id={titleId}>{post.title}</h3>
      {excerpt && <p class="almanac-card__excerpt">{excerpt}</p>}
      <p class="almanac-card__meta">
        <span>{meta.reading}</span> <span aria-hidden="true">·</span> <time datetime={published}>{meta.date}</time>
      </p>
    </div>
  </a>
</article>
