---
import CategoryRow from './parts/CategoryRow.astro';
import Hero from './parts/Hero.astro';
import PostCard from './parts/PostCard.astro';
import { heroLink } from './home';
import { localePath, postPath, publicCopy } from '../../lib/i18n';
import type { ThemeHomeProps } from '../contract';
import { listHref } from '../list-href';

interface Props extends ThemeHomeProps {}

const { activeCategory, categories, category, cursor, loadError, locale, nextCursor, posts, query, siteName, tagline, themeSettings, timezone } = Astro.props;
const copy = publicCopy(locale);
const home = localePath(locale);
// The first page only, and not for a search or a category: whoever asked for a list wants it first.
const showHero = themeSettings.hero !== 'off' && !cursor && !query && !activeCategory;
const newest = posts[0];
// Never an empty h1: a site with no name yet is called what the route calls it.
const name = siteName.trim() || 'TomeCMS';
// The owner's words, or the theme's in the language the page is read in.
const text = (key: string, fallback: string) => themeSettings[key]?.trim() || fallback;
// With no headline the tagline is the h1, rather than the site's name said again under the header,
// and the line under it is only the owner's own, so the tagline is not said twice either.
const headline = themeSettings.heroHeadline?.trim();
// Paper's words for it: the core's copy has no "try again".
const tryAgain = locale === 'th' ? 'ลองอีกครั้ง' : 'Try again';

const olderHref = nextCursor ? listHref(home, Astro.props, nextCursor) : null;
// The reader's words go into a sentence as text, whatever they contain.
const saying = (template: string) => template.replace('{query}', () => query ?? '');
// The category as the site names it, not as the address happened to spell it.
const categoryName = activeCategory
  && (categories.find(({ name }) => name.toLocaleLowerCase() === activeCategory.toLocaleLowerCase())?.name ?? activeCategory);
// A search or a category says what the list is; the plain list is named for a screen reader only.
const heading = query ? saying(copy.searchResults) : categoryName || copy.latestPosts;
---

{showHero ? (
  <Hero
    headline={headline || tagline}
    lead={headline ? text('heroLead', tagline) : text('heroLead', '')}
    primary={{ href: heroLink(themeSettings.primaryLink, newest ? postPath(newest) : null), label: text('primaryLabel', copy.startReading) }}
    secondary={{ href: heroLink(themeSettings.secondaryLink, `${home}#posts`), label: text('secondaryLabel', copy.allPosts) }}
  />
) : (
  <h1 class="sr-only">{name}</h1>
)}

<section class="almanac-frame almanac-home" id="posts">
  <CategoryRow activeCategory={activeCategory} categories={categories} locale={locale} />

  <!-- Everything a pill changes, so a chosen one can swap it whole: the heading goes with it. -->
  <div class="almanac-feed" data-post-feed>
    <h2 class:list={['almanac-feed__heading', { 'sr-only': !query && !categoryName }]}>{heading}</h2>
    {query && <p class="almanac-feed__clear"><a href={home}>{copy.clearSearch}</a></p>}
    {category?.description && <p class="almanac-feed__description">{category.description}</p>}

    {posts.length > 0 ? (
      <div class="almanac-grid">
        {posts.map((post, index) => (
          <PostCard eager={!cursor && index < 3} first={!cursor && index === 0} locale={locale} named={!activeCategory} post={post} siteName={name} timezone={timezone} />
        ))}
      </div>
    ) : !loadError && (
      <p class="almanac-feed__empty">{query ? saying(copy.noResults) : activeCategory ? <>{copy.noPostsInCategory} <a href={home}>{copy.allPosts}</a></> : copy.noPosts}</p>
    )}

    {olderHref && <p class="almanac-more"><a class="almanac-button almanac-button--secondary" href={olderHref}>{copy.morePosts} <span aria-hidden="true">→</span></a></p>}

    {loadError && <p class="almanac-feed__empty" role="alert">{copy.postsUnavailable} <a href={`${Astro.url.pathname}${Astro.url.search}`}>{tryAgain}</a></p>}
  </div>
</section>

<script>
  /*
   * The pills swap the list in place with the feed code Paper's row uses, imported only when
   * there is a list to swap. The feed carries no "more" marker, so it adds no rows as the reader
   * scrolls: "More posts" stays a link.
   */
  const feed = document.querySelector<HTMLElement>('[data-post-feed]');
  if (feed) {
    const { default: wirePostFeed } = await import('../../lib/post-feed');
    wirePostFeed(feed, document.querySelector<HTMLElement>('[data-post-filter]'));
  }
</script>
