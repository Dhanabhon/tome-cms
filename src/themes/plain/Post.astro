---
import { demoteH1 } from '../../lib/editor-content';
import { categoryHref, dateLocale, localePath, publicCopy } from '../../lib/i18n';
import { articleCover } from '../../lib/post-cover';
import { PLAIN_SIZES } from '../../lib/responsive-image';
import type { ThemePostProps } from '../contract';

interface Props extends ThemePostProps {}

const { categories, post, preview, profile, settings } = Astro.props;
const copy = publicCopy(post.locale);
const { cover, coverAlt, coverPicture, bodyHtml } = articleCover(post, PLAIN_SIZES.article);
const formatter = new Intl.DateTimeFormat(dateLocale(post.locale), { dateStyle: 'long', timeZone: settings.timezone });
const when = preview ? post.updated_at : post.published_at ?? post.created_at;
---

<article class="plain-page plain-article">
  <p class="plain-back"><a href={localePath(post.locale)}>← {copy.allPosts}</a></p>
  <h1>{post.title}</h1>
  <p class="plain-meta">
    <span>{copy.by} {profile?.name || settings.site_name}</span>
    <span>{preview ? copy.lastSaved : copy.published} <time datetime={when}>{formatter.format(new Date(when))}</time></span>
    {/* Each goes to its category's page; the default category has none, so it stays a word. */}
    {categories.length > 0 && (
      <span>{categories.map((category, index) => (
        <>{index > 0 && ', '}{category.is_default ? category.name : <a href={categoryHref(post.locale, category)}>{category.name}</a>}</>
      ))}</span>
    )}
  </p>
  {/* The picture is described by the alt text it has in the library, and is decoration without one: the title is the h1 just above it, and saying it again would only be heard twice. */}
  {cover && <img src={cover} alt={coverAlt} fetchpriority="high" {...coverPicture} />}
  <div class="plain-body" set:html={demoteH1(bodyHtml)} />
  {profile?.bio && (
    <footer class="plain-author">
      <h2>{copy.aboutTheAuthor}</h2>
      <p>{profile.bio}</p>
    </footer>
  )}
</article>
