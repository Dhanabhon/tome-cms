---
import Icon from '../../components/Icon.astro';
import { dateLocale, localePath, postPath, publicCopy } from '../../lib/i18n';
import { postExcerpt } from '../../lib/posts';
import type { Post } from '../../types/cms';
import type { ThemeHomeProps } from '../contract';
import { leadsWith } from './lead';

interface Props extends ThemeHomeProps {}

const { activeCategory, categories, cursor, loadError, locale, nextCursor, posts, query, siteName, tagline, timezone } = Astro.props;
const copy = publicCopy(locale);
// Never an empty h1: a site with no name yet is called what the route calls it, as in Almanac.
const name = siteName.trim() || 'TomeCMS';
const home = localePath(locale);
const formatter = new Intl.DateTimeFormat(dateLocale(locale), { dateStyle: 'long', timeZone: timezone });
// The same list -- its category, its search -- from its newest post, or from where a page stopped.
const listHref = (from?: string) => {
  const search = `${new URLSearchParams({ ...(activeCategory ? { category: activeCategory } : {}), ...(query ? { q: query } : {}), ...(from ? { cursor: from } : {}) })}`;
  return search ? `${home}?${search}` : home;
};
const olderHref = nextCursor ? listHref(nextCursor) : null;
// A page knows the next one's cursor but not the last one's, so the way back is to the newest.
const newestHref = cursor ? listHref() : null;
// The reader's words go into a sentence as text, whatever they contain.
const saying = (template: string) => template.replace('{query}', () => query ?? '');
// A category filter narrows the list but not the lead: the newest post in it leads.
const leads = leadsWith({ cursor, posts: posts.length, query });
const lead = leads ? posts[0] : undefined;
const rest = leads ? posts.slice(1) : posts;
const leadExcerpt = lead && postExcerpt(lead, '');
const when = (post: Post) => post.published_at ?? post.created_at;
---

<div class="plain-page">
  <h1 class="sr-only">{name}</h1>
  {tagline && <p class="plain-tagline">{tagline}</p>}

  <div class="plain-controls">
    <form class="plain-search" role="search" method="get" action={home}>
      <label class="sr-only" for="plain-search-q">{copy.searchLabel}</label>
      <input id="plain-search-q" name="q" type="search" value={query ?? ''} maxlength="100" placeholder={copy.searchLabel} autocomplete="off" enterkeyhint="search" />
      <button class="plain-search__submit" type="submit" aria-label={copy.search} title={copy.search}><Icon name="search" /></button>
    </form>
    {categories.length > 0 && (
      <nav class="plain-filter" aria-label={copy.categories}>
        <a href={home} aria-current={activeCategory || query ? undefined : 'page'}>{copy.allPosts}</a>
        {categories.map(({ name }) => (
          <a href={`${home}?${new URLSearchParams({ category: name })}`} aria-current={activeCategory?.toLocaleLowerCase() === name.toLocaleLowerCase() ? 'page' : undefined}>{name}</a>
        ))}
      </nav>
    )}
  </div>
  {query && <p class="plain-search-status" role="status">{saying(copy.searchResults)} · <a href={home}>{copy.clearSearch}</a></p>}
  {loadError && <p class="plain-empty" role="alert">{copy.postsUnavailable}</p>}

  {lead && (
    <article class="plain-lead">
      <h2><a href={postPath(lead)}>{lead.title}</a></h2>
      <time datetime={when(lead)}>{formatter.format(new Date(when(lead)))}</time>
      {leadExcerpt && <p>{leadExcerpt}</p>}
    </article>
  )}

  {rest.length > 0 && (
    <ol class="plain-grid">
      {rest.map((post) => {
        const excerpt = postExcerpt(post, '');
        return (
          <li>
            <h2><a href={postPath(post)}>{post.title}</a></h2>
            <time datetime={when(post)}>{formatter.format(new Date(when(post)))}</time>
            {excerpt && <p>{excerpt}</p>}
          </li>
        );
      })}
    </ol>
  )}

  {posts.length === 0 && !loadError && (
    <p class="plain-empty">{query ? saying(copy.noResults) : activeCategory ? <>{copy.noPostsInCategory} <a href={home}>{copy.allPosts}</a></> : copy.noPosts}</p>
  )}

  {(newestHref || olderHref) && (
    <p class="plain-more">
      {newestHref && <a href={newestHref}><span aria-hidden="true">←</span> {copy.latestPosts}</a>}
      {olderHref && <a href={olderHref}>{copy.morePosts} <span aria-hidden="true">→</span></a>}
    </p>
  )}
</div>

<script>
  /*
   * Below 64rem the tabs scroll sideways. A page arrives with the row at its start, so the chosen
   * tab is brought into it, and the reader sees which list this is; and a tab the keyboard reaches
   * is brought in whole, clear of the edge by the row's scroll-padding: the browser's own scroll on
   * focus left the last tab cut by the edge at 768px (tests/e2e/home-search.spec.ts). A wide row is
   * all in view, and neither moves it.
   */
  const row = document.querySelector<HTMLElement>('.plain-filter');
  const show = (tab: Element | null | undefined) => tab?.scrollIntoView({ block: 'nearest', inline: 'nearest' });
  show(row?.querySelector('[aria-current="page"]'));
  row?.addEventListener('focusin', (event) => show(event.target as Element));
</script>
