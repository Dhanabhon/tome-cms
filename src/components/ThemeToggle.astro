---
import { THEME_CHOICES, THEME_STORAGE_KEY, type ThemeChoice } from '../lib/theme';

/**
 * The reader's own light/dark choice, stored on their device: a round button that shows the
 * choice in force, and a panel that floats from it with the three to choose from.
 *
 * The panel is a fieldset of native radios, made a popover. Three mutually exclusive options
 * is exactly what a radio group is, and it arrives with arrow-key navigation, grouping and
 * announcement already working; the popover adds closing on a click outside or on Escape, with
 * focus handed back to the button. A browser without popovers never hides the panel, so there
 * it is the row of three this control used to be, and the button is not drawn.
 *
 * The legend names the group for a screen reader but is not drawn -- the icons and labels
 * already say what the control is.
 */
interface Props {
  /** What the server rendered. The inline theme script corrects it from storage. */
  initial?: ThemeChoice;
  labels: Record<'group' | ThemeChoice, string>;
  /**
   * Radio names, the panel's id and the anchor that tethers it are all document-wide, so two
   * toggles sharing one would fight over them. The admin shell renders one for the sidebar and
   * one for the mobile drawer, so each instance needs its own.
   */
  name: string;
}

const { initial = 'system', labels, name } = Astro.props;
const panel = `${name}-panel`;
/** Each choice's icon, drawn on the button and again beside its option. Constants only. */
const GLYPHS: Record<ThemeChoice, string> = {
  system: '<rect height="9" rx="1.4" width="13" x="1.5" y="2" /><path d="M6 13.5h4" stroke-linecap="round" />',
  light: '<circle cx="8" cy="8" r="3.1" /><path d="M8 1v1.6M8 13.4V15M1 8h1.6M13.4 8H15M3.1 3.1l1.1 1.1M11.8 11.8l1.1 1.1M12.9 3.1l-1.1 1.1M4.2 11.8l-1.1 1.1" stroke-linecap="round" />',
  dark: '<path d="M13.4 9.6A5.8 5.8 0 0 1 6.4 2.6a5.8 5.8 0 1 0 7 7Z" stroke-linejoin="round" />',
};
---
<div class="ui-theme" data-theme-toggle>
  <button
    aria-label={`${labels.group}: ${labels[initial]}`}
    class="ui-theme__trigger"
    popovertarget={panel}
    style={`anchor-name: --${name}`}
    type="button"
  >
    <span aria-hidden="true" class="ui-theme__glyphs">
      {THEME_CHOICES.map((choice) => (
        <svg
          class={`ui-theme__glyph ui-theme__glyph--${choice}`}
          fill="none"
          height="18"
          stroke="currentColor"
          stroke-width="1.6"
          viewBox="0 0 16 16"
          width="18"
          set:html={GLYPHS[choice]}
        ></svg>
      ))}
    </span>
  </button>
  <fieldset class="ui-theme__panel" id={panel} popover="auto" style={`position-anchor: --${name}`}>
    <legend class="ui-theme__legend">{labels.group}</legend>
    {THEME_CHOICES.map((choice) => (
      <label class="ui-theme__option">
        <input
          checked={choice === initial}
          class="ui-theme__input"
          name={name}
          type="radio"
          value={choice}
        />
        <span aria-hidden="true" class="ui-theme__icon">
          <svg fill="none" height="15" stroke="currentColor" stroke-width="1.6" viewBox="0 0 16 16" width="15" set:html={GLYPHS[choice]}></svg>
        </span>
        <span class="ui-theme__label">{labels[choice]}</span>
        <svg aria-hidden="true" class="ui-theme__check" fill="none" height="14" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 16 16" width="14">
          <path d="m3.5 8.5 3 3 6-7" />
        </svg>
      </label>
    ))}
  </fieldset>
</div>

<script is:inline define:vars={{ key: THEME_STORAGE_KEY }}>
  (function () {
    var root = document.documentElement;
    if (root.dataset.themeWired) return;
    root.dataset.themeWired = 'on';
    // Anchor positioning tethers a panel to its button in CSS alone. Without it, the panel is
    // placed from the button's box as it opens, the way the stylesheet would: under the button
    // unless it sits in the bottom half of the window, and lined up with the button's end
    // unless the panel would then run off the start of the window.
    var anchored = Boolean(window.CSS && CSS.supports('anchor-name: --theme'));

    document.querySelectorAll('[data-theme-toggle]').forEach(function (group) {
      var trigger = group.querySelector('.ui-theme__trigger');
      var panel = group.querySelector('.ui-theme__panel');
      var viaPointer = false;

      // The button's icon is not read out, so its name says which choice is in force.
      function announce(input) {
        var label = input.closest('label').querySelector('.ui-theme__label').textContent;
        trigger.setAttribute('aria-label', group.querySelector('.ui-theme__legend').textContent + ': ' + label);
      }

      // Reflect what the inline head script actually applied, so the checked option never
      // disagrees with the colours on screen.
      var applied = root.dataset.theme === 'light' || root.dataset.theme === 'dark' ? root.dataset.theme : 'system';
      var current = group.querySelector('input[value="' + applied + '"]');
      if (current) {
        current.checked = true;
        announce(current);
      }

      panel.addEventListener('pointerdown', function () { viaPointer = true; });
      panel.addEventListener('keydown', function () { viaPointer = false; });
      group.addEventListener('change', function (event) {
        var value = event.target.value;
        if (value === 'light' || value === 'dark') root.dataset.theme = value;
        else delete root.dataset.theme;
        announce(event.target);
        try {
          localStorage.setItem(key, value);
        } catch (error) {
          /* Storage can be blocked. The choice still applies for this page view. */
        }
        // A choice made with a pointer is done. One made with the arrow keys may be the first
        // of several, so the panel stays until Escape.
        if (viaPointer && typeof panel.hidePopover === 'function' && panel.matches(':popover-open')) panel.hidePopover();
        viaPointer = false;
      });

      if (anchored) return;
      panel.addEventListener('beforetoggle', function (event) {
        if (event.newState !== 'open') return;
        var box = trigger.getBoundingClientRect();
        var gap = 4;
        var below = box.top < window.innerHeight / 2;
        var fromEnd = box.right >= (parseFloat(getComputedStyle(panel).minWidth) || 0);
        panel.style.top = below ? box.bottom + gap + 'px' : 'auto';
        panel.style.bottom = below ? 'auto' : window.innerHeight - box.top + gap + 'px';
        panel.style.left = fromEnd ? 'auto' : box.left + 'px';
        panel.style.right = fromEnd ? window.innerWidth - box.right + 'px' : 'auto';
      });
    });
  })();
</script>
