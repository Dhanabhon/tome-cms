---
import type { AdminCopy } from '../../../lib/admin-i18n';
import { STATS_RANGES, statsHref, type StatsQuery } from '../../../server/stats/report';
import UiSelect from '../UiSelect';

interface Props {
  base: string;
  copy: AdminCopy;
  /** One article is in one language, so its own screen has none to choose. */
  languages?: boolean;
  query: StatsQuery;
}

const { base, copy, languages = true, query } = Astro.props;
---

<div class="stats-filters">
  <nav aria-label={copy.stats.rangeLabel} class="stats-segments">
    {/* The name starts with what is shown, so "7d" said aloud still finds the link, and goes on to say it in full. */}
    {STATS_RANGES.map((range) => (
      <a aria-current={query.range === range ? 'true' : undefined} aria-label={`${copy.stats.rangesShort[range]}, ${copy.stats.ranges[range]}`} href={statsHref(base, query, { page: 1, range })}>
        {copy.stats.rangesShort[range]}
      </a>
    ))}
  </nav>
  {languages && (
    <form class="admin-list-filter" action={base} method="get" novalidate>
      {/* The address statsHref would build: a default is left out, and a new language starts at page 1. */}
      {query.range !== '30d' && <input type="hidden" name="range" value={query.range} />}
      <UiSelect
        client:load
        ariaLabel={copy.stats.language}
        className="admin-control admin-list-filter__select"
        defaultValue={query.lang ?? 'all'}
        id="stats-lang"
        name="lang"
        options={[
          { label: copy.stats.allLanguages, value: 'all' },
          { label: copy.stats.languages.th, value: 'th' },
          { label: copy.stats.languages.en, value: 'en' },
        ]}
        submitOnChange
      />
      {query.sort !== 'views' && <input type="hidden" name="sort" value={query.sort} />}
    </form>
  )}
</div>
