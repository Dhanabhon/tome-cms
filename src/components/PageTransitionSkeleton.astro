---
import type { AdminSkeletonKind } from '../lib/admin-transition';
import AdminSkeleton from './admin/AdminSkeleton.astro';

interface Props {
  label: string;
}

const { label } = Astro.props;
const kinds: AdminSkeletonKind[] = ['posts', 'pages', 'list', 'media', 'form', 'editor'];
---

<!-- Stands in for the next admin page while it is on the way, in that page's shape: the
     overlay picks the skeleton for where the link leads. It covers only what the next page
     redraws -- a sidebar and a top bar already on screen stay uncovered, and the top bar
     names the screen on the way -- so nothing that stays put flickers. -->
<div class="admin-transition" data-page-transition hidden popover="manual">
  <div class="admin-transition__frame" data-transition-frame></div>
  {kinds.map((kind) => (
    <template data-skeleton={kind}><AdminSkeleton kind={kind} label={label} /></template>
  ))}
  <template data-skeleton-rail>
    <div class="admin-transition__rail" aria-hidden="true">
      <span class="skeleton admin-transition__brand"></span>
      <span class="skeleton skeleton--control"></span>
      {[40, 70, 60, 75, 55, 40, 65, 70, 50, 60].map((width) => <span class="skeleton-line" style={`--skeleton-width: ${width}%`}></span>)}
    </div>
  </template>
  <template data-skeleton-topbar>
    <div class="admin-topbar" aria-hidden="true">
      <span class="admin-topbar__title"><span class="skeleton-line" style="--skeleton-width: 8rem"></span></span>
      <span class="admin-topbar__search"><span class="skeleton skeleton--control"></span></span>
      <span class="skeleton skeleton--button" style="--skeleton-width: 7rem"></span>
    </div>
  </template>
</div>

<script>
  import { transitionKind } from '../lib/admin-transition';

  const transition = document.querySelector<HTMLElement>('[data-page-transition]');
  const frame = transition?.querySelector<HTMLElement>('[data-transition-frame]');
  const adminPath = document.body.dataset.adminPath || '/admin';
  // A navigation that answers within this never shows the overlay at all: a skeleton that
  // appears for a moment and is replaced is a flicker, not a loading state.
  const DELAY = 150;
  let pending = 0;

  const template = (selector: string) => transition?.querySelector<HTMLTemplateElement>(selector)?.content.cloneNode(true);

  let restoreTitle: (() => void) | null = null;

  /** Names the destination in the top bar, from the sidebar link the navigation follows. */
  const retitle = (topbar: HTMLElement, url: URL) => {
    const title = topbar.querySelector<HTMLElement>('.admin-topbar__title');
    const link = [...document.querySelectorAll<HTMLAnchorElement>('.admin-sidebar nav a[href]')]
      .find((candidate) => new URL(candidate.href).pathname === url.pathname);
    if (!title || !link) return;
    const before = [...title.childNodes];
    const label = document.createElement('span');
    label.textContent = link.querySelector('.admin-nav-label')?.textContent ?? '';
    const icon = link.querySelector('.admin-icon')?.cloneNode(true);
    title.replaceChildren(...(icon ? [icon] : []), label);
    restoreTitle = () => title.replaceChildren(...before);
  };

  const build = (url: URL) => {
    const kind = transitionKind(url, adminPath, window.location.origin);
    const skeleton = kind && template(`template[data-skeleton="${kind}"]`);
    if (!transition || !frame || !kind || !skeleton) return false;
    const column = document.createElement('div');
    column.className = 'admin-transition__column';
    const parts: Node[] = [];
    transition.style.removeProperty('inset-block-start');
    if (kind === 'editor') {
      transition.dataset.sidebar = 'none';
    } else {
      // The sidebar and the top bar are the same on every screen: ones already on the page stay
      // uncovered, and only a page without them -- an editor -- gets them drawn.
      const sidebar = document.querySelector('.admin-sidebar');
      const topbar = document.querySelector<HTMLElement>('.admin-topbar');
      transition.dataset.sidebar = sidebar ? 'page' : 'skeleton';
      const rail = sidebar ? null : template('template[data-skeleton-rail]');
      if (rail) parts.push(rail);
      if (topbar) {
        transition.style.setProperty('inset-block-start', `${Math.round(topbar.getBoundingClientRect().bottom)}px`);
        retitle(topbar, url);
      } else {
        const drawn = template('template[data-skeleton-topbar]');
        if (drawn) column.append(drawn);
      }
    }
    column.append(skeleton);
    parts.push(column);
    frame.replaceChildren(...parts);
    transition.dataset.kind = kind;
    return true;
  };

  const showTransition = (url: URL) => {
    window.clearTimeout(pending);
    pending = window.setTimeout(() => {
      pending = 0;
      if (!transition || !build(url)) return;
      transition.hidden = false;
      document.body.setAttribute('aria-busy', 'true');
      try {
        transition.showPopover?.();
      } catch {
        // The fixed-position fallback remains visible if the Popover API is unavailable.
      }
    }, DELAY);
  };

  const hideTransition = () => {
    window.clearTimeout(pending);
    pending = 0;
    if (!transition) return;
    try {
      if (transition.matches(':popover-open')) transition.hidePopover();
    } catch {
      // Ignore an unsupported popover selector; hidden still resets the fallback.
    }
    transition.hidden = true;
    frame?.replaceChildren();
    transition.style.removeProperty('inset-block-start');
    restoreTitle?.();
    restoreTitle = null;
    document.body.removeAttribute('aria-busy');
  };

  const showAfterEvent = (event: Event, url: URL) => {
    queueMicrotask(() => {
      if (!event.defaultPrevented) showTransition(url);
    });
  };

  document.addEventListener('click', (event) => {
    if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
    const link = event.target instanceof Element ? event.target.closest<HTMLAnchorElement>('a[href]') : null;
    if (!link || link.hasAttribute('download') || link.hasAttribute('data-no-page-transition')) return;
    const target = link.getAttribute('target');
    if (target && target.toLowerCase() !== '_self') return;

    const destination = new URL(link.href, window.location.href);
    if (!['http:', 'https:'].includes(destination.protocol)) return;
    if (destination.pathname === window.location.pathname && destination.search === window.location.search && (destination.hash || window.location.hash)) return;
    showAfterEvent(event, destination);
  });

  document.addEventListener('submit', (event) => {
    const form = event.target instanceof HTMLFormElement ? event.target : null;
    if (!form || form.method.toLowerCase() === 'dialog') return;
    const target = form.getAttribute('target');
    if (target && target.toLowerCase() !== '_self') return;
    showAfterEvent(event, new URL(form.action, window.location.href));
  });

  interface NavigateEvent extends Event { destination?: { sameDocument: boolean; url: string } }
  const navigation = Reflect.get(window, 'navigation') as EventTarget | undefined;
  let navigationGeneration = 0;
  navigation?.addEventListener('navigate', (event) => {
    const destination = (event as NavigateEvent).destination;
    if (!destination || destination.sameDocument) return;
    navigationGeneration += 1;
    showTransition(new URL(destination.url));
  });
  const navigationEnded = () => {
    const generation = navigationGeneration;
    queueMicrotask(() => {
      if (generation === navigationGeneration) hideTransition();
    });
  };
  navigation?.addEventListener('navigateerror', navigationEnded);
  navigation?.addEventListener('navigatesuccess', navigationEnded);
  window.addEventListener('pageshow', hideTransition);
  window.addEventListener('tome:navigation-cancelled', hideTransition);
</script>
