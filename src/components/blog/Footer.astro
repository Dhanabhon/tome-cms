---
import type { PublicNavigationItem } from '../../types/cms';
import { publicCopy } from '../../lib/i18n';
import type { PostLocale } from '../../types/cms';

interface Props {
  locale: PostLocale;
  items?: PublicNavigationItem[];
  siteName?: string;
}

const { locale, items = [], siteName = 'TomeCMS' } = Astro.props;
const copy = publicCopy(locale);
---

<footer class="site-footer mx-auto w-full max-w-7xl border-t border-line px-5 py-7 text-sm text-muted sm:px-7">
  {items.length > 0 && (
    <nav aria-label={copy.footerNavigation} class="public-navigation">
      <ul>{items.map(({ href, label }) => <li><a aria-current={href === Astro.url.pathname ? 'page' : undefined} href={href}>{label}</a></li>)}</ul>
    </nav>
  )}
  <p>&copy; {new Date().getFullYear()} {siteName}. {copy.allRightsReserved}</p>
</footer>
