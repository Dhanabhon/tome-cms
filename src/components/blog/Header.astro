---
import LanguageSwitcher from '../LanguageSwitcher.astro';
import ThemeToggle from '../ThemeToggle.astro';
import { localePath } from '../../lib/i18n';
import { THEME_LABELS, type ThemeChoice } from '../../lib/theme';
import type { PostAlternate, PostLocale, PublicNavigationItem } from '../../types/cms';

interface Props {
  availableLocales?: PostAlternate[];
  items?: PublicNavigationItem[];
  locale?: PostLocale;
  siteName?: string;
  /** What the server rendered, so the control is not briefly checked on the wrong option. */
  theme?: ThemeChoice;
}

const { availableLocales = [], items = [], locale = 'en', siteName = 'TomeCMS', theme = 'system' } = Astro.props;
const languageOptions = availableLocales
  .filter(({ locale: optionLocale }) => optionLocale === 'en' || optionLocale === 'th')
  .sort((left, right) => left.locale.localeCompare(right.locale));
---

<header class="site-header border-b border-line">
  <div class="site-header__inner mx-auto flex max-w-7xl items-center justify-between gap-4 px-5 py-5 sm:px-7">
    <a class="min-w-0 flex-1 truncate font-display text-xl font-bold tracking-tight text-ink sm:text-[22px]" href={localePath(locale)}>{siteName}</a>
    {items.length > 0 && (
      <nav aria-label="Primary" class="public-navigation site-header__desktop">
        <ul>{items.map(({ href, label }) => <li><a aria-current={href === Astro.url.pathname ? 'page' : undefined} href={href}>{label}</a></li>)}</ul>
      </nav>
    )}
    <ThemeToggle initial={theme} labels={THEME_LABELS[locale]} name="tome-theme-site" />
    {languageOptions.length > 1 && (
      <LanguageSwitcher currentLocale={locale} options={languageOptions} />
    )}
    {items.length > 0 && (
      <details class="site-header__mobile">
        <summary>{locale === 'th' ? 'เมนู' : 'Menu'}</summary>
        <nav aria-label="Primary" class="public-navigation">
          <ul>{items.map(({ href, label }) => <li><a aria-current={href === Astro.url.pathname ? 'page' : undefined} href={href}>{label}</a></li>)}</ul>
        </nav>
      </details>
    )}
  </div>
</header>
