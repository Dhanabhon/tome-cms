---
import { localePath } from '../../lib/i18n';
import type { PostAlternate, PostLocale } from '../../types/cms';

interface Props {
  active?: 'admin' | 'writing';
  availableLocales?: PostAlternate[];
  locale?: PostLocale;
  siteName?: string;
}

const { active, availableLocales = [], locale = 'en', siteName = 'TomeCMS' } = Astro.props;
---

<header class="border-b border-line">
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-5 py-5 sm:px-7">
    <a class="min-w-0 truncate font-display text-xl font-bold tracking-tight text-ink sm:text-[22px]" href={localePath(locale)}>{siteName}</a>
    <div class="flex shrink-0 items-center gap-4 sm:gap-7">
      <nav aria-label="Primary" class="flex items-center gap-4 text-sm sm:gap-7 sm:text-base">
        <a
          class:list={['border-b-2 py-1 transition-colors', active === 'writing' ? 'border-accent text-accent' : 'border-transparent text-ink hover:text-accent']}
          href={localePath(locale)}
          aria-current={active === 'writing' ? 'page' : undefined}>Writing</a
        >
        <a
          class:list={['border-b-2 py-1 transition-colors', active === 'admin' ? 'border-accent text-accent' : 'border-transparent text-ink hover:text-accent']}
          href="/admin"
          aria-current={active === 'admin' ? 'page' : undefined}>Admin</a
        >
      </nav>
      {availableLocales.length > 0 && (
        <nav aria-label="Language" class="flex items-center gap-2">
          {availableLocales.map((alternate) => (
            <a
              class:list={['text-sm uppercase hover:text-accent', alternate.locale === locale ? 'font-semibold text-accent' : 'text-muted']}
              href={alternate.href}
              aria-current={alternate.locale === locale ? 'page' : undefined}
            >
              {alternate.locale}
            </a>
          ))}
        </nav>
      )}
    </div>
  </div>
</header>
