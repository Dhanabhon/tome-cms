---
import { sanitizedContentHtmlSchema } from '../../lib/editor-content';
import type { Page } from '../../types/cms';

interface Props {
  page: Page;
  preview?: boolean;
}

const { page, preview = false } = Astro.props;
// Keep the document title as the only h1, including when the body contains heading blocks.
const contentHtml = sanitizedContentHtmlSchema.parse(page.content_html).replace(/<(\/?)h1>/g, '<$1h2>');
---

<article class="page-article mx-auto max-w-3xl px-5 py-12 sm:px-7 sm:py-20">
  <header>
    {preview && <p class="mb-5 text-sm font-medium text-muted">Draft preview</p>}
    <h1 class="font-display text-[40px] font-bold leading-[48px] tracking-[-1.875px] sm:text-[54px] sm:leading-[56px]">{page.title}</h1>
  </header>
  <div class="prose mt-12 max-w-none prose-headings:font-display prose-a:text-link prose-img:rounded-lg" set:html={contentHtml} />
</article>
