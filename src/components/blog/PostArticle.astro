---
import { localePath } from '../../lib/i18n';
import type { Post, PublicAuthorProfile, SiteSettings } from '../../types/cms';
import AuthorBlock from './AuthorBlock.astro';

interface Props {
  post: Post;
  preview?: boolean;
  profile?: PublicAuthorProfile | null;
  settings: SiteSettings;
}

const { post, preview = false, profile, settings } = Astro.props;
const formatter = new Intl.DateTimeFormat(post.locale === 'th' ? 'th-TH' : 'en', {
  day: 'numeric',
  month: 'long',
  timeZone: settings.timezone,
  year: 'numeric',
});
const publishedAt = post.published_at ?? post.created_at;
const primaryDate = preview ? post.updated_at : publishedAt;
const modifiedAt = post.updated_at;
const showModifiedDate = !preview && new Date(modifiedAt).getTime() - new Date(publishedAt).getTime() > 60_000;
---

<article class="mx-auto max-w-3xl px-5 py-12 sm:px-7 sm:py-20">
  <a class="text-sm font-medium text-link hover:underline" href={localePath(post.locale)}><span aria-hidden="true">←</span> All posts</a>
  <header class="mt-6">
    <h1 class="font-display text-[40px] font-bold leading-[48px] tracking-[-1.875px] sm:text-[54px] sm:leading-[56px]">{post.title}</h1>
    {post.meta_description && <p class="mt-5 text-xl leading-[30px] text-muted">{post.meta_description}</p>}
    <div class="mt-5 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-muted">
      <span>By <a class="text-link hover:underline" href={localePath(post.locale)}>{settings.site_name}</a></span>
      <span aria-hidden="true">•</span>
      <span>{preview ? 'Last saved' : 'Published'} <time datetime={primaryDate}>{formatter.format(new Date(primaryDate))}</time></span>
      {showModifiedDate && (
        <>
          <span aria-hidden="true">•</span>
          <span>Updated <time datetime={modifiedAt}>{formatter.format(new Date(modifiedAt))}</time></span>
        </>
      )}
    </div>
  </header>
  {post.cover_image && (
    <img class="mt-10 aspect-[16/9] w-full rounded-lg object-cover" src={post.cover_image} alt={post.title} fetchpriority="high" width="1200" height="675" />
  )}
  <div class="prose mt-12 max-w-none prose-headings:font-display prose-a:text-link prose-img:rounded-lg" set:html={post.content_html} />
  {profile && <AuthorBlock profile={profile} />}
</article>
