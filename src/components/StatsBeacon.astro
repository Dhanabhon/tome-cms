---
import type { CountedPage } from '../lib/stats';
import type { PostLocale } from '../types/cms';

interface Props {
  locale: PostLocale;
  stats: CountedPage;
}

/*
 * Counts this page for the owner's Stats screen: a view when the reader arrives (not when they
 * reload or come Back to it), and for an article, a read once the end has come into view and the
 * tab has been visible for fifteen seconds in all.
 *
 * Nothing is sent from the owner's own browser, or for a reader who set Do Not Track or Global
 * Privacy Control. What is sent names the page, never the reader: no cookie, no identifier, and
 * nothing written to the reader's browser.
 */
const { locale, stats } = Astro.props;
---

<template data-id={'id' in stats ? stats.id : undefined} data-kind={stats.kind} data-locale={locale} data-stats></template>

<script>
  import { READ_AFTER_SECONDS, STATS_ENDPOINT, STATS_OWNER_KEY } from '../lib/stats';

  type StatsEvent = 'read' | 'view';

  function silent(): boolean {
    const privacy = navigator as Navigator & { globalPrivacyControl?: boolean };
    if (navigator.doNotTrack === '1' || privacy.globalPrivacyControl === true) return true;
    try {
      return localStorage.getItem(STATS_OWNER_KEY) !== null;
    } catch {
      return false; // storage blocked: a reader like any other
    }
  }

  /**
   * True when this load is the page opened again rather than arrived at: a reload, or Back and
   * Forward. The browser knows that already, so counting writes nothing to the reader's browser
   * and needs no consent to ask for.
   *
   * ponytail: a reader who reads, reloads and reads to the end again is two reads, and one who
   * follows a link back to a page already open in the tab is a second view. Both are rare, and
   * remembering them would mean storing something on every reader's device.
   */
  function openedAgain(): boolean {
    const [navigation] = performance.getEntriesByType('navigation') as PerformanceNavigationTiming[];
    return navigation?.type === 'reload' || navigation?.type === 'back_forward';
  }

  function send(event: StatsEvent, page: DOMStringMap): void {
    const body = JSON.stringify({
      event,
      id: page.id,
      kind: page.kind,
      locale: page.locale,
      // Only the origin: the server keeps just the host anyway, and a same-site path can be
      // long enough on its own to push the body past the 1 KB limit.
      referrer: document.referrer ? new URL(document.referrer).origin : undefined,
      width: window.innerWidth,
    });
    // keepalive lets it finish after the reader has gone, as a beacon would; JSON keeps it clear
    // of the framework's check on cross-site form posts, which sendBeacon's text would meet.
    fetch(STATS_ENDPOINT, { body, headers: { 'Content-Type': 'application/json' }, keepalive: true, method: 'POST' })
      .catch(() => {
        // A count lost is a count lost; the reader is never told.
      });
  }

  const mount = document.querySelector<HTMLElement>('[data-stats]');
  const article = document.querySelector('article');
  if (mount && !silent()) {
    const page = mount.dataset;
    if (!openedAgain()) send('view', page);

    if (page.kind !== 'home' && article) {
      const end = document.createElement('span');
      end.setAttribute('aria-hidden', 'true');
      end.dataset.statsEnd = '';
      end.style.cssText = 'display: block; block-size: 1px;';
      article.append(end);

      let reachedEnd = false;
      let read = false;
      let visibleSeconds = 0;
      const clock = window.setInterval(() => {
        if (document.visibilityState === 'visible') visibleSeconds += 1;
        check();
      }, 1_000);
      const observer = new IntersectionObserver((entries) => {
        if (entries.some(({ isIntersecting }) => isIntersecting)) reachedEnd = true;
        check();
      });
      observer.observe(end);

      function check(): void {
        if (!reachedEnd || visibleSeconds < READ_AFTER_SECONDS || read) return;
        read = true;
        window.clearInterval(clock);
        observer.disconnect();
        send('read', page);
      }
    }
  }
</script>
