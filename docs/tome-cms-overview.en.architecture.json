        "id": "public-read",
        "label": "Reading path",
        "focus": [
          "visitor",
          "public",
          "themes",
          "server",
          "plugins",
          "postgres"
        ],
        "note": "The server renders with the owner's chosen theme and reads only what is published. A plugin that is on can add a banner or code."
      },
      {
        "id": "admin-write",
        "label": "Writing path",
        "focus": [
          "owner",
          "admin",
          "server",
          "postgres",
          "storage"
        ],
        "note": "The owner works in the admin. Every change goes through an API checked by Zod before it reaches the database or the file store."
      },
      {
        "id": "sign-in",
        "label": "Signing in",
        "focus": [
          "admin",
          "auth",
          "plugins",
          "turnstile",
          "server"
        ],
        "note": "Passkeys only. A plugin may stop one attempt first, but it cannot close the way back in."
      },
      {
        "id": "suggestions",
        "label": "Suggestions while writing",
        "focus": [
          "owner",
          "admin",
          "server",
          "plugins",
          "typesafe"
        ],
        "note": "Jev (TypeSafe AI) suggests categories, an excerpt and a description; the sentences are the article's own. Nothing applies until pressed."
      }
    ],
