  "cards": [
    {
      "dot": "cyan",
      "title": "Reading (public)",
      "items": [
        "A theme owns its templates and CSS; routes, SEO and tokens stay in core",
        "Themes declare settings the owner tunes: hero, grid and header",
        "Public pages ship no React, and code a page does not use is never sent"
      ]
    },
    {
      "dot": "emerald",
      "title": "Writing (admin)",
      "items": [
        "The admin is React islands on server-rendered pages",
        "All changes pass /api/admin: Zod and a same-origin check",
        "Uploads go straight to S3; logos go via the server to scrub SVG"
      ]
    },
    {
      "dot": "rose",
      "title": "Security",
      "items": [
        "Passkeys only; a session is tied to the credential that made it",
        "Rate limits: sign-in 10 per 15 minutes, recovery 5 per 30 minutes",
        "Plugins may block sign-in, never recovery; secrets are encrypted"
      ]
    }
  ]
